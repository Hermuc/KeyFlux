# KeyFlux 仓库编辑器与格式基线 (2026-09-13 清理批次新增, 仅约束编辑器行为, 不影响构建)
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# C#: 空格缩进 (与现有代码一致)
[*.cs]
indent_style = space
indent_size = 4

# XAML/AXAML: 空格缩进 (现有文件为 2 空格)
[*.{xaml,axaml,xml,json,yml,yaml}]
indent_style = space
indent_size = 2

# Go: gofmt 规定制表符
[*.go]
indent_style = tab

# AHK v2: 现有 lib 源码为制表符缩进
[*.{ahk,ahk2}]
indent_style = tab

# Batch: Windows 批处理用 CRLF (cmd 解析历史敏感性)
[*.{bat,cmd}]
end_of_line = crlf
indent_style = space
indent_size = 4

# Markdown: 行尾双空格是换行语法, 勿裁
[*.md]
trim_trailing_whitespace = false
