{
  "id": "script",
  "name": "AHK 脚本",
  "nameEn": "Run AHK script",
  "version": "1.0.0",
  "specVersion": 1,
  "description": "执行一段 AutoHotkey 脚本片段, %selected% 会替换为字符串字面量",
  "appliesTo": [
    {
      "type": "textType",
      "value": "plain"
    },
    {
      "type": "fileExt",
      "exts": [
        "*"
      ]
    }
  ],
  "entry": {
    "kind": "builtin",
    "action": "script"
  },
  "permissions": [
    "run"
  ]
}
