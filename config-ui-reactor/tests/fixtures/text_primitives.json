{
  "ahk_string": [
    {
      "in": "",
      "out": "\"\""
    },
    {
      "in": "abc",
      "out": "\"abc\""
    },
    {
      "in": "a`b",
      "out": "\"a``b\""
    },
    {
      "in": "a\"b",
      "out": "\"a`\"b\""
    },
    {
      "in": "a ;b",
      "out": "\"a `;b\""
    },
    {
      "in": "a;b",
      "out": "\"a;b\""
    },
    {
      "in": " ;",
      "out": "\" `;\""
    },
    {
      "in": "a\nb",
      "out": "\"a\nb\""
    },
    {
      "in": "全角；",
      "out": "\"全角；\""
    },
    {
      "in": "a `; b",
      "out": "\"a ``; b\""
    }
  ],
  "concat": [
    {
      "a": "a",
      "b": "b",
      "out": "ab"
    },
    {
      "a": "",
      "b": "x",
      "out": "x"
    },
    {
      "a": "x",
      "b": "",
      "out": "x"
    },
    {
      "a": "全",
      "b": "角",
      "out": "全角"
    }
  ],
  "divide": [
    {
      "a": 1000,
      "b": 1000,
      "out": "1.000"
    },
    {
      "a": 1,
      "b": 3,
      "out": "0.333"
    },
    {
      "a": 2,
      "b": 3,
      "out": "0.667"
    },
    {
      "a": 0,
      "b": 5,
      "out": ""
    },
    {
      "a": -1,
      "b": 2,
      "out": ""
    },
    {
      "a": 1500,
      "b": 1000,
      "out": "1.500"
    },
    {
      "a": 1,
      "b": 1000,
      "out": "0.001"
    },
    {
      "a": 999,
      "b": 1000,
      "out": "0.999"
    },
    {
      "a": 1234,
      "b": 1000,
      "out": "1.234"
    },
    {
      "a": 1,
      "b": 0,
      "out": "+Inf"
    },
    {
      "a": 500,
      "b": 1000,
      "out": "0.500"
    },
    {
      "a": 2000,
      "b": 1000,
      "out": "2.000"
    }
  ],
  "escape_ahk_hotkey": [
    {
      "in": ";",
      "out": "`;"
    },
    {
      "in": "q",
      "out": "q"
    },
    {
      "in": "",
      "out": ""
    },
    {
      "in": "#!^",
      "out": "#!^"
    },
    {
      "in": "`;",
      "out": "`;"
    }
  ],
  "join": [
    {
      "sep": "-",
      "elems": [
        "a",
        "b"
      ],
      "out": "a-b"
    },
    {
      "sep": "",
      "elems": [
        "a",
        "b"
      ],
      "out": "ab"
    },
    {
      "sep": ", ",
      "elems": [
        "one"
      ],
      "out": "one"
    }
  ],
  "not_blank_lines": [
    {
      "in": "a\n\n b \n\t\nc",
      "out": [
        "a",
        "b",
        "c"
      ]
    },
    {
      "in": "",
      "out": null
    },
    {
      "in": "  \n\n",
      "out": null
    },
    {
      "in": "x",
      "out": [
        "x"
      ]
    },
    {
      "in": "  leading\n\ttab  ",
      "out": [
        "leading",
        "tab"
      ]
    }
  ],
  "to_ahk_func_arg": [
    {
      "in": "plain",
      "out": "\"plain\""
    },
    {
      "in": "ahk-expression:  WinActive(\"A\")  ",
      "out": "WinActive(\"A\")"
    },
    {
      "in": "ahk-expression:foo bar",
      "out": "foo bar"
    },
    {
      "in": "ahk-expressions:x",
      "out": "\"ahk-expressions:x\""
    },
    {
      "in": "ahk-expression: ;",
      "out": ";"
    }
  ]
}
