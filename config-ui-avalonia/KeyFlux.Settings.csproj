<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 精简框架本地化附属资源 (原 Makefile -p: 开关; pwsh 下引号包裹的 zh-Hans;en 会拆坏命令行, 故移入工程文件) -->
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <!-- 输出为 Windows 可执行程序，最终产物为 KeyFlux.Settings.exe -->
    <OutputType>WinExe</OutputType>
    <!-- 目标框架：.NET 10 -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- 程序集 / 产品名：主 exe 最终命名 KeyFlux.Settings.exe -->
    <AssemblyName>KeyFlux.Settings</AssemblyName>
    <RootNamespace>KeyFlux.Settings</RootNamespace>
    <Product>KeyFlux.Settings</Product>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 启用编译绑定（x:CompileBindings），提升绑定性能与编译期检查 -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- 保留全球化（界面含中文，不能启用 InvariantGlobalization） -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- exe 文件图标（多尺寸 16/32/48/256 的 ICO，由 tb.png 生成）。
         它只作用于 apphost(KeyFlux.Settings.exe) 的 Win32 图标资源，与窗体/标题栏用的
         avares 资源是两条路径；下方 <AvaloniaResource Include="Assets\**" /> 会顺带把它也
         打进资源包(+44KB)，不影响运行。 -->
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>

    <!-- ── 2026-09-12 体积/内存优化：IL 裁剪 + R2R（发布配置单一真源, Makefile/CI 不再传 -p:）──
         PublishTrimmed: 砍掉未用到的框架 IL (磁盘 -xxMB 级, 实测见提交)。
         JsonSerializerIsReflectionEnabledByDefault: 本工程 7 处 System.Text.Json 反射序列化
           (ConfigSaver/SettingsApiClient/I18n/PluginMarket/SelectedActionPage) 未迁移
           source-gen, 裁剪下默认会被禁用 → 显式开启反射模式。
         TrimmerRoots.xml: 根植本程序集全部类型, 保住上述序列化依赖的模型元数据。
         PublishReadyToRun: 裁剪后代码量小, R2R 预编译换取 <1s 冷启动 (AHK 唤起体验)。
         ⚠ 裁剪的破坏面只在「发布产物」上, dotnet test 跑的是未裁剪程序集, 拦不住；
           因此裁剪相关改动必须实机跑一遍页面+保存路径 (契约: TrimmerRoots 勿删)。 -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <PublishReadyToRun>true</PublishReadyToRun>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="TrimmerRoots.xml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Avalonia 核心、桌面平台、Fluent 主题、MVVM 工具包 -->
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- 内嵌资源: MDI 图标字体 (导航图标, 复刻 Vue 版 mdi 图标) -->
    <AvaloniaResource Include="Assets\**" />
    <!-- 双语文案表: 刻意做成「松散文件复制到输出目录」而非 avares 内嵌资源 ——
         Avalonia 的 AssetLoader 每次现取 AvaloniaLocator 服务, 纯 xunit 宿主下读不到,
         守卫测试 I18nResourceTests 会直接抛 (详见 Services/I18n.cs 头部)。
         不放 Assets\ 是因为上一行已整目录 AvaloniaResource 收录, 会被双重打包。
         两项元数据都必须写: CopyToOutputDirectory 管 dotnet build / 测试宿主,
         CopyToPublishDirectory 管 dotnet publish; 只写前者会导致 bin\Debug 有、bin\ui 没有。 -->
    <Content Include="Resources\i18n.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- 守卫测试需读取 I18n 的内部成员 (KeyCount), 用于文案表键数与键覆盖对账 -->
    <InternalsVisibleTo Include="KeyFlux.Settings.Tests" />
  </ItemGroup>

</Project>
