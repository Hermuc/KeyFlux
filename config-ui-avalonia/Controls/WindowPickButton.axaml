<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:KeyFlux.Settings.Controls"
             x:Class="KeyFlux.Settings.Controls.WindowPickButton"
             x:DataType="controls:WindowPickButton"
             Width="30">

  <!-- 窗口拾取准星按钮 (照 HotkeyCapture 范式, L5 控件层):
       点击 -> 进入准星拾取态 -> 单击目标窗口 -> 回填/追加标识符 (Kind 决定格式);
       Esc / 右键取消 (由 WindowPickerSession 处理); 非提权识别失败时提示 (1081) 约 4s 自动消失。
       Text 为 TwoWay 承载回填/追加目标; AppendMode 区分追加(T8)与替换(T7)语义;
       Picker 未注入时回落 WindowPickerService.Shared -> DataTemplate 零配置可用。
       布局稳定性: 控件根设固定 Width -> 宿主 Auto 列宽恒定; 失败提示用 Popup 浮层
       (不参与布局测量, 显示/折叠均不改变控件宽高) -> 彻底消除对相邻 TextBox 的挤压/撑高抖动。
       绑定定源 (修复准星不回填 bug): 构造函数不再设 DataContext = this —— 本地值优先级高于继承,
       会把宿主 Text="{Binding WinTitle}" 的源钉死在控件自身, 路径解析失败且永不重试,
       WriteBack 的 SetCurrentValue 只改本地值无法推送回 VM (headless 裁决实验证实)。
       内部绑定改为显式 $parent[controls:WindowPickButton] 定源, 与宿主绑定互不干扰。 -->
  <Panel>
    <Button x:Name="PickButton"
            Click="OnPickClick"
            IsEnabled="{Binding !$parent[controls:WindowPickButton].IsPicking}"
            Background="Transparent" BorderBrush="{StaticResource ClaudeBorderWarmBrush}" BorderThickness="1"
            Foreground="{StaticResource ClaudeTerracottaBrush}" Padding="0"
            CornerRadius="{StaticResource ClaudeRadiusSm}"
            Width="30" Height="30" Cursor="Hand"
            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
            ToolTip.Tip="{Binding $parent[controls:WindowPickButton].LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1080}">
      <TextBlock Text="🎯" FontSize="15" />
    </Button>

    <!-- 失败/异常提示浮层: Popup 渲染在 overlay 层, 自身测量为零 -> 不影响宿主 Auto 列宽/行高, 不受 Viewbox 缩放布局测量影响;
         Popup 与内容根 Border 均显式 Focusable=False (防后续往浮层塞可聚焦控件时夺焦干扰拾取焦点管理) -> 不夺焦; IsOpen 单向绑定 MessageText 非空 -> 4s 定时器清空即自动收起。 -->
    <Popup x:Name="MessagePopup"
           PlacementTarget="{Binding #PickButton}"
           Placement="Bottom"
           Focusable="False"
           IsLightDismissEnabled="False"
           IsOpen="{Binding $parent[controls:WindowPickButton].MessageText, Mode=OneWay, Converter={StaticResource NotEmpty}}">
      <Border Background="{StaticResource ClaudeIvoryBrush}"
              BorderBrush="{StaticResource ClaudeErrorBrush}" BorderThickness="1"
              CornerRadius="{StaticResource ClaudeRadiusSm}" Padding="10,6" MaxWidth="240" Focusable="False">
        <TextBlock Text="{Binding $parent[controls:WindowPickButton].MessageText}"
                   Foreground="{StaticResource ClaudeErrorBrush}" FontSize="12" TextWrapping="Wrap" />
      </Border>
    </Popup>
  </Panel>
</UserControl>
