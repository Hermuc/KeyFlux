<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:KeyFlux.Settings.Controls"
             x:Class="KeyFlux.Settings.Controls.HotkeyCapture"
             x:DataType="controls:HotkeyCapture"
             Focusable="True">

  <!-- 热键捕获控件 (复刻 HotkeyCapture.vue):
       点击进入捕获态 -> 按下左右修饰键暂存 -> 主键组合提交;
       Esc 单独按下或焦点丢失取消; 冲突时红字提示 (保守归一化比较)。 -->
  <StackPanel Spacing="3">
    <Border x:Name="BoxBorder"
            Background="White" BorderBrush="#C9CDD4" BorderThickness="1"
            CornerRadius="6" Padding="8,6" Cursor="Hand">
      <Grid ColumnDefinitions="20,*,Auto">
        <TextBlock Text="{Binding IconText}" FontSize="14"
                   VerticalAlignment="Center" Foreground="#5F6368" />
        <TextBlock Grid.Column="1" Text="{Binding DisplayText}"
                   VerticalAlignment="Center" Margin="6,0"
                   Foreground="{Binding TextBrush}" TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="2" x:Name="ClearButton"
                IsVisible="{Binding ShowClearButton}"
                Background="Transparent" BorderThickness="0" Padding="2"
                Foreground="#8A8F98" FontSize="11" Content="✕"
                Click="OnClearClick" />
      </Grid>
    </Border>
    <TextBlock IsVisible="{Binding HasConflict}"
               Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1025}"
               Foreground="#D32F2F" FontSize="11" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
