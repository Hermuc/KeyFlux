<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeyFlux.Settings.ViewModels"
             xmlns:local="using:KeyFlux.Settings.Views.Controls"
             x:Class="KeyFlux.Settings.Views.Controls.CommentSummaryPanel">

  <!-- 备注汇总控件 (复刻 ActionCommentTable, KeymapPage/AbbrPage 共用):
       标题 + 独立滚动的条目列表; 使用方设置 ItemsSource / LanguageTick 两个属性。
       绑定自身属性用 RelativeSource AncestorType 指向具体控件类型 —— 项目启用
       x:CompileBindings, UserControl 基类无这些属性, 必须用具体类型参与编译检查。 -->
  <Grid RowDefinitions="Auto,*">

    <!-- 标题 (label:305; LanguageTick 变化驱动文案重算) -->
    <TextBlock Text="{Binding LanguageTick, RelativeSource={RelativeSource AncestorType=local:CommentSummaryPanel}, Converter={StaticResource Tr}, ConverterParameter=305}"
               FontFamily="{StaticResource ClaudeSerifFont}"
               FontSize="15" FontWeight="Medium" Margin="0,0,0,10"
               Foreground="{StaticResource ClaudeNearBlackBrush}" />

    <!-- 条目列表: 独立纵向滚动 (横向禁用, 长备注换行);
         文字与滚动条的空隙全部来自「滚动条右移」而非压缩文字:
         宿主页面内层 Grid 右边距 24→4, 滚动视口向右扩 20, 滚动条随之右移;
         此处内容右 Margin 20 恰好抵消扩量, 文字换行边界与原 24 边距时完全一致
         (文字占满原有宽度; Fluent 滚动条浮层宽 = ScrollBarSize 10, 若只留 10 边距会被浮层吃掉) -->
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <ItemsControl Margin="0,0,20,0" ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=local:CommentSummaryPanel}}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CommentEntryVm">
            <StackPanel Margin="0,0,0,12">
              <!-- 单行条目: 加粗按键 - 灰色备注, 长备注自动换行; 字号 13→14 (适当增大, 与标题 15 协调) -->
              <TextBlock TextWrapping="Wrap" FontSize="14">
                <Run Text="{Binding KeyText}" FontWeight="SemiBold" Foreground="{StaticResource ClaudeNearBlackBrush}" />
                <Run Text=" - " Foreground="{StaticResource ClaudeOliveGrayBrush}" />
                <Run Text="{Binding Comment}" Foreground="{StaticResource ClaudeOliveGrayBrush}" />
              </TextBlock>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
