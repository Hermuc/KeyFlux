<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeyFlux.Settings.ViewModels"
             xmlns:controls="using:KeyFlux.Settings.Controls"
             x:Class="KeyFlux.Settings.Views.Controls.ActionEditorPanel"
             x:Name="PanelRoot"
             x:DataType="vm:ActionEditorViewModel">

  <!-- 动作编辑面板 (复刻 actions/Action.vue 卡片: 分组下拉 + 类型下拉 + 按类型分发编辑器);
       宽度由使用处指定 (KeymapPage/CustomHotkey 720, AbbrPage 动态同步 chips 最宽行), 控件内不设 Width;
       Border 必须 Stretch 铺满使用处给定宽度 —— Left 会使白卡片收缩为内容最小期望宽 (动态方案下窄于 W) -->
  <Border Background="White" CornerRadius="12" BorderBrush="#E3E6EC" BorderThickness="1"
          MinHeight="380" Padding="16,12" HorizontalAlignment="Stretch">
    <DockPanel>

      <!-- 头部: 窗口分组 (5/12) + 动作类型 (7/12) -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="5*,7*" Margin="0,0,0,10">
        <ComboBox ItemsSource="{Binding GroupOptions}"
                  SelectedItem="{Binding SelectedGroup}"
                  HorizontalAlignment="Stretch" Margin="0,0,10,0" />
        <ComboBox Grid.Column="1"
                  ItemsSource="{Binding TypeOptions}"
                  SelectedItem="{Binding SelectedType}"
                  IsEnabled="{Binding HasHotkey}"
                  HorizontalAlignment="Stretch" />
      </Grid>

      <!-- 按编辑器 VM 类型分发 (类型 0 时 Editor 为 null) -->
      <ContentControl Content="{Binding Editor}">
        <ContentControl.DataTemplates>

          <!-- ===================== 类型 1: 启动程序或激活窗口 ===================== -->
          <DataTemplate DataType="vm:ActivateOrRunEditorVm" x:DataType="vm:ActivateOrRunEditorVm">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="140,*,Auto" ColumnSpacing="10" Margin="0,6,0,0">
                <TextBlock Text="{Binding #PanelRoot.((vm:ActionEditorViewModel)DataContext).LanguageTick, Converter={StaticResource Tr}, ConverterParameter=301}"
                           Foreground="#8A8F98" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                <TextBox Grid.Column="1" Text="{Binding WinTitle}" Padding="8,6" />
                <controls:WindowPickButton Grid.Column="2" Text="{Binding WinTitle}" Kind="TitleAndExe"
                                           Margin="6,0,0,0" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Text="{Binding WinTitleError}" Foreground="#C62828" FontSize="12" TextWrapping="Wrap"
                         IsVisible="{Binding WinTitleError, Converter={StaticResource NotEmpty}}" />
              <TextBlock Text="{Binding #PanelRoot.((vm:ActionEditorViewModel)DataContext).LanguageTick, Converter={StaticResource Tr}, ConverterParameter=301hint}"
                         Foreground="#8A8F98" FontSize="12" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="140,*" ColumnSpacing="10" Margin="0,6,0,0">
                <TextBlock Text="{Binding #PanelRoot.((vm:ActionEditorViewModel)DataContext).LanguageTick, Converter={StaticResource Tr}, ConverterParameter=302}"
                           Foreground="#8A8F98" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                <AutoCompleteBox Grid.Column="1" Text="{Binding Target, Mode=TwoWay}"
                                 ItemsSource="{Binding Shortcuts}"
                                 Padding="8,6" />
              </Grid>

              <Grid ColumnDefinitions="140,*" ColumnSpacing="10" Margin="0,6,0,0">
                <TextBlock Text="{Binding #PanelRoot.((vm:ActionEditorViewModel)DataContext).LanguageTick, Converter={StaticResource Tr}, ConverterParameter=303}"
                           Foreground="#8A8F98" FontSize="12" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding Args}" Padding="8,6" />
              </Grid>
              <Grid ColumnDefinitions="140,*" ColumnSpacing="10">
                <TextBlock Text="{Binding #PanelRoot.((vm:ActionEditorViewModel)DataContext).LanguageTick, Converter={StaticResource Tr}, ConverterParameter=304}"
                           Foreground="#8A8F98" FontSize="12" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding WorkingDir}" Padding="8,6" />
              </Grid>
              <Grid ColumnDefinitions="140,*" ColumnSpacing="10">
                <TextBlock Text="{Binding #PanelRoot.((vm:ActionEditorViewModel)DataContext).LanguageTick, Converter={StaticResource Tr}, ConverterParameter=305}"
                           Foreground="#8A8F98" FontSize="12" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding Comment}" Padding="8,6" />
              </Grid>

              <WrapPanel Margin="0,8,0,0">
                <CheckBox IsChecked="{Binding RunAsAdmin}" Margin="0,0,16,0"
                          Content="{Binding #PanelRoot.((vm:ActionEditorViewModel)DataContext).LanguageTick, Converter={StaticResource Tr}, ConverterParameter=306}" />
                <CheckBox IsChecked="{Binding RunInBackground}" Margin="0,0,16,0"
                          Content="{Binding #PanelRoot.((vm:ActionEditorViewModel)DataContext).LanguageTick, Converter={StaticResource Tr}, ConverterParameter=307}" />
                <CheckBox IsChecked="{Binding DetectHiddenWindow}"
                          Content="{Binding #PanelRoot.((vm:ActionEditorViewModel)DataContext).LanguageTick, Converter={StaticResource Tr}, ConverterParameter=308}" />
              </WrapPanel>

              <Button Command="{Binding RunWindowSpyCommand}" Margin="0,6,0,0"
                      Background="Transparent" BorderBrush="#4169E1" BorderThickness="1"
                      Foreground="#4169E1" Padding="10,5" CornerRadius="8">
                <TextBlock Text="{Binding #PanelRoot.((vm:ActionEditorViewModel)DataContext).LanguageTick, Converter={StaticResource Tr}, ConverterParameter=309}" />
              </Button>
            </StackPanel>
          </DataTemplate>

          <!-- ===================== 类型 2/3/4/7/9: 枚举单选 ===================== -->
          <DataTemplate DataType="vm:RadioGroupEditorVm" x:DataType="vm:RadioGroupEditorVm">
            <!-- 行 -> 列(横向) -> 选项(纵向); 内层集合元素类型推断不便, 关闭编译绑定用反射 -->
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="{x:Null}">
                  <ItemsControl ItemsSource="{Binding}" Margin="0,4,0,8">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="40" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="{x:Null}">
                        <ItemsControl ItemsSource="{Binding}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RadioOptionVm">
                              <RadioButton Content="{Binding Label}" IsChecked="{Binding IsChecked}"
                                           GroupName="ActionRadio" Margin="0,3" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DataTemplate>

          <!-- ===================== 类型 5: 重映射按键 ===================== -->
          <DataTemplate DataType="vm:RemapEditorVm" x:DataType="vm:RemapEditorVm">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding #PanelRoot.((vm:ActionEditorViewModel)DataContext).LanguageTick, Converter={StaticResource Tr}, ConverterParameter=401}"
                         Foreground="#8A8F98" FontSize="12" />
              <AutoCompleteBox Text="{Binding RemapToKey, Mode=TwoWay}"
                               ItemsSource="{Binding Items}"
                               IsEnabled="{Binding !IsSinglePress}"
                               Padding="8,6" />
              <!-- 复刻 RemapKey.vue 的 singlePress 报错卡片 -->
              <Border BorderBrush="#C62828" BorderThickness="1" CornerRadius="8" Padding="10,6"
                      IsVisible="{Binding IsSinglePress}">
                <TextBlock Text="{Binding #PanelRoot.((vm:ActionEditorViewModel)DataContext).LanguageTick, Converter={StaticResource Tr}, ConverterParameter=954}"
                           Foreground="#C62828" FontSize="12" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </DataTemplate>

          <!-- ===================== 类型 6: 输入按键或文本 ===================== -->
          <DataTemplate DataType="vm:SendKeysEditorVm" x:DataType="vm:SendKeysEditorVm">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding #PanelRoot.((vm:ActionEditorViewModel)DataContext).LanguageTick, Converter={StaticResource Tr}, ConverterParameter=402}"
                         Foreground="#8A8F98" FontSize="12" />
              <TextBox Text="{Binding KeysToSend}" AcceptsReturn="True" MinHeight="80"
                       FontFamily="Consolas,Courier New" FontSize="13" Padding="8,6" />
              <TextBlock Text="{Binding #PanelRoot.((vm:ActionEditorViewModel)DataContext).LanguageTick, Converter={StaticResource Tr}, ConverterParameter=305}"
                         Foreground="#8A8F98" FontSize="12" />
              <TextBox Text="{Binding Comment}" Padding="8,6" />
            </StackPanel>
          </DataTemplate>

          <!-- ===================== 类型 8: 自定义函数 ===================== -->
          <DataTemplate DataType="vm:AhkCodeEditorVm" x:DataType="vm:AhkCodeEditorVm">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding #PanelRoot.((vm:ActionEditorViewModel)DataContext).LanguageTick, Converter={StaticResource Tr}, ConverterParameter=403}"
                         Foreground="#8A8F98" FontSize="12" />
              <!-- 跟随面板宽度铺满 (原先 MinWidth=420 在动态窄面板下强制溢出, 已移除; 720 页本就满宽无副作用) -->
              <ComboBox ItemsSource="{Binding Examples}" SelectionChanged="OnAhkExampleSelected"
                        HorizontalAlignment="Stretch" />
              <TextBox Text="{Binding AhkCode}" AcceptsReturn="True" AcceptsTab="True" MinHeight="100"
                       FontFamily="Consolas,Courier New" FontSize="13" Padding="8,6" />
              <TextBlock Text="{Binding #PanelRoot.((vm:ActionEditorViewModel)DataContext).LanguageTick, Converter={StaticResource Tr}, ConverterParameter=305}"
                         Foreground="#8A8F98" FontSize="12" />
              <TextBox Text="{Binding Comment}" Padding="8,6" />
              <TextBlock Text="Tips:" FontWeight="SemiBold" Margin="0,8,0,0" />
              <TextBlock Text="{Binding #PanelRoot.((vm:ActionEditorViewModel)DataContext).LanguageTick, Converter={StaticResource Tr}, ConverterParameter=955}"
                         Foreground="#8A8F98" FontSize="12" TextWrapping="Wrap" />
              <TextBlock Text="{Binding #PanelRoot.((vm:ActionEditorViewModel)DataContext).LanguageTick, Converter={StaticResource Tr}, ConverterParameter=956}"
                         Foreground="#8A8F98" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>

        </ContentControl.DataTemplates>
      </ContentControl>
    </DockPanel>
  </Border>
</UserControl>
