<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KeyFlux.Settings.ViewModels"
        xmlns:views="using:KeyFlux.Settings.Views"
        x:Class="KeyFlux.Settings.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        FontFamily="Microsoft YaHei UI, Segoe UI, Segoe UI Emoji"
        Title="Setting"
        Icon="avares://KeyFlux.Settings/Assets/logo.png"
        Width="1200" Height="760"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <!-- Ctrl+S 保存 (复刻 App.vue 的全局 keydown 监听) -->
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <!-- 导航条目: 悬停与选中的轻量高亮 -->
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Margin" Value="0,1" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="264,*">

    <!-- ===================== 左侧导航 (复刻 NavigationDrawer.vue) ===================== -->
    <Border Grid.Column="0" Background="#F7F8FB" BorderBrush="#E3E6EC" BorderThickness="0,0,1,0">
      <DockPanel>

        <!-- 头部: Logo + 名称 + 版本号 -->
        <StackPanel DockPanel.Dock="Top" Margin="20,18,20,14" Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <!-- 品牌 logo (tb.png 裁剪透明边距后降采样 256x256, 内容占画布 ~93%):
                 尺寸取 52: 52*0.93≈48px 实际图形, 头部 StackPanel 高度从旧 42→52(+10px),
                 不影响 DockPanel Top 布局; 右侧 "KeyFlux" 标题 VerticalAlignment=Center 自动居中。 -->
            <Image Source="avares://KeyFlux.Settings/Assets/logo.png"
                   Width="52" Height="52" />
            <TextBlock VerticalAlignment="Center" Text="KeyFlux"
                       FontSize="18" FontWeight="SemiBold" />
          </StackPanel>
          <Border Height="1" Background="#E3E6EC" />
        </StackPanel>

        <!-- 底部: 保存按钮 (label:507) + 保存成功提示 -->
        <StackPanel DockPanel.Dock="Bottom" Margin="16,10,16,16" Spacing="6">
          <Border Height="1" Background="#E3E6EC" Margin="0,0,0,10" />
          <TextBlock Text="{Binding SaveNotice}"
                     IsVisible="{Binding SaveNotice, Converter={StaticResource NotEmpty}}"
                     Foreground="#2E7D32" FontSize="12" HorizontalAlignment="Center" />
          <Button Command="{Binding SaveCommand}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Background="White" BorderBrush="#4169E1" BorderThickness="1"
                  Foreground="#4169E1" Padding="10,8" CornerRadius="8">
            <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=507}" />
          </Button>
        </StackPanel>

        <!-- 导航列表: 总览 / 选中动作 / 启用的 keymap -->
        <ListBox ItemsSource="{Binding NavItems}"
                 SelectedItem="{Binding CurrentNavItem, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0" Margin="10,0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NavItem">
              <!-- 复刻 Vue 版导航: MDI 图标 (彩色) + 标题, 无背景方块 -->
              <Grid ColumnDefinitions="34,*">
                <TextBlock Text="{Binding IconChar}" FontFamily="{StaticResource MdiFont}"
                           Foreground="{Binding BadgeColorHex}" FontSize="26"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                           Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- ===================== 右侧内容区 ===================== -->
    <Grid Grid.Column="1" Background="#FCFCFE">
      <ContentControl Content="{Binding CurrentPage}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:HomePageViewModel">
            <views:HomePageView />
          </DataTemplate>
          <DataTemplate DataType="vm:SettingsPageViewModel">
            <views:SettingsPageView />
          </DataTemplate>
          <DataTemplate DataType="vm:KeymapPageViewModel">
            <views:KeymapPageView />
          </DataTemplate>
          <DataTemplate DataType="vm:AbbrPageViewModel">
            <views:AbbrPageView />
          </DataTemplate>
          <DataTemplate DataType="vm:SelectedActionPageViewModel">
            <views:SelectedActionPageView />
          </DataTemplate>
          <DataTemplate DataType="vm:PluginsPageViewModel">
            <views:PluginsPageView />
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>

      <!-- 加载遮罩 -->
      <Border IsVisible="{Binding IsLoading}" Background="#F0F2F7">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
          <ProgressBar IsIndeterminate="True" Width="220" Foreground="#4169E1" />
          <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=917}"
                     Foreground="#8A8F98" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- 友好错误页: 后端不可达时展示原因与重试 -->
      <Border IsVisible="{Binding HasError}" Background="#F0F2F7">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="560">
          <TextBlock Text="⚠" FontSize="42" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=919}"
                     FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"
                     TextWrapping="Wrap" TextAlignment="Center" />
          <TextBlock Text="{Binding ErrorMessage}" Foreground="#8A8F98"
                     TextWrapping="Wrap" TextAlignment="Center" />
          <Button Command="{Binding RetryCommand}" HorizontalAlignment="Center"
                  Background="#4169E1" Foreground="White" Padding="18,8" CornerRadius="8"
                  Content="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=920}" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>

</Window>
