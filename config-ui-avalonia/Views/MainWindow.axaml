<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KeyFlux.Settings.ViewModels"
        xmlns:views="using:KeyFlux.Settings.Views"
        xmlns:controls="using:KeyFlux.Settings.Controls"
        x:Class="KeyFlux.Settings.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        FontFamily="Microsoft YaHei UI, Segoe UI, Segoe UI Emoji"
        Title="Setting"
        Icon="avares://KeyFlux.Settings/Assets/logo.png"
        Width="1200" Height="760"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        TransparencyLevelHint="Blur,AcrylicBlur,Transparent,None"
        Background="Transparent">

  <!-- 无边框 + 亚克力 (计划书 §九, A 档零新依赖):
       · TransparencyLevelHint 是【提示列表】, 从最理想逐级降级; 全不可用时回落 None 不会崩。
       · 窗口 Background 保持 Transparent, 真正的暖色底由下方根 Border 的
         ClaudeWindowSurfaceBrush (带 alpha 的 Parchment) 承担, 模糊才能透出来。
       · 关于"柔和外阴影": BoxShadow 需要窗口边缘留出透明边距才可见, 而一旦该边距存在,
         在亚克力不可用 (回落 None) 的机器上会显示为黑边 —— 故本期用 1px BorderWarm 细环
         (DESIGN.md Level 2 ring) 替代外阴影, 等确认目标机器亚克力稳定后再补边距+Whisper。 -->

  <!-- Ctrl+S 保存 (复刻 App.vue 的全局 keydown 监听) -->
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <!-- 导航条目: Claude 暖色态 (Sand 高亮 + Ring 按动)
         注意: Fluent 模板把 Background 设在 ContentPresenter#PART_ContentPresenter 上,
         故三态必须指名该部件, 否则被模板值压住 (本地值/模板值优先级高于裸控件样式)。 -->
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="CornerRadius" Value="{StaticResource ClaudeRadiusMd}" />
      <Setter Property="Margin" Value="0,1" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ClaudeSandBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ClaudeSandBrush}" />
    </Style>
    <Style Selector="ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ClaudeRingWarmBrush}" />
    </Style>
    <!-- 导航图标: 整体单色 (Stone Gray), 选中态转 Terracotta 强调。
         必须用样式而非 VM 配色绑定 —— 控件上的 Foreground 绑定属【本地值】,
         优先级高于样式 Setter, 一旦保留绑定, 选中态样式永远无法覆盖。
         原按热键哈希分配的高饱和 Material 色 (pink/blue/purple/deep-orange)
         违反 DESIGN.md「不要引入 Terracotta 之外的饱和色」, 已废止。 -->
    <Style Selector="ListBoxItem TextBlock.navIcon">
      <Setter Property="Foreground" Value="{StaticResource ClaudeStoneGrayBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected TextBlock.navIcon">
      <Setter Property="Foreground" Value="{StaticResource ClaudeTerracottaBrush}" />
    </Style>

    <!-- 自绘标题栏三键 (无边框窗口的替代品)。底色写样式而非内联 ——
         内联是本地值, 会压过下面的 :pointerover 态样式。 -->
    <Style Selector="Button.caption">
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource ClaudeRadiusSm}" />
      <Setter Property="Foreground" Value="{StaticResource ClaudeOliveGrayBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.caption:pointerover">
      <Setter Property="Foreground" Value="{StaticResource ClaudeNearBlackBrush}" />
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ClaudeSandBrush}" />
    </Style>
    <Style Selector="Button.caption:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ClaudeRingWarmBrush}" />
    </Style>
    <!-- 关闭键: 悬停转 Error Crimson 底 + Ivory 字 -->
    <Style Selector="Button.caption.captionClose:pointerover">
      <Setter Property="Foreground" Value="{StaticResource ClaudeIvoryBrush}" />
    </Style>
    <Style Selector="Button.caption.captionClose:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ClaudeErrorBrush}" />
    </Style>
  </Window.Styles>

  <Border Background="{DynamicResource ClaudeWindowSurfaceBrush}"
          BorderBrush="{StaticResource ClaudeBorderWarmBrush}"
          BorderThickness="1">
   <DockPanel>

    <!-- 自绘标题栏 (取代被 NoChrome 去掉的系统标题栏):
         整条为拖动区 (PointerPressed -> BeginMoveDrag), 双击切换最大化; 右侧三键。
         左侧不放品牌组 (与侧栏大 Logo 重复, 用户要求删除): 整条均为空白拖动区。 -->
    <Grid DockPanel.Dock="Top" Height="36" Background="Transparent"
          PointerPressed="OnTitleBarPointerPressed">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2"
                  Margin="0,0,6,0" VerticalAlignment="Center">
        <Button Classes="caption" Content="─" Click="OnMinimizeClick" />
        <Button Classes="caption" Content="□" Click="OnMaximizeClick" />
        <Button Classes="caption captionClose" Content="✕" Click="OnCloseClick" />
      </StackPanel>
    </Grid>

    <Grid ColumnDefinitions="264,*">

    <!-- ===================== 左侧导航 (复刻 NavigationDrawer.vue) ===================== -->
    <Border Grid.Column="0" Background="{StaticResource ClaudeSidebarSurfaceBrush}"
            BorderBrush="{StaticResource ClaudeBorderCreamBrush}" BorderThickness="0,0,1,0">
      <DockPanel>

        <!-- 头部: Logo + 名称 + 版本号 -->
        <StackPanel DockPanel.Dock="Top" Margin="20,18,20,14" Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <!-- 品牌 logo (tb.png 裁剪透明边距后降采样 256x256, 内容占画布 ~93%):
                 尺寸取 52: 52*0.93≈48px 实际图形, 头部 StackPanel 高度从旧 42→52(+10px),
                 不影响 DockPanel Top 布局; 右侧 "KeyFlux" 标题 VerticalAlignment=Center 自动居中。 -->
            <Image Source="avares://KeyFlux.Settings/Assets/logo.png"
                   Width="52" Height="52" />
            <TextBlock VerticalAlignment="Center" Text="KeyFlux"
                       FontFamily="{StaticResource ClaudeSerifFont}"
                       FontSize="18" FontWeight="Medium"
                       Foreground="{StaticResource ClaudeNearBlackBrush}" />
          </StackPanel>
          <Border Height="1" Background="{StaticResource ClaudeBorderCreamBrush}" />
        </StackPanel>

        <!-- 底部: 保存按钮 (label:507) + 保存成功提示 -->
        <StackPanel DockPanel.Dock="Bottom" Margin="16,10,16,16" Spacing="6">
          <Border Height="1" Background="{StaticResource ClaudeBorderCreamBrush}" Margin="0,0,0,10" />
          <TextBlock Text="{Binding SaveNotice}"
                     IsVisible="{Binding SaveNotice, Converter={StaticResource NotEmpty}}"
                     Foreground="{StaticResource ClaudeMutedGreenBrush}" FontSize="12" HorizontalAlignment="Center" />
          <!-- 主操作: Terracotta CTA; 内联底色/描边/圆角全部去掉, 交给 claudeCta 样式接管 -->
          <Button Command="{Binding SaveCommand}" Classes="claudeCta"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
            <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=507}" />
          </Button>
        </StackPanel>

        <!-- 导航列表: 总览 / 选中动作 / 启用的 keymap -->
        <ListBox ItemsSource="{Binding NavItems}"
                 SelectedItem="{Binding CurrentNavItem, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0" Margin="10,0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NavItem">
              <!-- 复刻 Vue 版导航: MDI 图标 + 标题, 无背景方块; 配色由 navIcon 样式接管 (单色 + 选中强调) -->
              <Grid ColumnDefinitions="34,*">
                <TextBlock Text="{Binding IconChar}" FontFamily="{StaticResource MdiFont}"
                           Classes="navIcon" FontSize="26"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                           Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- ===================== 右侧内容区 ===================== -->
    <Grid Grid.Column="1" Background="Transparent" controls:ModalBlur.IsHost="True">
      <ContentControl Content="{Binding CurrentPage}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:HomePageViewModel">
            <views:HomePageView />
          </DataTemplate>
          <DataTemplate DataType="vm:SettingsPageViewModel">
            <views:SettingsPageView />
          </DataTemplate>
          <DataTemplate DataType="vm:KeymapPageViewModel">
            <views:KeymapPageView />
          </DataTemplate>
          <DataTemplate DataType="vm:AbbrPageViewModel">
            <views:AbbrPageView />
          </DataTemplate>
          <DataTemplate DataType="vm:SelectedActionPageViewModel">
            <views:SelectedActionPageView />
          </DataTemplate>
          <DataTemplate DataType="vm:PluginsPageViewModel">
            <views:PluginsPageView />
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>

      <!-- 加载遮罩 -->
      <Border IsVisible="{Binding IsLoading}" Background="{StaticResource ClaudeParchmentBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
          <ProgressBar IsIndeterminate="True" Width="220" Foreground="{StaticResource ClaudeTerracottaBrush}" />
          <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=917}"
                     Foreground="{StaticResource ClaudeStoneGrayBrush}" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- 友好错误页: 后端不可达时展示原因与重试 -->
      <Border IsVisible="{Binding HasError}" Background="{StaticResource ClaudeParchmentBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="560">
          <TextBlock Text="⚠" FontSize="42" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=919}"
                     FontFamily="{StaticResource ClaudeSerifFont}"
                     FontSize="18" FontWeight="Medium" HorizontalAlignment="Center"
                     Foreground="{StaticResource ClaudeNearBlackBrush}"
                     TextWrapping="Wrap" TextAlignment="Center" />
          <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ClaudeStoneGrayBrush}"
                     TextWrapping="Wrap" TextAlignment="Center" />
          <Button Command="{Binding RetryCommand}" Classes="claudeCta" HorizontalAlignment="Center"
                  Padding="18,8"
                  Content="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=920}" />
        </StackPanel>
      </Border>
    </Grid>
    </Grid>
   </DockPanel>
  </Border>

</Window>
