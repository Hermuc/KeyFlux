<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeyFlux.Settings.ViewModels"
             xmlns:services="using:KeyFlux.Settings.Services"
             x:Class="KeyFlux.Settings.Views.MatchTypesPageView"
             x:Name="PageRoot"
             x:DataType="vm:MatchTypesPageViewModel">

  <!--
    匹配类型弹窗内容 —— 与行为库同构, 且**新建/编辑表单内联在本窗右侧详情区** (2026-09-15 用户要求):
    此前表单是覆盖整窗的浮层 (等同第三层弹窗), 现改为详情 ↔ 表单就地切换, 层级与行为库一致。
      · 圆角层级: 容器 claudeCard = Lg(12) / 行·按钮·输入 = Md(8)
      · 配色: Ivory 面 · Sand 悬停 · Parchment 选中 + 陶土指示条 · Terracotta 唯一主 CTA
      · 布局: 顶部说明 → 左列表(卡) + 右详情/表单(卡) → 底部状态 + 按钮栏
      · 快捷: 列表行双击 = 编辑(自定义) / 配置行为(未配置行为)
    底部不再有「关闭窗口」按钮 (窗口标题栏 ✕ 已足够)。
  -->

  <UserControl.Styles>
    <!-- 互斥选项胶囊 (编辑器内专用; 选中态 = 陶土描边 + 淡陶土底) -->
    <Style Selector="ToggleButton.opt">
      <Setter Property="Background" Value="{StaticResource ClaudeIvoryBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource ClaudeBorderCreamBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource ClaudeRadiusMd}" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource ClaudeCharcoalWarmBrush}" />
    </Style>
    <!-- 草稿行 (新建中) 标题弱化: 结构与普通行完全一致, 仅文字变淡表示尚未落定 -->
    <Style Selector="TextBlock.rowTitle.draft">
      <Setter Property="Foreground" Value="{StaticResource ClaudeStoneGrayBrush}" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="ToggleButton.opt:checked">
      <Setter Property="Background" Value="{StaticResource ClaudeParchmentBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource ClaudeTerracottaBrush}" />
      <Setter Property="Foreground" Value="{StaticResource ClaudeTerracottaBrush}" />
    </Style>
  </UserControl.Styles>

  <Border Padding="20">
    <Grid RowDefinitions="Auto,*,Auto">

      <!-- 顶部: 一句话说明 -->
      <TextBlock Grid.Row="0" Classes="claudeMuted" Margin="0,0,0,10" TextWrapping="Wrap"
                 Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2548}" />

      <!-- 中部: 主从布局 (左 340 + 右详情/表单) -->
      <!-- 弹性主从列宽: 左列 240~340 自适应, 右列吃满剩余空间 (窗口放大时表单随之变宽, 窄窗口不挤压) -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="300" MinWidth="240" MaxWidth="340" />
          <ColumnDefinition Width="*" MinWidth="360" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Classes="claudeCard" Margin="0,0,12,0" x:Name="RowListCard">
          <ListBox Classes="claudeList" ItemsSource="{Binding Rows}"
                   SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                   DoubleTapped="OnRowDoubleTapped">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:MatchTypeRowVm">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                  <TextBlock Classes="claudeBody rowTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                             Classes.draft="{Binding IsDraft}" Text="{Binding Label}" />
                  <TextBlock Grid.Column="1" Classes="claudeDim" Margin="8,0,0,0" Text="{Binding StatusText}" />
                  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="claudeDim" Margin="0,3,0,0"
                             TextWrapping="Wrap" Text="{Binding Summary}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <Border Grid.Column="1" Classes="claudeCard" Padding="20" x:Name="DetailCard">
          <Grid>
            <!-- ① 选中项详情 (未在编辑) -->
            <ScrollViewer IsVisible="{Binding !IsEditorOpen}" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="8">
                <TextBlock Classes="claudeDim" TextWrapping="Wrap"
                           IsVisible="{Binding !HasSelection}"
                           Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2547}" />
                <StackPanel Spacing="8" IsVisible="{Binding HasSelection}">
                  <TextBlock Classes="claudeSubtitle" FontSize="18" TextWrapping="Wrap"
                             Text="{Binding SelectedRow.Label}" />
                  <TextBlock Classes="claudeDim" Text="{Binding SelectedRow.Id}" />
                  <TextBlock Classes="claudeBody" TextWrapping="Wrap" Text="{Binding SelectedRow.Summary}" />
                  <TextBlock Classes="claudeMuted" TextWrapping="Wrap" Text="{Binding SelectedRow.StatusText}" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>

            <!-- ② 内联新建/编辑表单 (就地展开, 不弹窗); 操作栏常驻底部, 不随表单滚动 -->
            <Grid IsVisible="{Binding IsEditorOpen}" RowDefinitions="*,Auto">
              <!-- 滚动条贴紧右侧边框 (2026-09-15 用户二次要求: 再靠近右侧边框一些):
                   视口负右 Margin 由 -10 加大到 -16 —— 侵入卡片 20 内边距 16px,
                   滚动条右沿 = 卡片外沿 - 5 (留 1px 描边 + 圆角/呼吸余量);
                   内容右 Margin 同步 22 -> 28 抵消扩量 ⇒ 文字换行边界与位置仍与最初完全一致。
                   定位参数: DetailCard Padding=20 / 描边 1 / ScrollBarSize=10 (可见条宽 16)。
                   (同一手法见 AbbrPageView:13-15 与 CommentSummaryPanel:19-26) -->
              <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,-16,0" x:Name="FormScroll">
                <StackPanel Spacing="16" Margin="0,0,28,0" DataContext="{Binding Editor}">
                  <TextBlock Classes="claudeSubtitle" Text="{Binding Title}" />

                <!-- 名称 -->
                <StackPanel Spacing="6">
                  <TextBlock Classes="claudeDim"
                             Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2523}" />
                  <TextBox Classes="claudeInput" Text="{Binding Label, Mode=TwoWay}" />
                  <TextBlock Classes="claudeDim"
                             Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2554}" />
                </StackPanel>

                <!-- 匹配条件 (互斥两项) -->
                <StackPanel Spacing="10">
                  <TextBlock Classes="claudeBody" FontWeight="SemiBold" Margin="0,4,0,0"
                             Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2555}" />
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <ToggleButton Classes="opt" IsChecked="{Binding IsTextKind, Mode=TwoWay}"
                                  Content="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2556}" />
                    <ToggleButton Classes="opt" IsChecked="{Binding IsFileKind, Mode=TwoWay}"
                                  Content="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2551}" />
                  </StackPanel>

                  <!-- 文本: 匹配内容 -->
                  <StackPanel Spacing="6" IsVisible="{Binding IsTextKind}">
                    <TextBlock Classes="claudeDim"
                               Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2525}" />
                    <ItemsControl ItemsSource="{Binding Rules}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MatchRuleRowVm">
                          <Grid ColumnDefinitions="150,*,Auto" Margin="0,0,0,8">
                            <ComboBox Classes="claudeInput" ItemsSource="{Binding OpOptions}"
                                      SelectedItem="{Binding Op, Mode=TwoWay}">
                              <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:MatchOpOption">
                                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBox Grid.Column="1" Classes="claudeInput" Margin="8,0" Text="{Binding Value, Mode=TwoWay}"
                                     Watermark="{Binding $parent[UserControl].((vm:MatchTypesPageViewModel)DataContext).Editor.LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2550}" />
                            <Button Grid.Column="2" Classes="claudeGhost" Padding="8,4" Margin="0"
                                    Click="OnRemoveRule" CommandParameter="{Binding}" Content="✕" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Classes="claudeGhost" Padding="10,5" FontSize="12" HorizontalAlignment="Left"
                            Click="OnAddRule"
                            Content="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2527}" />
                    <TextBlock Classes="claudeDim"
                               Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2562}" />
                  </StackPanel>

                  <!-- 文件: 扩展名 -->
                  <StackPanel Spacing="6" IsVisible="{Binding IsFileKind}">
                    <TextBlock Classes="claudeDim"
                               Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2528}" />
                    <TextBox Classes="claudeInput" Text="{Binding ExtsText, Mode=TwoWay}"
                             Watermark="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2561}" />
                    <TextBlock Classes="claudeDim"
                               Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2563}" />
                  </StackPanel>

                  <!-- 测试匹配 -->
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBox Classes="claudeInput" Text="{Binding TryContent, Mode=TwoWay}"
                             Watermark="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2557}" />
                    <Button Grid.Column="1" Classes="claudeSand" Command="{Binding TryCommand}" MinWidth="88">
                      <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2560}" />
                    </Button>
                  </Grid>
                  <TextBlock Classes="claudeMuted" FontWeight="SemiBold" IsVisible="{Binding HasTryResult}"
                             Text="{Binding TryResult}" />
                </StackPanel>

                <!-- 匹配后执行的动作 -->
                <StackPanel Spacing="6">
                  <TextBlock Classes="claudeBody" FontWeight="SemiBold" Margin="0,4,0,0"
                             Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2564}" />
                  <ComboBox Classes="claudeInput" HorizontalAlignment="Stretch" ItemsSource="{Binding BaseActionOptions}"
                            SelectedItem="{Binding SelectedBaseAction, Mode=TwoWay}">
                    <!-- 必须给 ItemTemplate: 否则 record 的调试 ToString 会被渲染成 "ComboOption { Value = …, … }" -->
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="services:ComboOption">
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>

                <!-- 高级设置 (默认收起) -->
                <CheckBox IsChecked="{Binding ShowAdvanced, Mode=TwoWay}"
                          Content="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2566}" />
                <StackPanel Spacing="12" Margin="0,2,0,0" IsVisible="{Binding ShowAdvanced}">
                  <StackPanel Spacing="3">
                    <TextBlock Classes="claudeDim"
                               Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2524}" />
                    <TextBox Classes="claudeInput" Text="{Binding Id, Mode=TwoWay}" IsEnabled="{Binding !IsEdit}" />
                  </StackPanel>
                  <StackPanel Spacing="3">
                    <TextBlock Classes="claudeDim"
                               Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2567}" />
                    <TextBox Classes="claudeInput" Text="{Binding LabelEn, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Spacing="3">
                    <TextBlock Classes="claudeDim"
                               Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2568}" />
                    <TextBox Classes="claudeInput" Text="{Binding BehaviorName, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Spacing="3">
                    <TextBlock Classes="claudeDim"
                               Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2532}" />
                    <TextBox Classes="claudeInput" Text="{Binding ActionValue, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Spacing="3">
                    <TextBlock Classes="claudeDim"
                               Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2533}" />
                    <TextBox Classes="claudeInput" Text="{Binding WorkingDir, Mode=TwoWay}" />
                  </StackPanel>
                </StackPanel>

                </StackPanel>
              </ScrollViewer>

              <!-- 常驻操作栏: 校验回显 + 两条创建路径 (始终可见, 无需滚动到底) -->
              <StackPanel Grid.Row="1" Spacing="8" Margin="0,14,0,0" DataContext="{Binding Editor}" x:Name="FormActions">
                <Border Classes="claudeHint" IsVisible="{Binding Error, Converter={StaticResource NotEmpty}}">
                  <TextBlock Classes="claudeBody" FontSize="12" TextWrapping="Wrap"
                             Foreground="{StaticResource ClaudeErrorBrush}" Text="{Binding Error}" />
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                  <Button Classes="claudeGhost" Command="{Binding SaveTypeOnlyCommand}" MinWidth="120">
                    <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2565}" />
                  </Button>
                  <Button Classes="claudeCta" Command="{Binding SaveWithActionCommand}" MinWidth="200">
                    <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2529}" />
                  </Button>
                </StackPanel>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <!-- 底部: 状态 + 左侧提示 + 按钮栏 (编辑态下禁用; 不再有「关闭窗口」) -->
      <StackPanel Grid.Row="2" Margin="0,14,0,0">
        <TextBlock Classes="claudeMuted" TextWrapping="Wrap" Text="{Binding StatusText}" />
        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
          <TextBlock Classes="claudeDim" VerticalAlignment="Center"
                     Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2577}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
            <Button Classes="claudeCta" Click="OnCreate" MinWidth="112"
                    IsEnabled="{Binding CanUseActions, Mode=OneWay}">
              <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2522}" />
            </Button>
            <Button Classes="claudeGhost" Click="OnEditSelected" IsEnabled="{Binding CanEditSelected, Mode=OneWay}">
              <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2546}" />
            </Button>
            <Button Classes="claudeDanger" Click="OnDeleteSelected" IsEnabled="{Binding CanRemoveSelected, Mode=OneWay}">
              <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2536}" />
            </Button>
            <Button Classes="claudeSand" Click="OnSetAction" IsEnabled="{Binding CanSetAction, Mode=OneWay}">
              <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2569}" />
            </Button>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
