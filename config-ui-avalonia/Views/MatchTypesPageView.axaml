<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeyFlux.Settings.ViewModels"
             xmlns:services="using:KeyFlux.Settings.Services"
             x:Class="KeyFlux.Settings.Views.MatchTypesPageView"
             x:Name="PageRoot"
             x:DataType="vm:MatchTypesPageViewModel">

  <!--
    匹配类型弹窗内容 —— 视觉与操作模型**对齐「行为库」窗口** (BehaviorLibraryWindow.axaml):
      顶部一句话说明 → 中部主从布局 (左 340px 列表 + 右详情) → 底部状态栏 + 按钮栏。
      窗口底色/亚克力由外壳 MatchTypesDialogWindow 统一 (ClaudeWindowSurfaceBrush)。
    功能与语义未变: 新建 / 编辑 / 删除 / 配置行为 依旧; 仅"从行内链接"统一到"先选中、再用底部按钮操作"
    (与行为库完全同一操作模型)。编辑面板仍是同一浮层 (新建/编辑共用), 内部字段与交互未变。
  -->

  <UserControl.Styles>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource ClaudeDarkWarmBrush}" />
    </Style>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource ClaudeStoneGrayBrush}" />
    </Style>
    <Style Selector="TextBlock.explain">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{StaticResource ClaudeStoneGrayBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="ToggleButton.opt">
      <Setter Property="Background" Value="{StaticResource ClaudeIvoryBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource ClaudeBorderCreamBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource ClaudeRadiusMd}" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="ToggleButton.opt:checked">
      <Setter Property="Background" Value="{StaticResource ClaudeParchmentBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource ClaudeTerracottaBrush}" />
      <Setter Property="Foreground" Value="{StaticResource ClaudeTerracottaBrush}" />
    </Style>
    <Style Selector="Button.preset">
      <Setter Property="Background" Value="{StaticResource ClaudeSandBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource ClaudeRadiusMd}" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource ClaudeDarkWarmBrush}" />
    </Style>
    <Style Selector="Border.hint">
      <Setter Property="Background" Value="{StaticResource ClaudeSandBrush}" />
      <Setter Property="CornerRadius" Value="{StaticResource ClaudeRadiusMd}" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{StaticResource ClaudeIvoryBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource ClaudeBorderCreamBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource ClaudeRadiusLg}" />
      <Setter Property="Padding" Value="20,16" />
      <Setter Property="BoxShadow" Value="{StaticResource ClaudeShadowCard}" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <Border Padding="20">
      <Grid RowDefinitions="Auto,*,Auto">

        <!-- 顶部: 一句话说明 (对齐行为库的 1095 提示行) -->
        <TextBlock Grid.Row="0" FontSize="12" Foreground="{StaticResource ClaudeStoneGrayBrush}"
                   Margin="0,0,0,10" TextWrapping="Wrap"
                   Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2548}" />

        <!-- 中部: 主从布局 (与行为库同为 340px 左列 + 右侧详情) -->
        <Grid Grid.Row="1" ColumnDefinitions="340,*">
          <ListBox Grid.Column="0" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                   Margin="0,0,12,0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:MatchTypeRowVm">
                <StackPanel Margin="4,6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11"
                               Foreground="{StaticResource ClaudeStoneGrayBrush}" Margin="8,0,0,0" />
                  </Grid>
                  <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{StaticResource ClaudeStoneGrayBrush}"
                             TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8" Margin="4,0,0,0">
              <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2547}"
                         FontSize="12" Foreground="{StaticResource ClaudeStoneGrayBrush}"
                         IsVisible="{Binding !HasSelection}" />
              <!-- 选中项详情 (字段排布与行为库详情一致) -->
              <StackPanel Spacing="8" IsVisible="{Binding HasSelection}">
                <TextBlock Text="{Binding SelectedRow.Label}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SelectedRow.Id}" FontSize="12"
                           Foreground="{StaticResource ClaudeStoneGrayBrush}" />
                <TextBlock Text="{Binding SelectedRow.Summary}" FontSize="12" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SelectedRow.StatusText}" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource ClaudeOliveGrayBrush}" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- 底部: 状态栏 + 按钮栏 (按钮样式与顺序对齐行为库) -->
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
          <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource ClaudeDarkWarmBrush}"
                     TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource ClaudeStoneGrayBrush}"
                       Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2577}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
              <Button Click="OnCreate" Background="Transparent" BorderBrush="{StaticResource ClaudeTerracottaBrush}"
                      BorderThickness="1" Foreground="{StaticResource ClaudeTerracottaBrush}"
                      Padding="12,6" CornerRadius="{StaticResource ClaudeRadiusMd}">
                <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2522}" />
              </Button>
              <Button Click="OnEditSelected" IsEnabled="{Binding CanEditSelected, Mode=OneWay}"
                      Background="Transparent" BorderBrush="{StaticResource ClaudeTerracottaBrush}"
                      BorderThickness="1" Foreground="{StaticResource ClaudeTerracottaBrush}"
                      Padding="12,6" CornerRadius="{StaticResource ClaudeRadiusMd}">
                <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2546}" />
              </Button>
              <Button Click="OnDeleteSelected" IsEnabled="{Binding CanRemoveSelected, Mode=OneWay}"
                      Background="Transparent" BorderBrush="{StaticResource ClaudeErrorBrush}"
                      BorderThickness="1" Foreground="{StaticResource ClaudeErrorBrush}"
                      Padding="12,6" CornerRadius="{StaticResource ClaudeRadiusMd}">
                <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2536}" />
              </Button>
              <Button Click="OnSetAction" IsEnabled="{Binding CanSetAction, Mode=OneWay}"
                      Background="{StaticResource ClaudeTerracottaBrush}" Foreground="{StaticResource ClaudeIvoryBrush}"
                      Padding="12,6" CornerRadius="{StaticResource ClaudeRadiusMd}">
                <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2569}" />
              </Button>
              <Button Click="OnClose" Padding="12,6" CornerRadius="{StaticResource ClaudeRadiusMd}">
                <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1}" />
              </Button>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===================== 新建 / 编辑浮层 (字段与交互未变) ===================== -->
    <Border IsVisible="{Binding IsEditorOpen}" Background="#55000000">
      <Border Classes="panel" Width="640" MaxHeight="620" HorizontalAlignment="Center" VerticalAlignment="Center">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding Editor.Title}" FontSize="17" FontWeight="SemiBold"
                     Foreground="{StaticResource ClaudeNearBlackBrush}" Margin="0,0,0,12" />

          <!-- 两条创建路径 = 两个按钮 -->
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                      Spacing="10" Margin="0,14,0,0">
            <Button Command="{Binding Editor.SaveTypeOnlyCommand}" MinWidth="120"
                    Background="{StaticResource ClaudeIvoryBrush}"
                    BorderBrush="{StaticResource ClaudeBorderCreamBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource ClaudeRadiusMd}" Padding="14,7"
                    Content="{Binding Editor.LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2565}" />
            <Button Command="{Binding Editor.SaveWithActionCommand}" MinWidth="200"
                    Background="{StaticResource ClaudeTerracottaBrush}"
                    Foreground="{StaticResource ClaudeIvoryBrush}"
                    CornerRadius="{StaticResource ClaudeRadiusMd}" Padding="14,7"
                    Content="{Binding Editor.LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2529}" />
          </StackPanel>

          <ScrollViewer>
            <StackPanel Spacing="12">

              <!-- 常用类型一键套用 -->
              <ItemsControl ItemsSource="{Binding Editor.Presets}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="services:MatchTypePreset">
                    <Button Classes="preset" Margin="0,0,6,6" Click="OnApplyPreset" Content="{Binding Label}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- 名称 -->
              <StackPanel Spacing="3">
                <TextBlock Classes="fieldLabel"
                           Text="{Binding Editor.LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2523}" />
                <TextBox Text="{Binding Editor.Label, Mode=TwoWay}" />
                <TextBlock Classes="explain"
                           Text="{Binding Editor.LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2554}" />
              </StackPanel>

              <!-- 匹配条件 (互斥两项) -->
              <StackPanel Spacing="6">
                <TextBlock Classes="sectionTitle"
                           Text="{Binding Editor.LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2555}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ToggleButton Classes="opt" IsChecked="{Binding Editor.IsTextKind, Mode=TwoWay}"
                                Content="{Binding Editor.LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2556}" />
                  <ToggleButton Classes="opt" IsChecked="{Binding Editor.IsFileKind, Mode=TwoWay}"
                                Content="{Binding Editor.LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2551}" />
                </StackPanel>

                <!-- 文本: 匹配内容 -->
                <StackPanel Spacing="6" IsVisible="{Binding Editor.IsTextKind}">
                  <TextBlock Classes="fieldLabel"
                             Text="{Binding Editor.LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2525}" />
                  <ItemsControl ItemsSource="{Binding Editor.Rules}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:MatchRuleRowVm">
                        <Grid ColumnDefinitions="140,*,Auto" Margin="0,0,0,6">
                          <ComboBox ItemsSource="{Binding OpOptions}" SelectedItem="{Binding Op, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                              <DataTemplate x:DataType="vm:MatchOpOption">
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <TextBox Grid.Column="1" Margin="8,0" Text="{Binding Value, Mode=TwoWay}"
                                   Watermark="{Binding $parent[UserControl].((vm:MatchTypesPageViewModel)DataContext).Editor.LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2550}" />
                          <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="6,2"
                                  FontSize="12" Foreground="{StaticResource ClaudeStoneGrayBrush}"
                                  Click="OnRemoveRule" CommandParameter="{Binding}" Content="✕" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Click="OnAddRule" HorizontalAlignment="Left"
                          Background="Transparent" BorderThickness="0" Padding="0"
                          FontSize="12" Foreground="{StaticResource ClaudeTerracottaBrush}"
                          Content="{Binding Editor.LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2527}" />
                  <TextBlock Classes="explain"
                             Text="{Binding Editor.LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2562}" />
                </StackPanel>

                <!-- 文件: 扩展名 -->
                <StackPanel Spacing="3" IsVisible="{Binding Editor.IsFileKind}">
                  <TextBlock Classes="fieldLabel"
                             Text="{Binding Editor.LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2528}" />
                  <TextBox Text="{Binding Editor.ExtsText, Mode=TwoWay}"
                           Watermark="{Binding Editor.LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2561}" />
                  <TextBlock Classes="explain"
                             Text="{Binding Editor.LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2563}" />
                </StackPanel>

                <!-- 测试匹配 -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Text="{Binding Editor.TryContent, Mode=TwoWay}"
                           Watermark="{Binding Editor.LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2557}" />
                  <Button Grid.Column="1" Command="{Binding Editor.TryCommand}" MinWidth="80"
                          Content="{Binding Editor.LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2560}" />
                </Grid>
                <TextBlock Classes="explain" IsVisible="{Binding Editor.HasTryResult}"
                           Text="{Binding Editor.TryResult}" FontWeight="SemiBold"
                           Foreground="{StaticResource ClaudeTerracottaBrush}" />
              </StackPanel>

              <!-- 匹配后执行的动作 -->
              <StackPanel Spacing="4">
                <TextBlock Classes="sectionTitle"
                           Text="{Binding Editor.LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2564}" />
                <ComboBox ItemsSource="{Binding Editor.BaseActionOptions}" MinWidth="240"
                          SelectedItem="{Binding Editor.SelectedBaseAction, Mode=TwoWay}">
                  <!-- 必须给 ItemTemplate: 否则 record 的调试 ToString 会被渲染成 "ComboOption { Value = …, … }" -->
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="services:ComboOption">
                      <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <!-- 高级设置 (默认收起) -->
              <CheckBox IsChecked="{Binding Editor.ShowAdvanced, Mode=TwoWay}"
                        Content="{Binding Editor.LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2566}" />
              <StackPanel Spacing="10" IsVisible="{Binding Editor.ShowAdvanced}">
                <StackPanel Spacing="3">
                  <TextBlock Classes="fieldLabel"
                             Text="{Binding Editor.LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2524}" />
                  <TextBox Text="{Binding Editor.Id, Mode=TwoWay}" IsEnabled="{Binding !Editor.IsEdit}" />
                </StackPanel>
                <StackPanel Spacing="3">
                  <TextBlock Classes="fieldLabel"
                             Text="{Binding Editor.LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2567}" />
                  <TextBox Text="{Binding Editor.LabelEn, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Spacing="3">
                  <TextBlock Classes="fieldLabel"
                             Text="{Binding Editor.LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2568}" />
                  <TextBox Text="{Binding Editor.BehaviorName, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Spacing="3">
                  <TextBlock Classes="fieldLabel"
                             Text="{Binding Editor.LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2532}" />
                  <TextBox Text="{Binding Editor.ActionValue, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Spacing="3">
                  <TextBlock Classes="fieldLabel"
                             Text="{Binding Editor.LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2533}" />
                  <TextBox Text="{Binding Editor.WorkingDir, Mode=TwoWay}" />
                </StackPanel>
              </StackPanel>

              <!-- 校验/保存错误 -->
              <Border Classes="hint" IsVisible="{Binding Editor.Error, Converter={StaticResource NotEmpty}}">
                <TextBlock Text="{Binding Editor.Error}" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource ClaudeTerracottaBrush}" />
              </Border>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
