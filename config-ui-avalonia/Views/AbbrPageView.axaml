<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeyFlux.Settings.ViewModels"
             xmlns:controls="using:KeyFlux.Settings.Views.Controls"
             x:Class="KeyFlux.Settings.Views.AbbrPageView"
             x:Name="Root"
             x:DataType="vm:AbbrPageViewModel">

  <!-- 缩写命令页 (复刻 views/Abbr.vue): 缩写 chips + 命令框 + 编辑面板 + 备注汇总
       布局: 外层 Grid 只承载页面背景 (铺满内容区, 避免 Margin 露白),
       内层 Grid 带边距与裁剪; 左列 (chips/命令框/编辑面板) 固定不滚动, 右列备注汇总独立滚动 -->
  <Grid Background="{StaticResource ClaudeParchmentBrush}">
    <!-- 右边距 4 (原 24): 右列备注滚动区向右扩 20, 滚动条右移远离文字;
         文字宽度由 CommentSummaryPanel 内容右 Margin 20 保持不变 -->
    <Grid ColumnDefinitions="Auto,*" Margin="24,20,4,28" ClipToBounds="True">

      <!-- 左列: 缩写功能区 (固定, 无滚动器); Viewbox Uniform 等比缩放:
           窗口变小时整体缩小不裁剪, 变大时适度放大; 右列备注不缩放 -->
      <Viewbox Stretch="Uniform">
        <StackPanel MinWidth="500" MaxWidth="740">

        <!-- 缩写条目 (WrapPanel chips, 复刻 d-flex flex-wrap 的 Key 列表);
             MaxWidth=570 必须保留: 左列在 Viewbox 内, Auto 列测量给 Infinity 宽, 无上限时 WrapPanel 会单行铺开;
             项占位 = 53 (MinWidth) + 4 (右 Margin 间距) = 57, 570 限每行最多 10 格 (第 11 格需 627 > 570 自动换行);
             WrapPanel Left 对齐后收缩为实际最宽行宽, 经 SizeChanged 同步给编辑框 -->
        <ItemsControl ItemsSource="{Binding Chips}" MaxWidth="570">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel HorizontalAlignment="Left" SizeChanged="OnChipsPanelSizeChanged" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:KeyCellVm">
              <Button MinWidth="53" Height="44" Padding="10,0" Margin="0,0,4,4" CornerRadius="{StaticResource ClaudeRadiusSm}"
                      Background="{Binding Background}"
                      IsEnabled="{Binding IsEnabled}"
                      Foreground="{StaticResource ClaudeNearBlackBrush}" BorderBrush="{StaticResource ClaudeRingWarmBrush}" BorderThickness="1"
                      Command="{Binding #Root.((vm:AbbrPageViewModel)DataContext).SelectChipCommand}"
                      CommandParameter="{Binding}">
                <TextBlock Text="{Binding Label}" FontSize="17"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 命令框 (label:406; 回车执行 del/rn/选中) -->
        <TextBox Text="{Binding CmdText}" KeyDown="OnCmdKeyDown"
                 Watermark="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=406}"
                 Margin="2,16,0,0" Padding="8,6" />

        <controls:ActionEditorPanel x:Name="EditorPanel" Width="570" Margin="0,18,0,0" DataContext="{Binding Editor}" />
        </StackPanel>
      </Viewbox>

      <!-- 右列: 备注汇总 (keyText 用 formatSpace 格式化, 独立滚动) -->
      <controls:CommentSummaryPanel Grid.Column="1" Margin="32,4,0,0"
                                    ItemsSource="{Binding CommentEntries}"
                                    LanguageTick="{Binding LanguageTick}" />
    </Grid>
  </Grid>
</UserControl>
