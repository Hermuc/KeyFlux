<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeyFlux.Settings.ViewModels"
             xmlns:controls="using:KeyFlux.Settings.Views.Controls"
             x:Class="KeyFlux.Settings.Views.CustomHotkeyPageView"
             x:Name="Root"
             x:DataType="vm:CustomHotkeyPageViewModel">

  <!-- 全局自定义热键页 (复刻 views/CustomHotkey.vue): 左侧热键表 + 右侧动作编辑面板
       整页内容包 Viewbox Uniform 等比缩放 (背景留在 ScrollViewer 上, 不随缩放):
       内容全固定宽 (336/512 + 间距边距 = 920px, 框各窄 20%), Viewbox 以 Infinity 测量, DesiredSize 稳定;
       (原右列按键写法说明卡已移除, 内容已迁入总览页文档 config_doc.md「 ⌨️ 按键写法说明 」小节);
       ScrollViewer 横向 Disabled -> Viewbox Uniform 随内容区宽动态缩放, 但 MaxWidth=1120 封顶:
       窗口缩窄时组件等比缩小; 加宽超过默认内容区 (936) 后继续放大, 最大约 1120/920 ≈ 1.22 倍;
       纵向放大溢出由 ScrollViewer 滚动承接; 要调最大上限改 MaxWidth (默认下限随窗口自适应); -->
  <ScrollViewer Background="#F0F2F7">
    <Viewbox Stretch="Uniform" MaxWidth="1120" HorizontalAlignment="Left">
    <StackPanel Orientation="Horizontal" Margin="24,20,24,28" Spacing="24" VerticalAlignment="Top">

      <!-- 左: 热键表格 (热键 / 备注 / 删除) -->
      <Border Width="336" Background="White" CornerRadius="12" Padding="16"
              VerticalAlignment="Top">
        <DockPanel>
          <!-- 表头 -->
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
            <TextBlock Width="110" Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=404}" Foreground="#8A8F98" FontSize="12" />
            <TextBlock Width="140" Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=305}" Foreground="#8A8F98" FontSize="12" />
            <TextBlock Width="40" />
          </StackPanel>

          <!-- 新增一个 (label:405) -->
          <Button DockPanel.Dock="Bottom" Command="{Binding AddRowCommand}"
                  HorizontalAlignment="Right" Margin="0,12,0,0"
                  Background="Transparent" BorderBrush="#2E7D32" BorderThickness="1"
                  Foreground="#2E7D32" Padding="12,5" CornerRadius="8">
            <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=405}" />
          </Button>

          <!-- 行: 整行可点选中 (复刻 tr @click=checkRow) -->
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CustomHotkeyRowVm">
                <Grid ColumnDefinitions="110,140,*" Margin="0,1"
                      Background="{Binding RowBackground}"
                      PointerPressed="OnRowPressed">
                  <!-- 热键编辑框 (失焦提交, 复刻 @change=changeCustomHotkey) -->
                  <TextBox Text="{Binding Hotkey}" LostFocus="OnHotkeyLostFocus" GotFocus="OnRowFocused"
                           Watermark="{Binding #Root.((vm:CustomHotkeyPageViewModel)DataContext).LanguageTick, Converter={StaticResource Tr}, ConverterParameter=957}"
                           Padding="6,4" FontSize="13" />
                  <!-- 备注 (复刻 translate(getActionComment)) -->
                  <TextBlock Grid.Column="1" Text="{Binding Comment}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" FontSize="13" Margin="8,0" />
                  <!-- 删除 (复刻 mdi-delete-outline) -->
                  <Button Grid.Column="2" Content="✕"
                          Command="{Binding #Root.((vm:CustomHotkeyPageViewModel)DataContext).RemoveRowCommand}"
                          CommandParameter="{Binding}"
                          Background="Transparent" Foreground="#C62828" Padding="6,3"
                          HorizontalAlignment="Right" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </Border>

      <!-- 右: 动作编辑面板 (原按键写法说明卡已移除, 内容迁入总览页文档 config_doc.md) -->
      <controls:ActionEditorPanel Width="512" DataContext="{Binding Editor}" />

    </StackPanel>
    </Viewbox>
  </ScrollViewer>
</UserControl>
