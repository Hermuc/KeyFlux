<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeyFlux.Settings.ViewModels"
             xmlns:controls="using:KeyFlux.Settings.Views.Controls"
             x:Class="KeyFlux.Settings.Views.KeymapPageView"
             x:Name="Root"
             x:DataType="vm:KeymapPageViewModel">

  <!-- 键位图页 (复刻 views/Keymap.vue): 物理键盘网格 + 动作编辑面板 + 右侧备注汇总
       布局: 外层 Grid 只承载页面背景 (铺满内容区, 避免 Margin 露白),
       内层 Grid 带边距与裁剪; 左列 (页头/键盘/编辑面板) 固定不滚动, 右列备注汇总独立滚动 -->
  <Grid Background="Transparent">
    <!-- 右边距 4 (原 24): 右列备注滚动区向右扩 20, 滚动条右移远离文字;
         文字宽度由 CommentSummaryPanel 内容右 Margin 20 保持不变 -->
    <Grid ColumnDefinitions="Auto,*" Margin="24,20,4,28" ClipToBounds="True">

      <!-- 左列: 键位功能区 (固定, 无滚动器); Viewbox Uniform 等比缩放:
           窗口变小时整体缩小不裁剪, 变大时适度放大; 右列备注不缩放 -->
      <Viewbox Stretch="Uniform">
        <StackPanel MinWidth="500">

        <!-- 页头: 模式名称 + 子模式上层信息 (label:503) -->
        <StackPanel Orientation="Horizontal" Spacing="14" Margin="2,0,0,12">
          <TextBlock Text="{Binding HeaderTitle}" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="{Binding ParentInfo}" FontSize="13" Foreground="{StaticResource ClaudeStoneGrayBrush}"
                     VerticalAlignment="Center" />
        </StackPanel>

        <!-- 键盘网格: 行 -> 键格 (选中蓝 / 禁用灰 / 已绑定绿 / 空键白);
             单字符键格 (Label 恰 1 字符, 如 A/,) 为 43×43 正方形, 圆角与其余键格一致 (6);
             多字符键保持自然宽度左对齐 (10*58 + 9*4 = 616px 仅为全多字符键行的理论上限, 实际最宽行由 SizeChanged 动态实测);
             行面板 Left 对齐后 Bounds.Width 即该行自然宽度, SizeChanged 汇总各行取最大值,
             动态同步给编辑面板 (借鉴 AbbrPageView chips 最宽行对齐机制), 不写死数值 -->
        <ItemsControl x:Name="KeyboardGrid" ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:KeyboardRowVm">
              <ItemsControl ItemsSource="{Binding Keys}" Margin="0,0,0,4">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <!-- HorizontalAlignment=Left: 面板收缩为该行自然宽度 (实测各键宽 + 间距),
                         否则被外层纵向 StackPanel 拉伸为占位宽, ActualWidth 失真;
                         模板级 NameScope 无法 x:Name, 直挂 SizeChanged 由页面汇总最宽行 -->
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left"
                                SizeChanged="OnKeyboardRowSizeChanged" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:KeyCellVm">
                    <Button Height="43" Width="{Binding CellWidth}" MinWidth="{Binding CellMinWidth}"
                            Padding="{Binding CellPadding}" CornerRadius="{StaticResource ClaudeRadiusSm}"
                            Background="{Binding Background}"
                            IsEnabled="{Binding IsEnabled}"
                            Foreground="{StaticResource ClaudeNearBlackBrush}" BorderBrush="{StaticResource ClaudeRingWarmBrush}" BorderThickness="1"
                            Command="{Binding #Root.((vm:KeymapPageViewModel)DataContext).SelectKeyCommand}"
                            CommandParameter="{Binding}">
                      <TextBlock Text="{Binding Label}"
                                 FontSize="{Binding #Root.((vm:KeymapPageViewModel)DataContext).KeyFontSize}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 动作编辑面板: 外框 (EditorFrame) 宽度由行面板 SizeChanged 同步为
             键盘网格最宽行实际宽度 (Width=620 仅首帧占位); 外框横向 Padding=2 使内部白卡片
             左右各内缩 2, 不贴按钮 (仅模式页生效, 不改共享的 ActionEditorPanel);
             左列占位 = 最宽行实际宽度 (不再右补偿: 实测 UIA 补偿 Margin 经 Viewbox 缩放
             在网格↔备注列间放大成百余物理像素空白); top Margin 12 保持网格↔面板垂直间距 -->
        <Border x:Name="EditorFrame" Width="620" Padding="2,0" Margin="0,12,0,0">
          <controls:ActionEditorPanel x:Name="EditorPanel" DataContext="{Binding Editor}" />
        </Border>
        </StackPanel>
      </Viewbox>

      <!-- 右列: 备注汇总 (复刻 ActionCommentTable, 独立滚动);
           左 Margin 32 与 Command/缩写页 (AbbrPageView) 一致; 两页左列均为 Viewbox 内容等宽,
           实测渲染间距一致 (改前模式页因右补偿多余 ~112px, 已移除) -->
      <controls:CommentSummaryPanel Grid.Column="1" Margin="32,36,0,0"
                                    ItemsSource="{Binding CommentEntries}"
                                    LanguageTick="{Binding LanguageTick}" />
    </Grid>
  </Grid>
</UserControl>
