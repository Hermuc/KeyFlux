<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeyFlux.Settings.ViewModels"
             x:Class="KeyFlux.Settings.Views.PluginsPageView"
             x:DataType="vm:PluginsPageViewModel">

  <!-- 插件页 (左侧导航「插件」): 诚实最小版。
       阶段 0 实测结论: 插件生态契约层完成度高、运行时约 20-30%, 不足以支撑插件市场,
       故本页不做「可安装插件列表」的假象 —— 只展示内置插件现状 + 第三方市场的诚实说明。
       内置插件卡片可点击, 点击后经 QuickSwitchDialogWindow 编辑 Config.Options.QuickSwitch 并落盘。 -->
  <ScrollViewer>
    <StackPanel Margin="36,28,36,40" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">

      <!-- 页面标题 (导航标题共用 2418) -->
      <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2418}"
                 FontSize="22" FontWeight="Bold" />

      <!-- ① 内置插件: 仅「快速切换」一行 -->
      <Border Background="White" CornerRadius="12" Padding="16" BorderBrush="#E3E6EC" BorderThickness="1">
        <StackPanel Spacing="12">
          <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2419}"
                     FontWeight="SemiBold" FontSize="16" />
          <Button Background="#F7F8FB" CornerRadius="8" Padding="14" HorizontalContentAlignment="Stretch" Click="OnQuickSwitchCardClick">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="5">
                <!-- 插件名复用 QuickSwitch 文案 2408 (与设置页分区同名) -->
                <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2408}"
                           FontWeight="SemiBold" FontSize="14" />
                <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2422}"
                           TextWrapping="Wrap" Foreground="#8A8F98" FontSize="13" />
                <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2426}"
                           TextWrapping="Wrap" Foreground="#4169E1" FontSize="12" />
              </StackPanel>
              <!-- 当前启用状态 (读 config.options.quickSwitch.collectEnabled; 中性配色, 不靠颜色谎报开关) -->
              <Border Grid.Column="1" VerticalAlignment="Top" Margin="12,0,0,0"
                      Background="#EEF1F6" CornerRadius="10" Padding="10,4">
                <TextBlock Text="{Binding QuickSwitchStatusText}" Foreground="#5A6472"
                           FontSize="12" FontWeight="SemiBold" />
              </Border>
            </Grid>
          </Button>
        </StackPanel>
      </Border>

      <!-- ② 第三方插件: 明确「尚未开放」+ 原因, 不伪造可安装条目 -->
      <Border Background="White" CornerRadius="12" Padding="16" BorderBrush="#E3E6EC" BorderThickness="1">
        <StackPanel Spacing="12">
          <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2420}"
                     FontWeight="SemiBold" FontSize="16" />
          <Border Background="#FFF8E1" CornerRadius="8" Padding="14">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2421}"
                         FontWeight="SemiBold" Foreground="#B26A00" TextWrapping="Wrap" />
              <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2425}"
                         TextWrapping="Wrap" Foreground="#8A8F98" FontSize="13" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
