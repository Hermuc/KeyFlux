<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeyFlux.Settings.ViewModels"
             x:Class="KeyFlux.Settings.Views.PluginsPageView"
             x:Name="Root"
             x:DataType="vm:PluginsPageViewModel">

  <!-- 插件页 (左侧导航「插件」) —— Claude 风格 (羊皮纸/象牙/陶土暖色系, DESIGN.md):
       统一插件列表 (首卡内置「快速切换」+ 用户插件, 不分区), 每卡 = 插件信息 + 开关一体化:
       开关在右, 状态文字 (已启用/已停用) 在开关正下方。入口 = 插件市场 (terracotta CTA) + 导入插件。
       诚实边界: 引擎侧插件运行时为阶段 2, 用户插件卡带「运行时支持开发中」标注。
       本页样式页面级自包含; 令牌与类样式来自皮肤文件 Styles/Skins/Claude.axaml。
       原页内的 ToggleSwitch 开启态覆盖已上移到 App.axaml 的 Application.Resources
       (模板内部 {DynamicResource} 沿逻辑树查找, 放在页面里只对本页生效且属皮肤值外泄)。 -->

  <UserControl.Styles>
    <!-- 标题 serif: Georgia (中文回退雅黑), DESIGN.md「serif 承载标题」 -->
    <Style Selector="TextBlock.pageTitle">
      <Setter Property="FontFamily" Value="Georgia, Microsoft YaHei UI" />
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{StaticResource ClaudeNearBlackBrush}" />
    </Style>
    <Style Selector="TextBlock.pluginName">
      <Setter Property="FontFamily" Value="Georgia, Microsoft YaHei UI" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource ClaudeNearBlackBrush}" />
    </Style>
    <!-- 插件卡: Ivory 面 + cream 细边 + 静止态柔和投影 (2026-09-11 用户反馈:
         此前静止态只有 1px 细边, 视觉上"阴影边界紧贴文字";
         投影 blur 超出卡片边界约 20px, 依赖下方 ItemsControl 的 ClipToBounds=False 才不被裁) -->
    <Style Selector="Border.pluginCard">
      <Setter Property="Background" Value="{StaticResource ClaudeIvoryBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource ClaudeBorderCreamBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource ClaudeRadiusLg}" />
      <Setter Property="Padding" Value="20,16" />
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="BoxShadow" Value="{StaticResource ClaudeShadowCard}" />
    </Style>
    <Style Selector="Border.pluginCard:pointerover">
      <Setter Property="BoxShadow" Value="{StaticResource ClaudeShadowCardHover}" />
    </Style>
    <!-- 按动: inset 环 (Border 自带 BoxShadow, 无需模板部件) -->
    <Style Selector="Border.pluginCard:pressed">
      <Setter Property="BoxShadow" Value="{StaticResource ClaudeShadowPressedInset}" />
    </Style>
    <!-- 焦点环 (键盘聚焦卡片内开关/按钮时显示; Border 非可聚焦, 故补 :focus-within) -->
    <Style Selector="Border.pluginCard:focus-visible">
      <Setter Property="BoxShadow" Value="{StaticResource ClaudeShadowFocusRing}" />
    </Style>
    <Style Selector="Border.pluginCard:focus-within">
      <Setter Property="BoxShadow" Value="{StaticResource ClaudeShadowFocusRing}" />
    </Style>
    <!-- 卡片信息区按钮: 全透明 (视觉与 StackPanel 无异, 仅提供可点性)。
         ⚠ 必须在 基态/:pointerover/:pressed 三态都压 /template/ PART_ContentPresenter 的背景 ——
         Fluent 模板部件的自带灰底会压过控件级 Background=Transparent (坑: 「模板部件压过控件属性」),
         否则指针进入卡片时文字区会出现一块紧贴文字的 Fluent 灰底,
         视觉上正是用户报的"边界紧贴文字的阴影" (2026-09-11)。 -->
    <Style Selector="Button.cardBody">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <!-- Padding 把按压 inset 环从文字边撑开 (环画在按钮边界上, Padding=0 时左侧贴死文字);
           负 Margin 等量抵消 (见 DataTemplate 内 Button), 布局占位与无 Padding 时完全一致 -->
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="{StaticResource ClaudeRadiusMd}" />
      <Setter Property="RenderTransform" Value="translate(0px, 0px)" />
    </Style>
    <Style Selector="Button.cardBody /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.cardBody:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.cardBody:pressed">
      <Setter Property="RenderTransform" Value="translate(0px, 1px)" />
    </Style>
    <Style Selector="Button.cardBody:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.cardBody:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="{StaticResource ClaudeShadowPressedInset}" />
    </Style>
    <!-- 焦点环 (声明在 :pressed 之后; BoxShadow 在模板 ContentPresenter 上, 因 Button 无 BoxShadow 属性) -->
    <Style Selector="Button.cardBody:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="{StaticResource ClaudeShadowFocusRing}" />
    </Style>
    <!-- 紧凑开关 (无右侧文字, 状态文字由卡内 TextBlock 承载) -->
    <Style Selector="ToggleSwitch.compact">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="OnContent" Value="{x:Null}" />
      <Setter Property="OffContent" Value="{x:Null}" />
    </Style>
    <!-- 主 CTA: Terracotta -->
    <Style Selector="Button.cta">
      <Setter Property="Background" Value="{StaticResource ClaudeTerracottaBrush}" />
      <Setter Property="Foreground" Value="{StaticResource ClaudeIvoryBrush}" />
      <Setter Property="CornerRadius" Value="{StaticResource ClaudeRadiusMd}" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="RenderTransform" Value="translate(0px, 0px)" />
    </Style>
    <Style Selector="Button.cta:pressed">
      <Setter Property="RenderTransform" Value="translate(0px, 1px)" />
    </Style>
    <Style Selector="Button.cta:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="{StaticResource ClaudeShadowPressedInset}" />
    </Style>
    <Style Selector="Button.cta:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="{StaticResource ClaudeShadowFocusRing}" />
    </Style>
    <!-- 次级按钮: Warm Sand -->
    <Style Selector="Button.sand">
      <Setter Property="Background" Value="{StaticResource ClaudeSandBrush}" />
      <Setter Property="Foreground" Value="{StaticResource ClaudeCharcoalWarmBrush}" />
      <Setter Property="CornerRadius" Value="{StaticResource ClaudeRadiusMd}" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="RenderTransform" Value="translate(0px, 0px)" />
    </Style>
    <Style Selector="Button.sand:pressed">
      <Setter Property="RenderTransform" Value="translate(0px, 1px)" />
    </Style>
    <Style Selector="Button.sand:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="{StaticResource ClaudeShadowPressedInset}" />
    </Style>
    <Style Selector="Button.sand:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="{StaticResource ClaudeShadowFocusRing}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer Background="Transparent">
    <StackPanel Margin="36,32,36,40" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">

      <!-- 标题行: 页面标题 (共用 2418) + 两个入口 (市场 2428 / 导入 2427) -->
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2418}"
                   Classes="pageTitle" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="cta" Click="OnMarketClick" Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2428}" />
        </Button>
        <Button Grid.Column="2" Classes="sand" Click="OnImportClick" Margin="8,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2427}" />
        </Button>
      </Grid>

      <!-- 一次性操作回显 (导入成功等; Claude 体系内强调反馈用 terracotta) -->
      <TextBlock Text="{Binding StatusText}" FontSize="13" Foreground="{StaticResource ClaudeTerracottaBrush}" FontWeight="SemiBold"
                 IsVisible="{Binding StatusText, Converter={StaticResource NotEmpty}}" />

      <!-- 统一插件列表: 首卡内置「快速切换」+ 用户插件 (不区分来源)
           ClipToBounds=False: 卡片悬停时的 ring 阴影画在自身边界外 1px, 而 ItemsControl
           默认会裁剪到自身边界 (下侧因卡片有 10px 底边距而幸免) —— 不关掉就会
           出现"阴影只有下侧, 左/右/上缺失"的裁剪。 -->
      <ItemsControl ItemsSource="{Binding Plugins}" ClipToBounds="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PluginCardVm">
            <Border Classes="pluginCard" PointerPressed="OnCardPointerPressed">
              <Grid ColumnDefinitions="*,Auto,Auto">

                <!-- 信息区: 内置卡点击打开配置对话框 (CanConfigure); 用户卡暂无配置 (阶段 2)
                     负 Margin 与 cardBody 样式的 Padding(10,6) 等量抵消, 占位不变 -->
                <Button Grid.Column="0" Classes="cardBody" Margin="-10,-6,6,-6"
                        Click="OnCardConfigureClick" CommandParameter="{Binding}">
                  <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="pluginName" Text="{Binding DisplayName}" VerticalAlignment="Center" />
                      <!-- 版本徽标 (Warm Sand) -->
                      <Border Background="{StaticResource ClaudeSandBrush}" CornerRadius="10" Padding="8,2"
                              VerticalAlignment="Center"
                              IsVisible="{Binding VersionText, Converter={StaticResource NotEmpty}}">
                        <TextBlock Text="{Binding VersionText}" FontSize="11" Foreground="{StaticResource ClaudeCharcoalWarmBrush}" />
                      </Border>
                      <!-- 运行时标注 (仅用户插件): 引擎加载为阶段 2, 诚实边界 -->
                      <Border Background="{StaticResource ClaudeSandBrush}" CornerRadius="10" Padding="8,2"
                              VerticalAlignment="Center" IsVisible="{Binding !IsBuiltin}">
                        <TextBlock FontSize="11" Foreground="{StaticResource ClaudeOliveGrayBrush}"
                                   Text="{Binding #Root.((vm:PluginsPageViewModel)DataContext).LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2421}" />
                      </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                               Foreground="{StaticResource ClaudeOliveGrayBrush}" FontSize="13" />
                    <TextBlock Text="{Binding Author}" Foreground="{StaticResource ClaudeStoneGrayBrush}" FontSize="11"
                               IsVisible="{Binding Author, Converter={StaticResource NotEmpty}}" />
                    <!-- 配置引导 (仅内置卡, terracotta 小字) -->
                    <TextBlock Text="{Binding #Root.((vm:PluginsPageViewModel)DataContext).LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2426}"
                               TextWrapping="Wrap" Foreground="{StaticResource ClaudeTerracottaBrush}" FontSize="11"
                               IsVisible="{Binding CanConfigure}" />
                  </StackPanel>
                </Button>

                <!-- 开关列: 开关 + 正下方状态文字 (启用 Olive SemiBold / 停用 Stone) -->
                <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="2"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                  <ToggleSwitch Classes="compact" IsChecked="{Binding Enabled}" />
                  <TextBlock FontSize="10" HorizontalAlignment="Center"
                             Text="{Binding #Root.((vm:PluginsPageViewModel)DataContext).LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2423}"
                             Foreground="{StaticResource ClaudeOliveGrayBrush}" FontWeight="SemiBold"
                             IsVisible="{Binding Enabled}" />
                  <TextBlock FontSize="10" HorizontalAlignment="Center"
                             Text="{Binding #Root.((vm:PluginsPageViewModel)DataContext).LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2424}"
                             Foreground="{StaticResource ClaudeStoneGrayBrush}"
                             IsVisible="{Binding !Enabled}" />
                </StackPanel>

                <!-- 删除 (仅用户插件, tooltip 复用 912) -->
                <Button Grid.Column="2" Content="✕" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"
                        IsVisible="{Binding CanDelete}"
                        ToolTip.Tip="{Binding #Root.((vm:PluginsPageViewModel)DataContext).LanguageTick, Converter={StaticResource Tr}, ConverterParameter=912}"
                        Command="{Binding #Root.((vm:PluginsPageViewModel)DataContext).DeletePluginCommand}"
                        CommandParameter="{Binding}"
                        Background="Transparent" Foreground="{StaticResource ClaudeErrorBrush}" Padding="6,3" />

              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- 加载中 -->
      <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2439}"
                 Foreground="{StaticResource ClaudeStoneGrayBrush}" FontSize="13"
                 IsVisible="{Binding IsLoadingPlugins}" />

      <!-- 目录加载失败 (含逐包告警): Ivory 面 + crimson 文字 -->
      <Border Background="{StaticResource ClaudeIvoryBrush}" BorderBrush="{StaticResource ClaudeBorderCreamBrush}" BorderThickness="1"
              CornerRadius="{StaticResource ClaudeRadiusMd}" Padding="14" IsVisible="{Binding ShowLoadError}">
        <TextBlock Text="{Binding PluginsLoadError}" TextWrapping="Wrap"
                   Foreground="{StaticResource ClaudeErrorBrush}" FontSize="12" />
      </Border>

      <!-- 空态引导 (无用户插件时): Warm Sand 面 -->
      <Border Background="{StaticResource ClaudeSandBrush}" CornerRadius="{StaticResource ClaudeRadiusMd}" Padding="14"
              IsVisible="{Binding ShowEmptyState}">
        <StackPanel Spacing="5">
          <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2429}"
                     FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource ClaudeCharcoalWarmBrush}" />
          <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2430}"
                     TextWrapping="Wrap" Foreground="{StaticResource ClaudeOliveGrayBrush}" FontSize="12" />
        </StackPanel>
      </Border>

      <!-- 运行时说明 (诚实边界) -->
      <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2425}"
                 TextWrapping="Wrap" Foreground="{StaticResource ClaudeStoneGrayBrush}" FontSize="12" />

    </StackPanel>
  </ScrollViewer>
</UserControl>
