<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KeyFlux.Settings.ViewModels"
        xmlns:views="using:KeyFlux.Settings.Views"
        x:Class="KeyFlux.Settings.Views.MatchTypesDialogWindow"
        x:DataType="vm:MatchTypesPageViewModel"
        Title="Setting"
        Width="1000" Height="680" MinWidth="840" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource ClaudeParchmentBrush}">

  <!--
    匹配类型弹窗外壳 —— 与行为库等其余 7 个弹窗**同一套弹窗约定**:
      · 窗口: 实色 Parchment 画布 (ClaudeParchmentBrush, 不透明);
      · 构造期必须调 Services.Win32.DialogChrome.Apply(this) —— 它做两件事:
        ① 用 DWM 把系统标题栏染成暖色表面色 (否则冷白标题栏与暖色 UI 割裂);
        ② 在 Opened/Closed 上开关 owner 的 ModalBlur (即"弹窗背后的背景模糊")。
        漏调 = 标题栏冷白 + 背景不模糊 (2026-09-15 实测即此因)。
      · 系统标题栏与原生 ─ □ ✕ 保留, 不做无边框自绘 (项目既有设计决策)。
    内容 = MatchTypesPageView (顶部说明 / 主从布局 / 底部按钮栏, 与行为库同构)。
  -->

  <views:MatchTypesPageView />
</Window>
