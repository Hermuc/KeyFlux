<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KeyFlux.Settings.ViewModels"
        xmlns:services="using:KeyFlux.Settings.Services"
        x:Class="KeyFlux.Settings.Views.BehaviorEditWindow"
        TransparencyLevelHint="Blur,AcrylicBlur,Transparent,None"
        Background="{StaticResource ClaudeWindowSurfaceBrush}"
        x:Name="EditRoot"
        x:DataType="vm:BehaviorEditViewModel"
        Title="{Binding Title}"
        Width="640" Height="600"
        WindowStartupLocation="CenterOwner">

  <!-- 行为新建/编辑表单 (一期: builtin entry = 基础动作 + 默认模板 + 生效前提) -->
  <Border Padding="20">
    <Grid RowDefinitions="*,Auto">

      <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10">

          <StackPanel Spacing="4">
            <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1097}"
                       FontSize="12" Foreground="{StaticResource ClaudeOliveGrayBrush}" />
            <TextBox Text="{Binding Name}" Padding="8,5" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1087}"
                       FontSize="12" Foreground="{StaticResource ClaudeOliveGrayBrush}" />
            <TextBox Text="{Binding Id}" IsEnabled="{Binding IsNew}" Padding="8,5" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1098}"
                       FontSize="12" Foreground="{StaticResource ClaudeOliveGrayBrush}" />
            <TextBox Text="{Binding Description}" Padding="8,5" />
          </StackPanel>

          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
              <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1088}"
                         FontSize="12" Foreground="{StaticResource ClaudeOliveGrayBrush}" />
              <Button Grid.Column="1" Command="{Binding AddPremiseCommand}" Padding="8,2" CornerRadius="{StaticResource ClaudeRadiusSm}">
                <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1099}"
                           FontSize="12" />
              </Button>
            </Grid>
            <ItemsControl ItemsSource="{Binding Premises}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BehaviorPremiseRowVm">
                  <Grid ColumnDefinitions="140,*,Auto" Margin="0,3">
                    <ComboBox ItemsSource="{Binding #EditRoot.((vm:BehaviorEditViewModel)DataContext).TypeOptions}"
                              SelectedItem="{Binding SelectedType, Mode=TwoWay}"
                              Width="130" VerticalAlignment="Top" />
                    <TextBox Grid.Column="1" Text="{Binding Value}" Margin="8,0,0,0" Padding="8,5"
                             VerticalAlignment="Top" />
                    <Button Grid.Column="2" Command="{Binding #EditRoot.((vm:BehaviorEditViewModel)DataContext).RemovePremiseCommand}"
                            CommandParameter="{Binding}" Content="×" Width="28" Margin="8,0,0,0"
                            Background="Transparent" VerticalAlignment="Top" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1089}"
                       FontSize="12" Foreground="{StaticResource ClaudeOliveGrayBrush}" />
            <ComboBox ItemsSource="{Binding BaseActionOptions}"
                      SelectedItem="{Binding SelectedBaseAction, Mode=TwoWay}"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="services:ComboOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1090}"
                       FontSize="12" Foreground="{StaticResource ClaudeOliveGrayBrush}" />
            <TextBox Text="{Binding ActionValue}" Padding="8,5" AcceptsReturn="True" MinHeight="48" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1091}"
                       FontSize="12" Foreground="{StaticResource ClaudeOliveGrayBrush}" />
            <TextBox Text="{Binding WorkingDir}" Padding="8,5" />
          </StackPanel>

        </StackPanel>
      </ScrollViewer>

      <StackPanel Grid.Row="1" Margin="0,14,0,0">
        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource ClaudeErrorBrush}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
          <Button Click="OnCancelClick" Padding="12,6" CornerRadius="{StaticResource ClaudeRadiusMd}">
            <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=611}" />
          </Button>
          <Button Click="OnSaveClick" Background="{StaticResource ClaudeTerracottaBrush}" Foreground="{StaticResource ClaudeIvoryBrush}" Padding="16,6" CornerRadius="{StaticResource ClaudeRadiusMd}">
            <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=610}" />
          </Button>
        </StackPanel>
      </StackPanel>

    </Grid>
  </Border>
</Window>
