<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KeyFlux.Settings.Views.OverviewEditWindow"
        TransparencyLevelHint="Blur,AcrylicBlur,Transparent,None"
        Background="{StaticResource ClaudeWindowSurfaceBrush}"
        Title="Setting"
        Width="780" Height="600"
        MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI, Segoe UI, Segoe UI Emoji">

  <!-- 总览页编辑窗口: 编辑 markdown 原文 (纯文本, 支持 # 标题 / 列表 / [链接] / ![图片] / `代码`) -->
  <DockPanel Margin="20">
    <TextBlock x:Name="TipText" DockPanel.Dock="Top" Text="2405-TIP"
               Foreground="{StaticResource ClaudeStoneGrayBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10"
                HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="RestoreButton" Content="2404-RESTORE" Click="OnRestoreClick"
              Background="{StaticResource ClaudeIvoryBrush}" CornerRadius="{StaticResource ClaudeRadiusMd}" Padding="18,7" />
      <Button x:Name="CancelButton" Content="970-CANCEL" Click="OnCancelClick"
              Background="{StaticResource ClaudeIvoryBrush}" CornerRadius="{StaticResource ClaudeRadiusMd}" Padding="18,7" />
      <Button x:Name="SaveButton" Content="928-SAVE" Click="OnSaveClick"
              Background="{StaticResource ClaudeTerracottaBrush}" Foreground="{StaticResource ClaudeIvoryBrush}" CornerRadius="{StaticResource ClaudeRadiusMd}" Padding="18,7" />
    </StackPanel>

    <!-- 编辑态 emoji 彩色: Consolas 首位保持原字体度量, emoji 逐字符回退命中内嵌
         Twemoji COLR 彩色字形 (不依赖系统字体栈) -->
    <TextBox x:Name="Editor"
             AcceptsReturn="True" TextWrapping="NoWrap"
             FontFamily="Consolas, avares://KeyFlux.Settings/Assets/Fonts/Twemoji.Mozilla.ttf#Twemoji Mozilla, Segoe UI Emoji" FontSize="13"
             Background="{StaticResource ClaudeIvoryBrush}" BorderBrush="{StaticResource ClaudeRingWarmBrush}" BorderThickness="1"
             CornerRadius="{StaticResource ClaudeRadiusSm}" Padding="10" />
  </DockPanel>

</Window>
