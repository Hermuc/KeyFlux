<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KeyFlux.Settings.Views.OverviewEditWindow"
        Title="Setting"
        Width="780" Height="600"
        MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False"
        FontFamily="avares://KeyFlux.Settings/Assets/Fonts/Twemoji.Mozilla.ttf#Twemoji Mozilla, Microsoft YaHei UI, Segoe UI, Segoe UI Emoji">

  <!-- 总览页编辑窗口: 编辑 markdown 原文 (纯文本, 支持 # 标题 / 列表 / [链接] / ![图片] / `代码`) -->
  <DockPanel Margin="20">
    <TextBlock x:Name="TipText" DockPanel.Dock="Top" Text="2405-TIP"
               Foreground="#8A8F98" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10"
                HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="RestoreButton" Content="2404-RESTORE" Click="OnRestoreClick"
              Background="White" CornerRadius="8" Padding="18,7" />
      <Button x:Name="CancelButton" Content="970-CANCEL" Click="OnCancelClick"
              Background="White" CornerRadius="8" Padding="18,7" />
      <Button x:Name="SaveButton" Content="928-SAVE" Click="OnSaveClick"
              Background="#4169E1" Foreground="White" CornerRadius="8" Padding="18,7" />
    </StackPanel>

    <!-- 编辑态 emoji 彩色: 内嵌 Twemoji COLR 字体直接命中 emoji (不依赖系统字体栈);
         正文仍由 Consolas 渲染, 字体度量不变 -->
    <TextBox x:Name="Editor"
             AcceptsReturn="True" TextWrapping="NoWrap"
             FontFamily="avares://KeyFlux.Settings/Assets/Fonts/Twemoji.Mozilla.ttf#Twemoji Mozilla, Consolas, Segoe UI Emoji" FontSize="13"
             Background="White" BorderBrush="#D5D9E0" BorderThickness="1"
             CornerRadius="6" Padding="10" />
  </DockPanel>

</Window>
