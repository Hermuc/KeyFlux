<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeyFlux.Settings.ViewModels"
             xmlns:controls="using:KeyFlux.Settings.Controls"
             x:Class="KeyFlux.Settings.Views.HomePageView"
             x:DataType="vm:HomePageViewModel">

  <!-- 总览页文字全部可选中复制: 文档块/静态文案均用 SelectableTextBlock
       (Avalonia 11.3 无 TextBlock.IsTextSelectionEnabled, SelectableTextBlock 为官方可选中文本控件,
       继承 TextBlock 全部属性; 链接为内嵌 TextBlock + Tapped 打开, 选词不误触跳转) -->
  <!--
    总览页 (复刻 Home.vue): Vue 版为 <iframe src="/config_doc.html">。
    Avalonia 无内嵌浏览器, 等价实现: 渲染 config_doc.md (config_doc.html 的源),
    保留标题层级/图片/链接; 用户自定义 (config.overviewDocMd) 时优先展示自定义内容;
    拉取失败时回退到内置快速上览引导 (信息完整性保留)。
  -->
  <Grid>

    <!-- 加载中 -->
    <StackPanel IsVisible="{Binding IsLoading}"
                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
      <ProgressBar IsIndeterminate="True" Width="200" Foreground="{StaticResource ClaudeTerracottaBrush}" />
      <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=918}"
                 Foreground="{StaticResource ClaudeStoneGrayBrush}" HorizontalAlignment="Center" />
    </StackPanel>

    <!-- config_doc.md 渲染 (标题层级/图片/链接, 复刻 Vue 版 iframe 效果) -->
    <ScrollViewer IsVisible="{Binding DocAvailable}">
      <StackPanel Margin="36,28,36,40" Spacing="4">
        <SelectableTextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=939}"
                             FontSize="22" FontWeight="Bold" Margin="0,0,0,10" />
        <ItemsControl ItemsSource="{Binding DocBlocks}" />
        <SelectableTextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=931}"
                             Foreground="{StaticResource ClaudeWarmSilverBrush}" FontSize="12" Margin="0,24,0,0" />
        <!-- 底部编辑区: 虚线分割线 + 可点击说明 (替代原右上角「编辑总览」按钮) -->
        <controls:EditZoneHint Margin="0,26,0,0"
                               Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2407}"
                               Click="OnEditOverviewClick" />
      </StackPanel>
    </ScrollViewer>

    <!-- 回退引导: 后端未提供 config_doc.html 时 -->
    <ScrollViewer IsVisible="{Binding !DocAvailable}">
      <StackPanel IsVisible="{Binding !IsLoading}" Margin="36,28" Spacing="14" MaxWidth="720">
        <SelectableTextBlock Text="KeyFlux" FontSize="22" FontWeight="Bold" />
        <SelectableTextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=932}"
                             Foreground="{StaticResource ClaudeTerracottaBrush}" FontSize="13" />
        <Border Height="1" Background="{StaticResource ClaudeBorderCreamBrush}" Margin="0,4" />
        <SelectableTextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=934}"
                             TextWrapping="Wrap" FontSize="14" />
        <SelectableTextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=935}"
                             FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0" />
        <SelectableTextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=936}"
                             TextWrapping="Wrap" />
        <SelectableTextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=937}"
                             TextWrapping="Wrap" />
        <SelectableTextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=938}"
                             TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

  </Grid>

</UserControl>
