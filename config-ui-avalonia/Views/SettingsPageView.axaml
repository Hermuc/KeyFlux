<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeyFlux.Settings.ViewModels"
             xmlns:controls="using:KeyFlux.Settings.Controls"
             xmlns:models="using:KeyFlux.Settings.Models"
             x:Class="KeyFlux.Settings.Views.SettingsPageView"
             x:Name="Root"
             x:DataType="vm:SettingsPageViewModel">

  <UserControl.Resources>
    <!-- 右列卡片阴影走效果管线 (DropShadowDirectionEffect, 四边均匀):
         Border 的 BoxShadow 在 Viewbox 渲染变换下左右竖段不可靠 (两轮实证) -->
    <DropShadowDirectionEffect x:Key="CardShadowRest" BlurRadius="12" Direction="0" ShadowDepth="4"
                               Opacity="0.10" Color="#000000" />
    <DropShadowDirectionEffect x:Key="CardShadowStrong" BlurRadius="16" Direction="0" ShadowDepth="4"
                               Opacity="0.18" Color="#000000" />
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- 分区标题按钮: 无底色、整行可点 -->
    <Style Selector="Button.sectionHeader">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <!-- 右列组件框: 插件卡同款三态 (静态柔影 / 悬停灰描边+强影 / 单击聚焦橙描边+强影)。
         描边 = 实体 BorderThickness 2 换色 (用户确认过此机制侧边可见);
         阴影 = DropShadowDirectionEffect (BoxShadow 环在 Viewbox 变换下竖段不可靠, 勿用) -->
    <Style Selector="Border.settingsCard">
      <Setter Property="Effect" Value="{StaticResource CardShadowRest}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{StaticResource ClaudeBorderCreamBrush}" />
    </Style>
    <Style Selector="Border.settingsCard:pointerover">
      <Setter Property="Effect" Value="{StaticResource CardShadowStrong}" />
      <Setter Property="BorderBrush" Value="#c9c7bd" />
    </Style>
    <Style Selector="Border.settingsCard:focus-within">
      <Setter Property="Effect" Value="{StaticResource CardShadowStrong}" />
      <Setter Property="BorderBrush" Value="{StaticResource ClaudeCoralBrush}" />
    </Style>
    <!-- 分区标题按钮: 压制 Fluent 模板部件基态/悬停/按下的自带灰底 (坑13/18) ——
         悬停反馈交给所在 settingsCard, 按钮自身零视觉 -->
    <Style Selector="Button.sectionHeader /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.sectionHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.sectionHeader:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- 紧凑开关 (表格行内的启用开关) -->
    <Style Selector="ToggleSwitch.rowSwitch">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="OnContent" Value="{x:Null}" />
      <Setter Property="OffContent" Value="{x:Null}" />
    </Style>
  </UserControl.Styles>

  <!-- 整页内容包 Viewbox Uniform 等比缩放 (2026-09-12 重构: 移除外层 ScrollViewer):
       Viewbox 直接以页面真实尺寸为可用空间 (宽高均有界), Uniform 等比缩放适配 ——
       页面永不滚动, 顶缘边界固定 (修复: 上限随滚轮变化/两列未真正独立);
       缩放仍由可用宽度驱动 (默认内容区 936 / 测量宽 932 -> ≈1.0; MaxWidth=988 封顶 ≈1.06);
       更矮的窗口: 整页等比缩小 (纵向也参与适配), 两列各自内部滚动, 互不影响 -->
  <Viewbox Stretch="Uniform" MaxWidth="1060" HorizontalAlignment="Left" VerticalAlignment="Top">
    <Grid ColumnDefinitions="500,*" Margin="24,20,24,28">

      <!-- ===================== 左列: 快捷键方案 (label:915, 复刻 Settings.vue 表格) ===================== -->
      <Border Grid.Column="0" Background="{StaticResource ClaudeIvoryBrush}" CornerRadius="{StaticResource ClaudeRadiusLg}" Padding="16"
              Height="560" VerticalAlignment="Top" Margin="0,0,16,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top"
                     Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=915}"
                     FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

          <!-- 底部: 新增一个 (label:405) -->
          <Button DockPanel.Dock="Bottom" Command="{Binding AddKeymapCommand}"
                  Background="Transparent" BorderBrush="{StaticResource ClaudeTerracottaBrush}" BorderThickness="1"
                  Foreground="{StaticResource ClaudeTerracottaBrush}" Padding="8,5" CornerRadius="{StaticResource ClaudeRadiusMd}" Margin="0,10,0,0"
                  HorizontalAlignment="Left">
            <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=405}" />
          </Button>

          <!-- 表头 -->
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
            <TextBlock Width="112" Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=501}" Foreground="{StaticResource ClaudeStoneGrayBrush}" FontSize="12" />
            <TextBlock Width="112" Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=502}" Foreground="{StaticResource ClaudeStoneGrayBrush}" FontSize="12" />
            <TextBlock Width="118" Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=503}" Foreground="{StaticResource ClaudeStoneGrayBrush}" FontSize="12" />
            <TextBlock Width="60" Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=504}" Foreground="{StaticResource ClaudeStoneGrayBrush}" FontSize="12" />
          </StackPanel>

          <!-- 表行 -->
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding KeymapRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:KeymapRowViewModel">
                  <Grid ColumnDefinitions="112,112,118,60,*" Margin="0,2">
                    <!-- 名称 (失焦复刻 checkKeymapData) -->
                    <TextBox Text="{Binding Name}" LostFocus="OnRowFieldLostFocus"
                             Margin="0,0,6,0" Padding="6,4" FontSize="13" />
                    <!-- 触发键 -->
                    <TextBox Grid.Column="1" Text="{Binding Hotkey}" LostFocus="OnRowFieldLostFocus"
                             Margin="0,0,6,0" Padding="6,4" FontSize="13" />
                    <!-- 上层 (被依赖时禁用, 复刻 hasSubKeymap) -->
                    <ComboBox Grid.Column="2" ItemsSource="{Binding ParentOptions}"
                              SelectedItem="{Binding ParentSelection}"
                              IsEnabled="{Binding !HasSubKeymap}"
                              Margin="0,0,6,0" Padding="6,3" FontSize="13"
                              HorizontalAlignment="Stretch" MinWidth="0">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:Keymap">
                          <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <!-- 开关 (级联逻辑在 VM 的 ToggleKeymapEnable) -->
                    <ToggleSwitch Grid.Column="3" Classes="rowSwitch" IsChecked="{Binding Enable}"
                                  VerticalAlignment="Center" />
                    <!-- 删除 (启用中/被依赖时禁用, 复刻 disabledKeymapOption) -->
                    <Button Grid.Column="4" Content="✕"
                            IsEnabled="{Binding CanDelete}"
                            ToolTip.Tip="{Binding DeleteTip}"
                            Command="{Binding #Root.((vm:SettingsPageViewModel)DataContext).RemoveKeymapRowCommand}"
                            CommandParameter="{Binding}"
                            Background="Transparent" Foreground="{StaticResource ClaudeErrorBrush}" Padding="6,3" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- ===================== 右列: 其他设置 (label:505) ===================== -->
      <!-- Width=368 锁定测量宽 (必要): Viewbox 以 Infinity 测量子内容, * 列会塌缩为卡片自然宽
           (路径变量行 112,192,* 与卡内 176,* 的 * 列塌缩到空 TextBox 宽), 且长文本
           (键盘布局/帮助, 均已加 TextWrapping=Wrap 换行显示) 期望宽随内容变化导致缩放比例跳动;
           锁宽后测量全程有界、比例稳定。368 = 460 等比收窄 20% (2026-09-08 应用户要求),
           卡内固定列宽同步 220->176 / 140,240->112,192, 路径行 112+192+✕按钮≈32 = 336 + 卡 Padding 32 = 368 正好;
           渲染时卡片仍按 368 槽宽正常分配 * 列 -->
      <!-- 右列滚动分离 (2026-09-12 用户报: 滚轮滚右列会带动整页): 右列包进固定高 ScrollViewer,
           滚轮只滚本列; 滚动条 Hidden —— 滚轮滚动不受影响, 且不占测量宽度 (Width=368 锁定保持,
           若显示滚动条会把卡内容挤窄并推高缩放比)。
           高度 800 (用户报 560 显示范围太小)。外层整页 ScrollViewer 已移除 (晚些时候用户报
           "上限随滚轮变化"): 页面永不滚动, 本列是右列唯一滚动来源, Viewbox 宽高双向等比适配 -->
      <!-- 顶缘吸附翼 (TopFlareWings): 右列滚动期间 (Offset>1), 视口顶部左右两角各显示一片
           向外扩散的圆角翼 (水滴吸附天花板的摊开轮廓), 滚回顶部隐藏; 固定覆盖层, 不随内容滚动。
           翼与卡缘的贴合靠行为类动态定位 (用户两报间隙 + 右翼错位的根因): Viewbox 排布下
           * 列实际宽随窗口变化、内容对齐随 presenter 浮动、滚动条还让左右各差半宽 ——
           任何静态对齐必有残余误差, 只有按卡片实际渲染边界 TranslatePoint 才能稳贴。
           ★ 画布 Width=0 是零测量足迹铁律: Viewbox 以 ∞ 测量子内容, 画布任何正宽度
           (含子元素撑出的期望宽) 都会撑大 * 列自然宽 → 翼显隐翻转时缩放比跳动 =
           用户报的「滚轮滑动时右侧一整列移动」。子元素溢出 0 宽画布渲染 (Canvas 默认不裁剪),
           定位全靠行为类 Canvas.SetLeft -->
      <Grid Grid.Column="1" Height="800">
        <Canvas x:Name="PART_TopFlareWings" VerticalAlignment="Top" Height="18"
                Width="0" HorizontalAlignment="Left" IsHitTestVisible="False" IsVisible="False">
          <!-- 两翼与卡片同色 (Ivory 实色): 吸附带+两翼+卡片读作一整块连续材质。
               几何与定位解耦: 左翼竖直边在局部 x=18 (翼体向左铺开), 右翼竖直边在局部 x=0
               (翼体向右铺开), 竖直边必须落在卡片左右缘 —— 由行为类按卡缘精确定位 -->
          <Path Fill="{StaticResource ClaudeIvoryBrush}" Data="M 18,0 L 18,18 A 18,18 0 0 0 0,0 Z" />
          <Path Fill="{StaticResource ClaudeIvoryBrush}" Data="M 0,0 L 0,18 A 18,18 0 0 1 18,0 Z" />
        </Canvas>
        <!-- 呼吸距离必须用 StackPanel 的 Margin 而非 ScrollViewer 的 Padding:
             Padding 会把 ScrollContentPresenter 的裁剪边界一起内缩 (阴影照样被裁,
             用户报"左右阴影像被切断"), Margin 在裁剪边界之内留出衰减空间 -->
        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                      controls:TopFlareWings.IsEnabled="True" controls:TopFlareWings.FlareOverlay="{Binding #PART_TopFlareWings}">
          <StackPanel Spacing="12" Width="460" Margin="24,0,24,16">
        <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=505}"
                   FontSize="16" FontWeight="SemiBold" />

        <!-- 开机自启 + 隐藏矩阵 (顶部常驻开关行) -->
        <Border Classes="settingsCard" Background="{StaticResource ClaudeIvoryBrush}" CornerRadius="{StaticResource ClaudeRadiusLg}" Padding="16">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <ToggleSwitch IsChecked="{Binding Startup}" />
              <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=506}"
                         VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="14"
                        ToolTip.Tip="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=902}">
              <ToggleSwitch IsChecked="{Binding Options.HideMatrix}" />
              <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=901}"
                         VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- 🌐 切换语言 (label:781) -->
        <Border Classes="settingsCard" Background="{StaticResource ClaudeIvoryBrush}" CornerRadius="{StaticResource ClaudeRadiusLg}" Padding="16">
          <StackPanel Spacing="10">
            <Button Classes="sectionHeader" Command="{Binding ToggleSectionCommand}" CommandParameter="language">
              <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=781}"
                         FontWeight="SemiBold" />
            </Button>
            <ComboBox IsVisible="{Binding ShowLanguageOption}"
                      ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                      MinWidth="180">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LanguageOption">
                  <TextBlock Text="{Binding Title}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </Border>

        <!-- 😺 编辑程序分组 (label:601, 复刻 WindowGroupDialog.vue 入口按钮) -->
        <Border Classes="settingsCard" Background="{StaticResource ClaudeIvoryBrush}" CornerRadius="{StaticResource ClaudeRadiusLg}" Padding="16">
          <Button Classes="sectionHeader" Click="OnEditWindowGroups">
            <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=601}"
                       FontWeight="SemiBold" />
          </Button>
        </Border>

        <!-- ⌨️ 自定义热键 (label:1116, 原 Custom Hotkeys 页迁入 2026-09-08):
             展开 = 热键/功能 两列同行列表; 热键列点击聚焦即编辑 (失焦提交复刻 @change),
             功能列 (原「备注」) 点击弹 ActionEditorWindow 编辑动作; 底部新建 (label:1118) -->
        <Border Classes="settingsCard" Background="{StaticResource ClaudeIvoryBrush}" CornerRadius="{StaticResource ClaudeRadiusLg}" Padding="16"
                IsVisible="{Binding CustomHotkeys, Converter={StaticResource NotNull}}">
          <StackPanel Spacing="10">
            <Button Classes="sectionHeader" Command="{Binding ToggleSectionCommand}"
                    CommandParameter="customhotkeys">
              <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1116}"
                         FontWeight="SemiBold" />
            </Button>
            <StackPanel IsVisible="{Binding ShowCustomHotkeys}" Spacing="8">
              <Grid ColumnDefinitions="100,*,26" Margin="0,0,0,2">
                <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=404}"
                           Foreground="{StaticResource ClaudeStoneGrayBrush}" FontSize="12" />
                <TextBlock Grid.Column="1" Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1117}"
                           Foreground="{StaticResource ClaudeStoneGrayBrush}" FontSize="12" />
              </Grid>
              <ItemsControl ItemsSource="{Binding CustomHotkeys.Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CustomHotkeyRowVm">
                    <Grid ColumnDefinitions="100,*,26" Margin="0,1"
                          Background="{Binding RowBackground}">
                      <!-- 热键: 点击聚焦即选中该行, 失焦提交 (复刻 v-text-field @change) -->
                      <TextBox Text="{Binding Hotkey}" LostFocus="OnCustomHotkeyLostFocus"
                               GotFocus="OnCustomHotkeyRowFocused"
                               Watermark="{Binding #Root.((vm:SettingsPageViewModel)DataContext).LanguageTick, Converter={StaticResource Tr}, ConverterParameter=957}"
                               Padding="6,4" FontSize="13" />
                      <!-- 功能 (原备注): 点击弹出动作编辑面板窗口 -->
                      <Button Grid.Column="1" Click="OnCustomHotkeyCommentClick"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                              Background="Transparent" Padding="8,4">
                        <TextBlock Text="{Binding Comment}" TextTrimming="CharacterEllipsis"
                                   FontSize="13" />
                      </Button>
                      <!-- 删除 -->
                      <Button Grid.Column="2" Content="✕"
                              Command="{Binding #Root.((vm:SettingsPageViewModel)DataContext).CustomHotkeys.RemoveRowCommand}"
                              CommandParameter="{Binding}"
                              Background="Transparent" Foreground="{StaticResource ClaudeErrorBrush}" Padding="6,3" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Command="{Binding CustomHotkeys.AddRowCommand}"
                      HorizontalAlignment="Left" Margin="0,4,0,0"
                      Background="Transparent" BorderBrush="{StaticResource ClaudeMutedGreenBrush}" BorderThickness="1"
                      Foreground="{StaticResource ClaudeMutedGreenBrush}" Padding="12,5" CornerRadius="{StaticResource ClaudeRadiusMd}">
                <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1118}" />
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- 🖱️ 修改鼠标参数 (label:701, 含滚轮参数) -->
        <Border Classes="settingsCard" Background="{StaticResource ClaudeIvoryBrush}" CornerRadius="{StaticResource ClaudeRadiusLg}" Padding="16">
          <StackPanel Spacing="10">
            <Button Classes="sectionHeader" Command="{Binding ToggleSectionCommand}" CommandParameter="mouse">
              <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=701}"
                         FontWeight="SemiBold" />
            </Button>
            <StackPanel IsVisible="{Binding ShowMouseOption}" Spacing="8">
              <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=702}"
                         FontWeight="SemiBold" Foreground="{StaticResource ClaudeTerracottaBrush}" />
              <Grid ColumnDefinitions="176,*">
                <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=703}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding MouseOpts.Delay1}" />
              </Grid>
              <Grid ColumnDefinitions="176,*">
                <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=704}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding MouseOpts.Delay2}" />
              </Grid>
              <Grid ColumnDefinitions="176,*">
                <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=705}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding MouseOpts.FastSingle}" />
              </Grid>
              <Grid ColumnDefinitions="176,*">
                <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=706}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding MouseOpts.FastRepeat}" />
              </Grid>
              <Grid ColumnDefinitions="176,*">
                <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=707}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding MouseOpts.SlowSingle}" />
              </Grid>
              <Grid ColumnDefinitions="176,*">
                <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=708}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding MouseOpts.SlowRepeat}" />
              </Grid>
              <Grid ColumnDefinitions="176,*">
                <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=709}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding MouseOpts.TipSymbol}" />
              </Grid>
              <CheckBox IsChecked="{Binding MouseOpts.ShowTip}"
                        Content="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=710}" />
              <CheckBox IsChecked="{Binding MouseOpts.KeepMouseMode}"
                        Content="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=711}" />

              <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=712}"
                         FontWeight="SemiBold" Foreground="{StaticResource ClaudeTerracottaBrush}" Margin="0,8,0,0" />
              <Grid ColumnDefinitions="176,*">
                <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=713}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding ScrollOpts.Delay1}" />
              </Grid>
              <Grid ColumnDefinitions="176,*">
                <!-- 714 文案约 230px 超 176 列宽, 加 Wrap 换行显示防溢出 -->
                <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=714}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <TextBox Grid.Column="1" Text="{Binding ScrollOpts.Delay2}" />
              </Grid>
              <Grid ColumnDefinitions="176,*">
                <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=715}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding ScrollOpts.OnceLineCount}" />
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- ⌨️ 修改键盘布局 (label:721) -->
        <Border Classes="settingsCard" Background="{StaticResource ClaudeIvoryBrush}" CornerRadius="{StaticResource ClaudeRadiusLg}" Padding="16">
          <StackPanel Spacing="10">
            <Button Classes="sectionHeader" Command="{Binding ToggleSectionCommand}" CommandParameter="layout">
              <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=721}"
                         FontWeight="SemiBold" />
            </Button>
            <StackPanel IsVisible="{Binding ShowKeyboardLayout}" Spacing="10">
              <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=722}" Foreground="{StaticResource ClaudeStoneGrayBrush}" FontSize="12" />
              <TextBox Text="{Binding Options.KeyboardLayout}" AcceptsReturn="True" AcceptsTab="True"
                       MinHeight="180" FontFamily="Consolas,Courier New" FontSize="13"
                       TextWrapping="Wrap" /><!-- Wrap: NoWrap 时右列锁宽下只能横向滚动查看, 换行后窄卡内完整可读且测量宽被钳制稳定 -->
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{Binding ResetKeyboardLayoutCommand}" CommandParameter="0" Padding="10,5">
                  <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=723}" />
                </Button>
                <Button Command="{Binding ResetKeyboardLayoutCommand}" CommandParameter="74" Padding="10,5">
                  <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=724}" />
                </Button>
                <Button Command="{Binding ResetKeyboardLayoutCommand}" CommandParameter="104" Padding="10,5">
                  <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=725}" />
                </Button>
                <Button Command="{Binding ResetKeyboardLayoutCommand}" CommandParameter="1" Padding="10,5">
                  <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=726}" />
                </Button>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- 🕗 设置触发延时 (label:761, 默认展开) -->
        <Border Classes="settingsCard" Background="{StaticResource ClaudeIvoryBrush}" CornerRadius="{StaticResource ClaudeRadiusLg}" Padding="16">
          <StackPanel Spacing="10">
            <Button Classes="sectionHeader" Command="{Binding ToggleSectionCommand}" CommandParameter="delay">
              <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=761}"
                         FontWeight="SemiBold" />
            </Button>
            <StackPanel IsVisible="{Binding ShowKeymapDelay}" Spacing="8">
              <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=762}" Foreground="{StaticResource ClaudeStoneGrayBrush}" FontSize="12" />
              <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=763}" Foreground="{StaticResource ClaudeStoneGrayBrush}" FontSize="12" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding CustomKeymaps}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:Keymap">
                    <Grid ColumnDefinitions="176,96" Margin="0,2">
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <TextBox Grid.Column="1" Text="{Binding Delay, Converter={StaticResource IntStr}}"
                               Padding="6,4" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- ✨ 命令框皮肤 (label:741, 18 字段数据驱动) -->
        <Border Classes="settingsCard" Background="{StaticResource ClaudeIvoryBrush}" CornerRadius="{StaticResource ClaudeRadiusLg}" Padding="16">
          <StackPanel Spacing="10">
            <Button Classes="sectionHeader" Command="{Binding ToggleSectionCommand}" CommandParameter="skin">
              <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=741}"
                         FontWeight="SemiBold" />
            </Button>
            <ItemsControl IsVisible="{Binding ShowSkin}" ItemsSource="{Binding SkinFields}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SkinFieldViewModel">
                  <Grid ColumnDefinitions="220,*" Margin="0,2">
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBox Grid.Column="1" Text="{Binding Value}" Padding="6,4" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- 🪟 窗口毛玻璃 (亚克力): 开关 + 透明度滑杆
             透明度 = 0 时窗口底色为【实心】Parchment (不带 alpha), 避免叠在背后未知像素上发灰/花屏。
             改动即时生效 (窗口底色走 DynamicResource), 按 Ctrl+S 才会写入 config.json。 -->
        <Border Classes="settingsCard" Background="{StaticResource ClaudeIvoryBrush}" CornerRadius="{StaticResource ClaudeRadiusLg}" Padding="16">
          <StackPanel Spacing="10">
            <Button Classes="sectionHeader" Command="{Binding ToggleSectionCommand}" CommandParameter="acrylic">
              <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2500}"
                         FontFamily="{StaticResource ClaudeSerifFont}" FontSize="15" FontWeight="Medium" />
            </Button>
            <StackPanel IsVisible="{Binding ShowAcrylic}" Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2501}"
                         VerticalAlignment="Center" />
              <ToggleSwitch Grid.Column="1" Classes="claudeCompact" IsChecked="{Binding AcrylicEnabled}" />
            </Grid>
            <StackPanel Spacing="4" IsEnabled="{Binding AcrylicEnabled}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2502}"
                           Foreground="{StaticResource ClaudeStoneGrayBrush}" FontSize="12" />
                <TextBlock Grid.Column="1" Text="{Binding AcrylicTransparency}" FontSize="12"
                           Foreground="{StaticResource ClaudeStoneGrayBrush}" />
              </Grid>
              <Slider Minimum="0" Maximum="100" Value="{Binding AcrylicTransparency}"
                      TickFrequency="5" IsSnapToTickEnabled="True" />
            </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- 🧩 编辑路径变量 (label:907, Vue 中被注释, 按任务规格补齐) -->
        <Border Classes="settingsCard" Background="{StaticResource ClaudeIvoryBrush}" CornerRadius="{StaticResource ClaudeRadiusLg}" Padding="16">
          <StackPanel Spacing="10">
            <Button Classes="sectionHeader" Command="{Binding ToggleSectionCommand}" CommandParameter="pathvars">
              <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=907}"
                         FontWeight="SemiBold" />
            </Button>
            <StackPanel IsVisible="{Binding ShowPathVariables}" Spacing="8">
              <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=911}"
                         Foreground="{StaticResource ClaudeStoneGrayBrush}" FontSize="12" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                <TextBlock Width="112" Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=909}" Foreground="{StaticResource ClaudeStoneGrayBrush}" FontSize="12" />
                <TextBlock Width="192" Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=910}" Foreground="{StaticResource ClaudeStoneGrayBrush}" FontSize="12" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding PathVariables}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:PathVariable">
                    <Grid ColumnDefinitions="112,192,*" Margin="0,2">
                      <TextBox Text="{Binding Name}" Margin="0,0,6,0" Padding="6,4" />
                      <TextBox Grid.Column="1" Text="{Binding Value}" Padding="6,4" />
                      <Button Grid.Column="2" Content="✕"
                              Command="{Binding #Root.((vm:SettingsPageViewModel)DataContext).RemovePathVariableCommand}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="{Binding #Root.((vm:SettingsPageViewModel)DataContext).LanguageTick, Converter={StaticResource Tr}, ConverterParameter=912}"
                              Background="Transparent" Foreground="{StaticResource ClaudeErrorBrush}" Padding="6,3" Margin="6,0,0,0" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Command="{Binding AddPathVariableCommand}"
                      Background="Transparent" BorderBrush="{StaticResource ClaudeTerracottaBrush}" BorderThickness="1"
                      Foreground="{StaticResource ClaudeTerracottaBrush}" Padding="8,5" CornerRadius="{StaticResource ClaudeRadiusMd}" HorizontalAlignment="Left">
                <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=933}" />
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>

      </StackPanel>
      </ScrollViewer>
    </Grid>
    </Grid>
    </Viewbox>
</UserControl>
