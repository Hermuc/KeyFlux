<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeyFlux.Settings.ViewModels"
             xmlns:controls="using:KeyFlux.Settings.Controls"
             xmlns:services="using:KeyFlux.Settings.Services"
             xmlns:models="using:KeyFlux.Settings.Models"
             x:Class="KeyFlux.Settings.Views.SettingsPageView"
             x:Name="Root"
             x:DataType="vm:SettingsPageViewModel">

  <UserControl.Resources>
    <!-- 阴影说明 (2026-09-13 与插件页统一; 2026-09-15 进一步对齐插件页机制): 卡片阴影由
         DropShadowDirectionEffect 四周均匀环境影改为插件卡同款 BoxShadow 令牌。
         历史改用 Effect 管线的理由是「Viewbox 渲染变换下 BoxShadow 环竖段不可靠」——
         2026-09-13 在设置页真实条件 (Viewbox ≈0.9 缩小档, 软件 Skia) 下 headless 探针实证:
         偏移影与环影均渲染完整 (左 216/右 216), 当年现象应为坑 15 的列表裁剪而非 Viewbox。
         2026-09-15: 描边由「实体 BorderThickness 2 换色」改回插件页同款「环」机制
         (悬停 ClaudeShadowCardHover / 聚焦 ClaudeShadowFocusRing), 用户要求两页视觉一致。
         2026-09-17: 用户要求清除悬停灰描边 ⇒ 悬停一度改用**去环版** ClaudeShadowCardDeep
         (只加深投影、不出灰环), 与插件页同步; 聚焦环 ClaudeShadowFocusRing 保持不变。
         同日晚些二次整改「加深更明显」: Deep 由单层 10% α 换成双层 (贴边 + 抬升弥散)。
         同日三次整改「又过于明显、边缘生硬」: 减重后仍未达到预期。
         ⇒ ④ **最终裁定: 取消悬停投影加深, 保留基础阴影**; ⑤ 同日晚再要求「悬停时组件框周围
         显示一圈**光圈**(不能是纯线条)」⇒ 落地为 ClaudeShadowCardHalo 家族 (陶土色弥散层,
         无偏移 + Blur=16, 非零扩散描边), 本页 settingsCard / leftPanel 悬停 = 静止两层投影 + 光圈。
         注: 旧档 ClaudeShadowCardHover / ClaudeShadowCardDeep 因此**不再有消费方**
         (两者仍保留在皮肤契约里作为恢复路径, 见 Claude.axaml 的令牌注释)。 -->
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- 分区标题按钮: 无底色、整行可点 -->
    <Style Selector="Button.sectionHeader">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <!-- 卡片标题字号 15 (2026-09-13 用户要求再大 1 号: 12→14→15) -->
      <Setter Property="FontSize" Value="15" />
    </Style>
    <!-- 右列组件框: **以插件页 Border.pluginCard 为基准**统一描边 (2026-09-15 用户要求两页视觉一致)。
         原实现走「实体描边换色」机制 (BorderThickness 2 + 悬停换 #c9c7bd / 聚焦换 Coral),
         与插件页的「环」机制存在实测差异:
           静止  2px  vs 插件页 1px               → 粗细差一倍
           悬停  2px #c9c7bd vs 插件页 1px #d1cfc5 → 更深且更粗
           聚焦  实体橙边    vs 插件页 Coral 2px 环
         现逐项对齐 Border.pluginCard: 悬停/聚焦**只换 BoxShadow 环**, 不再改 BorderBrush
         (故 ClaudeCoralBrush/#c9c7bd 两处硬编码色随之移除)。
         2026-09-16: 用户反馈「两页描边都有点细」⇒ 静止 BorderThickness 1 -> 2,
         与插件页 Border.pluginCard 同步加粗 (两页仍逐项一致, 见 SettingsCardEffectTests 跨页断言)。
         注: 卡片虽在 ScrollViewer 内, 但右列 StackPanel 留有 24px 外边距
         (2026-09-12 由 Padding 改 Margin 修好"阴影被切断"), 环不被裁 -->
    <Style Selector="Border.settingsCard">
      <!-- 点组件框非交互区 = 选中该框: 见 SelectedActionPageView actionCard 同款注释
           (FocusManager 上溯聚焦卡片 ⇒ ComponentFocusRing 挂 .ring; Tab 不停靠) -->
      <Setter Property="Focusable" Value="True" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="BoxShadow" Value="{StaticResource ClaudeShadowCardHalo}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{StaticResource ClaudeBorderCreamBrush}" />
      <!-- 悬停光圈淡入 (120ms = 皮肤令牌 ClaudeMotion.Micro) -->
      <Setter Property="Transitions">
        <Transitions>
          <BoxShadowsTransition Property="BoxShadow" Duration="{x:Static vm:ClaudeMotion.Micro}" />
        </Transitions>
      </Setter>
    </Style>
    <!-- 悬停: **只加光圈, 不改描边, 不改投影前两层** (2026-09-17 当日五轮整改的终点)。
         历史: ① 悬停换 ClaudeShadowCardHover → 出 1px #d1cfc5 灰环; ② 换去环版
         ClaudeShadowCardDeep 只加深 → 不够明显; ③ Deep 提到双层强影 → 又过于明显、边缘生硬;
         ④ 降重后仍不满意 ⇒ 先裁定**取消加深**; ⑤ 本次用户要求「悬停时周围显示一圈**光圈**,
         不能是纯线条」⇒ 落地为 Halo 族第 3 层的陶土色弥散 (Blur=16, 无偏移, alpha 18%)。
         故此处 :pointerover 是**新增的光圈档**, 与步骤④"取消加深"不矛盾: 投影前两层与静止档
         逐位相同, 悬停新增的只有光圈; 也不会复现灰线 (光圈层 Blur>0, 非零扩散描边)。
         防回归: SettingsCardEffectTests 断言悬停阴影 == ClaudeShadowCardHaloHover, 描边仍奶油色,
         并有像素级用例证明卡下暖色光圈真的亮了。 -->
    <Style Selector="Border.settingsCard:pointerover">
      <Setter Property="BoxShadow" Value="{StaticResource ClaudeShadowCardHaloHover}" />
    </Style>
    <!-- 焦点环 (2026-09-18 起由 ComponentFocusRing 挂 .ring 类, 取代 :focus-within ——
         后者会同时点亮所有祖先卡, 无法表达「最内层唯一/子框自饰则让位」) -->
    <Style Selector="Border.settingsCard.ring">
      <Setter Property="BoxShadow" Value="{StaticResource ClaudeShadowCardHaloFocus}" />
    </Style>
    <!-- 左列「快捷键方案」大卡: 同样以插件页为基准, 与右列逐项一致 (同静止/聚焦两态;
         悬停无变化, 同上)。
         ⚠️ 这三项原先是**内联**写在 Border 元素上的 —— Avalonia 内联值优先级高于样式 Setter,
         会压掉 .ring 焦点环样式, 故必须由样式承载才可能生效。
         注意: 未改本卡外框尺寸 (Width 由 560 列 - 16 右边距决定 / Height 624),
         故整页 Viewbox 缩放比不变 -->
    <Style Selector="Border.leftPanel">
      <Setter Property="Focusable" Value="True" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="BoxShadow" Value="{StaticResource ClaudeShadowCardHalo}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{StaticResource ClaudeBorderCreamBrush}" />
      <Setter Property="Transitions">
        <Transitions>
          <BoxShadowsTransition Property="BoxShadow" Duration="{x:Static vm:ClaudeMotion.Micro}" />
        </Transitions>
      </Setter>
    </Style>
    <!-- 悬停: 与右列 settingsCard 同款「只加光圈」(逐项一致, 见 SettingsCardEffectTests 跨页断言) -->
    <Style Selector="Border.leftPanel:pointerover">
      <Setter Property="BoxShadow" Value="{StaticResource ClaudeShadowCardHaloHover}" />
    </Style>
    <Style Selector="Border.leftPanel.ring">
      <Setter Property="BoxShadow" Value="{StaticResource ClaudeShadowCardHaloFocus}" />
    </Style>
    <!-- 分区标题按钮: 压制 Fluent 模板部件基态/悬停/按下的自带灰底 (坑13/18) ——
         悬停反馈交给所在 settingsCard, 按钮自身零视觉 -->
    <Style Selector="Button.sectionHeader /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.sectionHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.sectionHeader:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- 紧凑开关 (表格行内的启用开关) -->
    <Style Selector="ToggleSwitch.rowSwitch">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="OnContent" Value="{x:Null}" />
      <Setter Property="OffContent" Value="{x:Null}" />
    </Style>

    <!-- 页内输入方框圆角统一 = ClaudeRadiusMd(8) (2026-09-13 用户报: 快捷键方案表格的
         TextBox/ComboBox 是 Fluent 默认小圆角, 与动作编辑面板 claudeInput(8) 不一致)。
         页面级裸类型样式覆盖左表 + 右列全部分区 (鼠标参数/布局/延时/皮肤/路径变量/自定义热键),
         圆角值来自同一令牌, 与 claudeInput 恒等; 模板 Border 均 TemplateBinding 绑定
         控件 CornerRadius (图2 实证), 页面内无 AutoCompleteBox 无误伤 -->
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="{StaticResource ClaudeRadiusMd}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="{StaticResource ClaudeRadiusMd}" />
    </Style>

    <!-- ===================== 动效 (2026-09-13; 2026-09-24 改分区体为"卷轴摊开") =====================
         .motion 类由 code-behind 挂载, 设环境变量 KEYFLUX_NO_MOTION=1 可整体关闭
         (默认播放; 不查系统 SPI 动画标志的裁定见 MotionPreferences):
         下面全部入场/摊开动画失配跳过, 界面保持即时刻。
         原则: 入场/悬停/按压类只动 Opacity / RenderTransform / 画刷 (渲染层属性, 零布局参与);
         **唯一例外 = 分区体摊开 (③)**: 按物理语义它必须真的占据空间, 用揭示层 MaxHeight
         0→内容自然高 做真·布局增长 (机制/兜底/Viewbox 安全边界见 Services/SectionUnroll.cs)。
         卡片级联仍刻意只做淡入、不做位移 (RenderTransform 会进变换链, 位移值会污染几何断言) -->
    <!-- ① 左列大卡: 页面挂载时随首批卡片淡入 -->
    <Style Selector="UserControl.motion Border.leftPanel">
      <Style.Animations>
        <Animation Duration="0:0:0.25" Easing="CubicEaseOut">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- ② 右列卡片入场级联: 页面每次挂载 (导航进入设置页) 播一次。右列首子元素是标题
         TextBlock (=1), 10 张卡为第 2..11 个子元素, 依次延迟 30ms 逐张浮现;
         FillMode=Backward 让延迟期保持首帧透明, 否则卡片先可见、动画起始再闪没 -->
    <Style Selector="UserControl.motion Border.settingsCard:nth-child(2)">
      <Style.Animations>
        <Animation Duration="{x:Static vm:ClaudeMotion.Enter}" Easing="CubicEaseOut" FillMode="Backward">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="UserControl.motion Border.settingsCard:nth-child(3)">
      <Style.Animations>
        <Animation Duration="{x:Static vm:ClaudeMotion.Enter}" Delay="0:0:0.03" Easing="CubicEaseOut" FillMode="Backward">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="UserControl.motion Border.settingsCard:nth-child(4)">
      <Style.Animations>
        <Animation Duration="{x:Static vm:ClaudeMotion.Enter}" Delay="0:0:0.06" Easing="CubicEaseOut" FillMode="Backward">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="UserControl.motion Border.settingsCard:nth-child(5)">
      <Style.Animations>
        <Animation Duration="{x:Static vm:ClaudeMotion.Enter}" Delay="0:0:0.09" Easing="CubicEaseOut" FillMode="Backward">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="UserControl.motion Border.settingsCard:nth-child(6)">
      <Style.Animations>
        <Animation Duration="{x:Static vm:ClaudeMotion.Enter}" Delay="0:0:0.12" Easing="CubicEaseOut" FillMode="Backward">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="UserControl.motion Border.settingsCard:nth-child(7)">
      <Style.Animations>
        <Animation Duration="{x:Static vm:ClaudeMotion.Enter}" Delay="0:0:0.15" Easing="CubicEaseOut" FillMode="Backward">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="UserControl.motion Border.settingsCard:nth-child(8)">
      <Style.Animations>
        <Animation Duration="{x:Static vm:ClaudeMotion.Enter}" Delay="0:0:0.18" Easing="CubicEaseOut" FillMode="Backward">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="UserControl.motion Border.settingsCard:nth-child(9)">
      <Style.Animations>
        <Animation Duration="{x:Static vm:ClaudeMotion.Enter}" Delay="0:0:0.21" Easing="CubicEaseOut" FillMode="Backward">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="UserControl.motion Border.settingsCard:nth-child(10)">
      <Style.Animations>
        <Animation Duration="{x:Static vm:ClaudeMotion.Enter}" Delay="0:0:0.24" Easing="CubicEaseOut" FillMode="Backward">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="UserControl.motion Border.settingsCard:nth-child(11)">
      <Style.Animations>
        <Animation Duration="{x:Static vm:ClaudeMotion.Enter}" Delay="0:0:0.27" Easing="CubicEaseOut" FillMode="Backward">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- ③ 分区体「卷轴摊开」(2026-09-24 二版, 取代一版"淡入 + 8px 上滑")。
         结构 (每张卡的分区体都由三层组成, 见各卡里的 Border.reveal 包裹):
           Border.reveal  ← 揭示层: ClipToBounds, MaxHeight 0↔内容自然高 (状态机按实测高驱动,
                            见 Services/SectionUnroll.cs); 内容被"纸张边缘"逐行露出来
             └ Grid
                 ├ StackPanel.sectionBody ← 内容: 落平微动 (位移/缩放, 见下)
                 └ Border.curl          ← 前缘卷曲光影带: 贴在被揭示边缘 (VerticalAlignment=Bottom
                                          免费跟随, 无需第二条动画追)
         时序 (令牌真源 ClaudeMotion):
           摊开 420ms SineEaseInOut  MaxHeight 0→H (90% 处即到位并保持到 100%, 见下注)
                                                      |  内容 translateY -3px → 归位 (落平)
                                                      |  卷曲带透明度 0 → .9 (28%) → .9 (82%) → 0
           卷起 300ms SineEaseInOut  MaxHeight H→0  |  内容 归位 → translateY -3px
                                                      |  卷曲带同上 (卷回去时纸边同样在卷)
         为什么两向各挂一个类 (.unroll / .rollup): XAML 的 Animation 时长写死, 而两向时长不同
         (420 / 300), 用两个类让两向各自取自己的令牌 —— 类名与状态机里的常量一一对应。
         为什么内容落平用 XAML 而不是代码: 代码构造的 Animation 只对基元属性有动画器兜底,
         RenderTransform 会抛 (实测 "No animator registered for the property RenderTransform"),
         XAML 关键帧由编译器替 setter 注册动画器 ⇒ 位移/缩放必须留在 XAML。

         ⚠ 落到"到位瞬间不闪"的两条硬约束 (2026-09-24 修):
         ① 内容落平**只做位移, 不做缩放**。缩放会改变内容的实际高度, 而揭示层是按内容自然高
            裁切的 ⇒ 动画末段会出现"内容已无更多可露、裁切边还在长"的空档, 归位那一刻补上,
            就是一次可见跳动。位移不改变高度, 且幅度 3px 被 16px 卷曲带完全盖住。
         ② 类动画与揭示动画是两个时钟, 撤类必须等满 令牌时长 + 余量 (状态机里做), 否则会把
            卷曲带的收尾淡出掐断, 表现为到位瞬间一闪。 -->
    <Style Selector="Border.reveal">
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="MaxHeight" Value="0" />
    </Style>
    <!-- 卷曲光影带: 暖陶土色渐变 (纸面被顶起处的阴影) + 1px 纸边线; 不透明无笔画时是纯色, 故用渐变 -->
    <Style Selector="Border.curl">
      <Setter Property="Height" Value="16" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="#59c96442" />
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Offset="0" Color="#00c96442" />
          <GradientStop Offset="0.55" Color="#1ac96442" />
          <GradientStop Offset="1" Color="#47c96442" />
        </LinearGradientBrush>
      </Setter>
    </Style>
    <!-- 摊开: 卷曲带淡入 → 保持 → 收尾淡出 (纸摊平后卷边消失) -->
    <Style Selector="UserControl.motion Border.reveal.unroll Border.curl">
      <Style.Animations>
        <Animation Duration="{x:Static vm:ClaudeMotion.Unroll}" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
          <KeyFrame Cue="28%"><Setter Property="Opacity" Value="0.9" /></KeyFrame>
          <KeyFrame Cue="82%"><Setter Property="Opacity" Value="0.9" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="UserControl.motion Border.reveal.unroll StackPanel.sectionBody">
      <Style.Animations>
        <Animation Duration="{x:Static vm:ClaudeMotion.Unroll}" Easing="SineEaseInOut">
          <KeyFrame Cue="0%">
            <Setter Property="RenderTransform" Value="translateY(-3px)" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="RenderTransform" Value="translateY(0px)" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- 卷起: 同一套姿态反向走 (归位 → 压平); 卷曲带同上 (纸边一直卷着, 直到收完) -->
    <Style Selector="UserControl.motion Border.reveal.rollup Border.curl">
      <Style.Animations>
        <Animation Duration="{x:Static vm:ClaudeMotion.Roll}" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
          <KeyFrame Cue="22%"><Setter Property="Opacity" Value="0.9" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="UserControl.motion Border.reveal.rollup StackPanel.sectionBody">
      <Style.Animations>
        <Animation Duration="{x:Static vm:ClaudeMotion.Roll}" Easing="SineEaseInOut">
          <KeyFrame Cue="0%">
            <Setter Property="RenderTransform" Value="translateY(0px)" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="RenderTransform" Value="translateY(-3px)" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- ④ 左列键位表行悬停底色 (扫描引导, 与侧栏导航同一 Sand 高亮语汇), 100ms 画刷过渡 -->
    <Style Selector="Border.keymapRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="{StaticResource ClaudeRadiusSm}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="{x:Static vm:ClaudeMotion.Micro}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.keymapRow:pointerover">
      <Setter Property="Background" Value="{StaticResource ClaudeSandBrush}" />
    </Style>
    <!-- ⑤ 字体校验提示条: 中性态 (提醒) 为默认值, .err 覆盖为问题态。
         为什么用两态而非一态: ".ttc 只用第一个 face" 是**可用但需知情**的提醒, 与
         "超限/格式不支持"这种**不可用**的硬错误混为一色会让用户误判严重性。 -->
    <Style Selector="Border.noticeBanner">
      <Setter Property="BorderBrush" Value="{StaticResource ClaudeBorderCreamBrush}" />
      <Setter Property="Background" Value="{DynamicResource ClaudeIvoryBrush}" />
    </Style>
    <Style Selector="Border.noticeBanner.err">
      <Setter Property="BorderBrush" Value="{StaticResource ClaudeErrorBrush}" />
      <Setter Property="Background" Value="{StaticResource ClaudeTerracottaSoftBrush}" />
    </Style>
    <Style Selector="Border.noticeBanner.err TextBlock">
      <Setter Property="Foreground" Value="{StaticResource ClaudeErrorBrush}" />
    </Style>
  </UserControl.Styles>

  <!-- 整页内容包 Viewbox Uniform 等比缩放 (2026-09-12 重构: 移除外层 ScrollViewer):
       Viewbox 直接以页面真实尺寸为可用空间 (宽高均有界), Uniform 等比缩放适配 ——
       页面永不滚动, 顶缘边界固定 (修复: 上限随滚轮变化/两列未真正独立);
       缩放仍由可用宽度驱动 (默认内容区 936 / 测量宽 932 -> ≈1.0; MaxWidth=988 封顶 ≈1.06);
       更矮的窗口: 整页等比缩小 (纵向也参与适配), 两列各自内部滚动, 互不影响 -->
  <!-- Width 由 code-behind 钳制 (ClampViewboxWidth): 下限 893 = 最小缩放 0.8 (窗口缩到
         主窗 MinWidth 1210 后恒 893, 快捷键方案卡不再缩小); 上限 1120 = 默认窗口缩放 1.0。
         Viewbox 自身的 MinWidth 不参与其缩放计算 (实测无效), 勿改回 -->
  <Viewbox Stretch="Uniform" MaxWidth="1120" HorizontalAlignment="Left" VerticalAlignment="Top">
    <Grid ColumnDefinitions="560,*" Margin="24,20,24,28">

      <!-- ===================== 左列: 快捷键方案 (label:915, 复刻 Settings.vue 表格) ===================== -->
      <!-- UseLayoutRounding: 本卡在 Viewbox(≈0.99)×LayoutTransform(1.12)×DPI(1.25) 复合缩放下,
           1px 逻辑描边横跨 1.386 设备像素, 列宽固定使右缘相位恒定 → 右边框覆盖率 ~50% 渲染成
           半透明细线, 用户报「第一列方框右边缘被切割」。像素对齐后描边落在整数设备像素上恒清晰。
           只挂本卡不挂整页 (页级取整有破坏右缘像素对齐的风险) -->
      <Border Grid.Column="0" Classes="leftPanel" UseLayoutRounding="True" Background="{DynamicResource ClaudeIvoryBrush}" CornerRadius="{StaticResource ClaudeRadiusCard}" Padding="16"
              Height="624" VerticalAlignment="Top" Margin="0,0,16,0">
        <!-- LayoutTransform 等比放大卡内全部内容 (字号/输入框/开关随框一起变大):
             1.12 = 加宽后内容区 528 / 原内容区 468; 卡高 624 = 528x1.12 + Padding 32 -->
        <LayoutTransformControl>
          <LayoutTransformControl.LayoutTransform>
            <ScaleTransform ScaleX="1.12" ScaleY="1.12" />
          </LayoutTransformControl.LayoutTransform>
        <DockPanel>
          <TextBlock DockPanel.Dock="Top"
                     Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=915}"
                     FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

          <!-- 底部: 新增一个 (label:405) -->
          <Button DockPanel.Dock="Bottom" Command="{Binding AddKeymapCommand}"
                  Background="Transparent" BorderBrush="{StaticResource ClaudeTerracottaBrush}" BorderThickness="1"
                  Foreground="{StaticResource ClaudeTerracottaBrush}" Padding="8,5" CornerRadius="{StaticResource ClaudeRadiusMd}" Margin="0,10,0,0"
                  HorizontalAlignment="Left">
            <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=405}" />
          </Button>

          <!-- 表头 -->
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
            <TextBlock Width="124" Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=501}" Foreground="{StaticResource ClaudeStoneGrayBrush}" FontSize="12" />
            <TextBlock Width="120" Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=502}" Foreground="{StaticResource ClaudeStoneGrayBrush}" FontSize="12" />
            <TextBlock Width="128" Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=503}" Foreground="{StaticResource ClaudeStoneGrayBrush}" FontSize="12" />
            <TextBlock Width="52" Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=504}" Foreground="{StaticResource ClaudeStoneGrayBrush}" FontSize="12" />
          </StackPanel>

          <!-- 表行 -->
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding KeymapRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:KeymapRowViewModel">
                  <!-- 行体包 Border: 悬停 Sand 底 (keymapRow 样式), 行距 Margin 从 Grid 移到 Border -->
                  <Border Classes="keymapRow" Margin="0,2">
                    <Grid ColumnDefinitions="124,120,128,52,*">
                    <!-- 名称 (失焦复刻 checkKeymapData) -->
                    <TextBox Text="{Binding Name}" LostFocus="OnRowFieldLostFocus"
                             Margin="0,0,6,0" Padding="6,4" FontSize="13" />
                    <!-- 触发键 -->
                    <TextBox Grid.Column="1" Text="{Binding Hotkey}" LostFocus="OnRowFieldLostFocus"
                             Margin="0,0,6,0" Padding="6,4" FontSize="13" />
                    <!-- 上层 (被依赖时禁用, 复刻 hasSubKeymap) -->
                    <ComboBox Grid.Column="2" ItemsSource="{Binding ParentOptions}"
                              SelectedItem="{Binding ParentSelection}"
                              IsEnabled="{Binding !HasSubKeymap}"
                              Margin="0,0,6,0" Padding="6,3" FontSize="13"
                              HorizontalAlignment="Stretch" MinWidth="0">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:Keymap">
                          <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <!-- 开关 (级联逻辑在 VM 的 ToggleKeymapEnable) -->
                    <ToggleSwitch Grid.Column="3" Classes="rowSwitch" IsChecked="{Binding Enable}"
                                  VerticalAlignment="Center" />
                    <!-- 删除 (启用中/被依赖时禁用, 复刻 disabledKeymapOption): 背退格键形按钮 -->
                    <Button Grid.Column="4" Theme="{StaticResource DeleteKey}"
                              IsEnabled="{Binding CanDelete}"
                              ToolTip.Tip="{Binding DeleteTip}"
                              Command="{Binding #Root.((vm:SettingsPageViewModel)DataContext).RemoveKeymapRowCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
        </LayoutTransformControl>
      </Border>

      <!-- ===================== 右列: 其他设置 (label:505) ===================== -->
      <!-- Width=368 锁定测量宽 (必要): Viewbox 以 Infinity 测量子内容, * 列会塌缩为卡片自然宽
           (路径变量行 112,192,* 与卡内 176,* 的 * 列塌缩到空 TextBox 宽), 且长文本
           (键盘布局/帮助, 均已加 TextWrapping=Wrap 换行显示) 期望宽随内容变化导致缩放比例跳动;
           锁宽后测量全程有界、比例稳定。368 = 460 等比收窄 20% (2026-09-08 应用户要求),
           卡内固定列宽同步 220->176 / 140,240->112,192, 路径行 112+192+✕按钮≈32 = 336 + 卡 Padding 32 = 368 正好;
           渲染时卡片仍按 368 槽宽正常分配 * 列 -->
      <!-- 右列滚动分离 (2026-09-12 用户报: 滚轮滚右列会带动整页): 右列包进固定高 ScrollViewer,
           滚轮只滚本列; 滚动条 Hidden —— 滚轮滚动不受影响, 且不占测量宽度 (Width=368 锁定保持,
           若显示滚动条会把卡内容挤窄并推高缩放比)。
           高度 800 (用户报 560 显示范围太小)。外层整页 ScrollViewer 已移除 (晚些时候用户报
           "上限随滚轮变化"): 页面永不滚动, 本列是右列唯一滚动来源, Viewbox 宽高双向等比适配 -->
      <!-- 顶缘吸附翼 (TopFlareWings) 已移除 (2026-09-22 用户要求删去): 右列滚动时
           视口顶部两角的圆角翼装饰整体摘除 —— Canvas 覆盖层 / TopFlareWings 附加
           行为类 / 对应对齐测试一并删除, 历史见 git log。 -->
      <Grid Grid.Column="1" Height="800">
        <!-- 呼吸距离必须用 StackPanel 的 Margin 而非 ScrollViewer 的 Padding:
             Padding 会把 ScrollContentPresenter 的裁剪边界一起内缩 (阴影照样被裁,
             用户报"左右阴影像被切断"), Margin 在裁剪边界之内留出衰减空间;
             底部 24 = 下坠影尾部 (offset 6 + blur 18 ≈ 24) 的衰减空间 -->
        <ScrollViewer VerticalScrollBarVisibility="Hidden">
          <StackPanel Spacing="16" Width="460" Margin="24,0,24,24">
        <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=505}"
                   FontSize="16" FontWeight="SemiBold" />

        <!-- 开机自启 + 隐藏矩阵 (顶部常驻开关行) -->
        <Border Classes="settingsCard" PointerPressed="OnCardPointerPressed" Background="{DynamicResource ClaudeIvoryBrush}" CornerRadius="{StaticResource ClaudeRadiusCard}" Padding="16">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <ToggleSwitch IsChecked="{Binding Startup}" />
              <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=506}"
                         VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="14"
                        ToolTip.Tip="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=902}">
              <ToggleSwitch IsChecked="{Binding Options.HideMatrix}" />
              <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=901}"
                         VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- 🌐 切换语言 (label:781) -->
        <Border Classes="settingsCard" PointerPressed="OnCardPointerPressed" Background="{DynamicResource ClaudeIvoryBrush}" CornerRadius="{StaticResource ClaudeRadiusCard}" Padding="16">
          <StackPanel Spacing="10">
            <Button Classes="sectionHeader" Command="{Binding ToggleSectionCommand}" CommandParameter="language">
              <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=781}"
                         FontWeight="SemiBold" />
            </Button>
            <Border Classes="reveal" services:SectionUnroll.IsOpen="{Binding ShowLanguageOption}">
              <Grid>
                <StackPanel Classes="sectionBody">
                  <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                            MinWidth="180">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:LanguageOption">
                        <TextBlock Text="{Binding Title}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <Border Classes="curl" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <!-- 😺 编辑程序分组 (label:601, 复刻 WindowGroupDialog.vue 入口按钮) -->
        <Border Classes="settingsCard" PointerPressed="OnCardPointerPressed" Background="{DynamicResource ClaudeIvoryBrush}" CornerRadius="{StaticResource ClaudeRadiusCard}" Padding="16">
          <Button Classes="sectionHeader" Click="OnEditWindowGroups">
            <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=601}"
                       FontWeight="SemiBold" />
          </Button>
        </Border>

        <!-- ⌨️ 自定义热键 (label:1116, 原 Custom Hotkeys 页迁入 2026-09-08):
             展开 = 热键/功能 两列同行列表; 热键列点击聚焦即编辑 (失焦提交复刻 @change),
             功能列 (原「备注」) 点击弹 ActionEditorWindow 编辑动作; 底部新建 (label:1118) -->
        <Border Classes="settingsCard" PointerPressed="OnCardPointerPressed" Background="{DynamicResource ClaudeIvoryBrush}" CornerRadius="{StaticResource ClaudeRadiusCard}" Padding="16"
                IsVisible="{Binding CustomHotkeys, Converter={StaticResource NotNull}}">
          <StackPanel Spacing="10">
            <Button Classes="sectionHeader" Command="{Binding ToggleSectionCommand}"
                    CommandParameter="customhotkeys">
              <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1116}"
                         FontWeight="SemiBold" />
            </Button>
            <Border Classes="reveal" services:SectionUnroll.IsOpen="{Binding ShowCustomHotkeys}">
              <Grid>
                <StackPanel Classes="sectionBody" Spacing="8">
                  <Grid ColumnDefinitions="100,*,26" Margin="0,0,0,2">
                    <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=404}"
                               Foreground="{StaticResource ClaudeStoneGrayBrush}" FontSize="12" />
                    <TextBlock Grid.Column="1" Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1117}"
                               Foreground="{StaticResource ClaudeStoneGrayBrush}" FontSize="12" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding CustomHotkeys.Rows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CustomHotkeyRowVm">
                        <Grid ColumnDefinitions="100,*,26" Margin="0,1"
                              Background="{Binding RowBackground}">
                          <!-- 热键: 点击聚焦即选中该行, 失焦提交 (复刻 v-text-field @change) -->
                          <TextBox Text="{Binding Hotkey}" LostFocus="OnCustomHotkeyLostFocus"
                                   GotFocus="OnCustomHotkeyRowFocused"
                                   Watermark="{Binding #Root.((vm:SettingsPageViewModel)DataContext).LanguageTick, Converter={StaticResource Tr}, ConverterParameter=957}"
                                   Padding="6,4" FontSize="13" />
                          <!-- 功能 (原备注): 点击弹出动作编辑面板窗口 -->
                          <Button Grid.Column="1" Click="OnCustomHotkeyCommentClick"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                  Background="Transparent" Padding="8,4">
                            <TextBlock Text="{Binding Comment}" TextTrimming="CharacterEllipsis"
                                       FontSize="13" />
                          </Button>
                          <!-- 删除: 背退格键形按钮 -->
                          <Button Grid.Column="2" Theme="{StaticResource DeleteKey}"
                                  Command="{Binding #Root.((vm:SettingsPageViewModel)DataContext).CustomHotkeys.RemoveRowCommand}"
                                  CommandParameter="{Binding}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Command="{Binding CustomHotkeys.AddRowCommand}"
                          HorizontalAlignment="Left" Margin="0,4,0,0"
                          Background="Transparent" BorderBrush="{StaticResource ClaudeMutedGreenBrush}" BorderThickness="1"
                          Foreground="{StaticResource ClaudeMutedGreenBrush}" Padding="12,5" CornerRadius="{StaticResource ClaudeRadiusMd}">
                    <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1118}" />
                  </Button>
                </StackPanel>
                <Border Classes="curl" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <!-- 🖱️ 修改鼠标参数 (label:701, 含滚轮参数) -->
        <Border Classes="settingsCard" PointerPressed="OnCardPointerPressed" Background="{DynamicResource ClaudeIvoryBrush}" CornerRadius="{StaticResource ClaudeRadiusCard}" Padding="16">
          <StackPanel Spacing="10">
            <Button Classes="sectionHeader" Command="{Binding ToggleSectionCommand}" CommandParameter="mouse">
              <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=701}"
                         FontWeight="SemiBold" />
            </Button>
            <Border Classes="reveal" services:SectionUnroll.IsOpen="{Binding ShowMouseOption}">
              <Grid>
                <StackPanel Classes="sectionBody" Spacing="8">
                  <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=702}"
                             FontWeight="SemiBold" Foreground="{StaticResource ClaudeTerracottaBrush}" />
                  <Grid ColumnDefinitions="176,*">
                    <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=703}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding MouseOpts.Delay1}" />
                  </Grid>
                  <Grid ColumnDefinitions="176,*">
                    <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=704}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding MouseOpts.Delay2}" />
                  </Grid>
                  <Grid ColumnDefinitions="176,*">
                    <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=705}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding MouseOpts.FastSingle}" />
                  </Grid>
                  <Grid ColumnDefinitions="176,*">
                    <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=706}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding MouseOpts.FastRepeat}" />
                  </Grid>
                  <Grid ColumnDefinitions="176,*">
                    <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=707}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding MouseOpts.SlowSingle}" />
                  </Grid>
                  <Grid ColumnDefinitions="176,*">
                    <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=708}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding MouseOpts.SlowRepeat}" />
                  </Grid>
                  <Grid ColumnDefinitions="176,*">
                    <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=709}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding MouseOpts.TipSymbol}" />
                  </Grid>
                  <CheckBox IsChecked="{Binding MouseOpts.ShowTip}"
                            Content="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=710}" />
                  <CheckBox IsChecked="{Binding MouseOpts.KeepMouseMode}"
                            Content="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=711}" />

                  <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=712}"
                             FontWeight="SemiBold" Foreground="{StaticResource ClaudeTerracottaBrush}" Margin="0,8,0,0" />
                  <Grid ColumnDefinitions="176,*">
                    <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=713}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding ScrollOpts.Delay1}" />
                  </Grid>
                  <Grid ColumnDefinitions="176,*">
                    <!-- 714 文案约 230px 超 176 列宽, 加 Wrap 换行显示防溢出 -->
                    <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=714}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <TextBox Grid.Column="1" Text="{Binding ScrollOpts.Delay2}" />
                  </Grid>
                  <Grid ColumnDefinitions="176,*">
                    <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=715}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding ScrollOpts.OnceLineCount}" />
                  </Grid>
                </StackPanel>
                <Border Classes="curl" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <!-- ⌨️ 修改键盘布局 (label:721) -->
        <Border Classes="settingsCard" PointerPressed="OnCardPointerPressed" Background="{DynamicResource ClaudeIvoryBrush}" CornerRadius="{StaticResource ClaudeRadiusCard}" Padding="16">
          <StackPanel Spacing="10">
            <Button Classes="sectionHeader" Command="{Binding ToggleSectionCommand}" CommandParameter="layout">
              <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=721}"
                         FontWeight="SemiBold" />
            </Button>
            <Border Classes="reveal" services:SectionUnroll.IsOpen="{Binding ShowKeyboardLayout}">
              <Grid>
                <StackPanel Classes="sectionBody" Spacing="10">
                  <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=722}" Foreground="{StaticResource ClaudeStoneGrayBrush}" FontSize="12" />
                  <TextBox Text="{Binding Options.KeyboardLayout}" AcceptsReturn="True" AcceptsTab="True"
                           MinHeight="180" FontFamily="Consolas,Courier New" FontSize="13"
                           TextWrapping="Wrap" /><!-- Wrap: NoWrap 时右列锁宽下只能横向滚动查看, 换行后窄卡内完整可读且测量宽被钳制稳定 -->
                  <!-- WrapPanel: 窄卡放不下时换行而不是溢出卡片边框 (2026-09-23 用户报障);
                       间距改用 Margin (WrapPanel 无 Spacing 属性) -->
                  <WrapPanel>
                    <Button Command="{Binding ResetKeyboardLayoutCommand}" CommandParameter="0" Padding="10,5" Margin="0,0,8,8">
                      <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=723}" />
                    </Button>
                    <Button Command="{Binding ResetKeyboardLayoutCommand}" CommandParameter="74" Padding="10,5" Margin="0,0,8,8">
                      <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=724}" />
                    </Button>
                    <Button Command="{Binding ResetKeyboardLayoutCommand}" CommandParameter="104" Padding="10,5" Margin="0,0,8,8">
                      <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=725}" />
                    </Button>
                    <Button Command="{Binding ResetKeyboardLayoutCommand}" CommandParameter="1" Padding="10,5" Margin="0,0,8,8">
                      <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=726}" />
                    </Button>
                  </WrapPanel>
                </StackPanel>
                <Border Classes="curl" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <!-- 🕗 设置触发延时 (label:761, 默认展开) -->
        <Border Classes="settingsCard" PointerPressed="OnCardPointerPressed" Background="{DynamicResource ClaudeIvoryBrush}" CornerRadius="{StaticResource ClaudeRadiusCard}" Padding="16">
          <StackPanel Spacing="10">
            <Button Classes="sectionHeader" Command="{Binding ToggleSectionCommand}" CommandParameter="delay">
              <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=761}"
                         FontWeight="SemiBold" />
            </Button>
            <Border Classes="reveal" services:SectionUnroll.IsOpen="{Binding ShowKeymapDelay}">
              <Grid>
                <StackPanel Classes="sectionBody" Spacing="8">
                  <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=762}" Foreground="{StaticResource ClaudeStoneGrayBrush}" FontSize="12" />
                  <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=763}" Foreground="{StaticResource ClaudeStoneGrayBrush}" FontSize="12" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding CustomKeymaps}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:Keymap">
                        <Grid ColumnDefinitions="176,96" Margin="0,2">
                          <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          <TextBox Grid.Column="1" Text="{Binding Delay, Converter={StaticResource IntStr}}"
                                   Padding="6,4" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <Border Classes="curl" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <!-- ✨ 命令框皮肤 (label:741, 18 字段数据驱动) -->
        <Border Classes="settingsCard" PointerPressed="OnCardPointerPressed" Background="{DynamicResource ClaudeIvoryBrush}" CornerRadius="{StaticResource ClaudeRadiusCard}" Padding="16">
          <StackPanel Spacing="10">
            <Button Classes="sectionHeader" Command="{Binding ToggleSectionCommand}" CommandParameter="skin">
              <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=741}"
                         FontWeight="SemiBold" />
            </Button>
            <Border Classes="reveal" services:SectionUnroll.IsOpen="{Binding ShowSkin}">
              <Grid>
                <StackPanel Classes="sectionBody" Spacing="10">
                  <ItemsControl ItemsSource="{Binding SkinFields}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SkinFieldViewModel">
                        <Grid ColumnDefinitions="220,*" Margin="0,2">
                          <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          <TextBox Grid.Column="1" Text="{Binding Value}" Padding="6,4" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- ── 字体小节 (2026-09-21 由独立卡片并入本卡) ──
                       为何并入: 皮肤 18 键与字体同属「命令框外观」, 且**生效条件完全相同**
                       (exe 只在进程启动时读一次 `CommandInputSkin.txt` 与 `font/font.ttf`,
                       故两者都必须重启命令框进程才可见 —— 保存端已按此统一处理:
                       任一段变化即结束命令框进程)。分成两张卡会让用户以为生效时机不同。
                       细分隔线做视觉分组, 不做折叠 (本卡整体由 header 手风琴控制)。 -->
                  <Border Height="1" Margin="0,4"
                          Background="{StaticResource ClaudeBorderCreamBrush}" />

                  <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2503}"
                             FontWeight="SemiBold" FontSize="12"
                             Foreground="{StaticResource ClaudeStoneGrayBrush}" />

                  <!-- ── 字重档位 (置于字体文件之前: 2026-09-21 起它真实生效, 是主要的粗细控制) ──
                       exe 恒定请求 BOLD(700) 且元数据已精确匹配 ⇒ 无合成加粗, 笔画粗细 100% 由
                       落地字形决定 ⇒ 换档 = 换一个预烘焙的变体文件 (见 §3.11.1「字重档位机制」)。
                       出厂默认 = 半粗 (ConfigReadDefaults.DefaultCommandFontWeight)。 -->
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2508}"
                               VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" MinWidth="140"
                              ItemsSource="{Binding FontWeights}" SelectedItem="{Binding SelectedFontWeight}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FontWeightOption">
                          <TextBlock Text="{Binding Title}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </Grid>

                  <!-- 字体文件: 只读文本框显示当前路径 + 「选择…」弹系统文件选择器 -->
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2504}"
                               Foreground="{StaticResource ClaudeStoneGrayBrush}" FontSize="12" />
                    <Grid ColumnDefinitions="*,Auto,Auto">
                      <TextBox Text="{Binding CommandFontDisplay, Mode=OneWay}" IsReadOnly="True"
                               Padding="6,4" ToolTip.Tip="{Binding CommandFontPath}" />
                      <Button Grid.Column="1" Margin="6,0,0,0" Padding="10,5"
                              Click="OnPickCommandFont"
                              Background="Transparent" BorderBrush="{StaticResource ClaudeTerracottaBrush}"
                              BorderThickness="1" Foreground="{StaticResource ClaudeTerracottaBrush}"
                              CornerRadius="{StaticResource ClaudeRadiusMd}">
                        <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2582}" />
                      </Button>
                      <Button Grid.Column="2" Margin="6,0,0,0" Padding="10,5"
                              Command="{Binding ResetCommandFontCommand}"
                              Background="Transparent" BorderBrush="{StaticResource ClaudeBorderCreamBrush}"
                              BorderThickness="1" Foreground="{StaticResource ClaudeStoneGrayBrush}"
                              CornerRadius="{StaticResource ClaudeRadiusMd}">
                        <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2507}" />
                      </Button>
                    </Grid>

                    <!-- 即时校验提示条: 只在用户主动选择字体后出现。
                         存在意义 = 把生成端的"静默跳过"前移到选择时刻 —— 用户选中超限/不支持
                         的文件时当场看到原因, 而不是"选了没反应"。
                         Classes.err 随 CommandFontNoticeIsError 翻转 (同 sectionBody 的 Classes.open
                         写法), 错误态用暖红描边, 提醒态用中性米色。 -->
                    <Border IsVisible="{Binding HasCommandFontNotice}"
                            Classes="noticeBanner" Classes.err="{Binding CommandFontNoticeIsError}"
                            CornerRadius="{StaticResource ClaudeRadiusMd}"
                            Padding="8,6" BorderThickness="1">
                      <TextBlock Text="{Binding CommandFontNotice}" TextWrapping="Wrap" FontSize="12"
                                 Foreground="{StaticResource ClaudeStoneGrayBrush}" />
                    </Border>
                  </StackPanel>
                </StackPanel>
                <Border Classes="curl" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <!-- 🧩 编辑路径变量 (label:907, Vue 中被注释, 按任务规格补齐) -->
        <Border Classes="settingsCard" PointerPressed="OnCardPointerPressed" Background="{DynamicResource ClaudeIvoryBrush}" CornerRadius="{StaticResource ClaudeRadiusCard}" Padding="16">
          <StackPanel Spacing="10">
            <Button Classes="sectionHeader" Command="{Binding ToggleSectionCommand}" CommandParameter="pathvars">
              <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=907}"
                         FontWeight="SemiBold" />
            </Button>
            <Border Classes="reveal" services:SectionUnroll.IsOpen="{Binding ShowPathVariables}">
              <Grid>
                <StackPanel Classes="sectionBody" Spacing="8">
                  <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=911}"
                             Foreground="{StaticResource ClaudeStoneGrayBrush}" FontSize="12" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                    <TextBlock Width="112" Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=909}" Foreground="{StaticResource ClaudeStoneGrayBrush}" FontSize="12" />
                    <TextBlock Width="192" Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=910}" Foreground="{StaticResource ClaudeStoneGrayBrush}" FontSize="12" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding PathVariables}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:PathVariable">
                        <Grid ColumnDefinitions="112,192,*" Margin="0,2">
                          <TextBox Text="{Binding Name}" Margin="0,0,6,0" Padding="6,4" />
                          <TextBox Grid.Column="1" Text="{Binding Value}" Padding="6,4" />
                          <Button Grid.Column="2" Theme="{StaticResource DeleteKey}" Margin="6,0,0,0"
                                  Command="{Binding #Root.((vm:SettingsPageViewModel)DataContext).RemovePathVariableCommand}"
                                  CommandParameter="{Binding}"
                                  ToolTip.Tip="{Binding #Root.((vm:SettingsPageViewModel)DataContext).LanguageTick, Converter={StaticResource Tr}, ConverterParameter=912}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Command="{Binding AddPathVariableCommand}"
                          Background="Transparent" BorderBrush="{StaticResource ClaudeTerracottaBrush}" BorderThickness="1"
                          Foreground="{StaticResource ClaudeTerracottaBrush}" Padding="8,5" CornerRadius="{StaticResource ClaudeRadiusMd}" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=933}" />
                  </Button>
                </StackPanel>
                <Border Classes="curl" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>

      </StackPanel>
      </ScrollViewer>
    </Grid>
    </Grid>
    </Viewbox>
</UserControl>
