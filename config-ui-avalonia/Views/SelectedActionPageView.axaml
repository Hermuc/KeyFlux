<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeyFlux.Settings.ViewModels"
             xmlns:views="using:KeyFlux.Settings.Views"
        xmlns:services="using:KeyFlux.Settings.Services"
             xmlns:controls="using:KeyFlux.Settings.Controls"
             x:Class="KeyFlux.Settings.Views.SelectedActionPageView"
             x:DataType="vm:SelectedActionPageViewModel">

  <!--
    entry.options 三开关本版 UI 不呈现 (引擎未消费), 模型字段保留兼容存量数据。
    两分区共用共享行卡模板 MappingRowCard, 分区差异由行 VM 的 IsTextType 决定。
  -->


  <UserControl.Resources>
    <services:BoolToSeparatorHeightConverter x:Key="BoolToSeparatorHeight" />
    <services:PopupBackgroundConverter x:Key="PopupBg" />

    <!-- 共享行卡模板: 文本特征/文件后缀两分区共用 (Classes 样式见 UserControl.Styles) -->
    <DataTemplate x:Key="MappingRowCard" x:DataType="vm:MappingRowVm">

      <Border Classes="row-card" Classes.matched="{Binding IsMatched}"
              Background="{StaticResource ClaudeIvoryBrush}" BorderBrush="{StaticResource ClaudeBorderCreamBrush}" BorderThickness="1"
              CornerRadius="{StaticResource ClaudeRadiusLg}" Padding="12" Margin="0,0,0,8"
              Tapped="OnRowHeaderTapped">
        <StackPanel Spacing="8">
          <!-- 行头: 分区标题 (仅分区首行, 沿用原徽章色) + 条件值编辑 + 行操作 -->
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock IsVisible="{Binding IsFirstInPartition}"
                       Text="{Binding TypeBadgeText}" Foreground="{Binding TypeBadgeColorHex}"
                       FontWeight="SemiBold" FontSize="15" MinWidth="64"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
              <!-- textType: 文本特征四选一 Toggle (所见即所选; 点亮与标题同色) -->
              <StackPanel IsVisible="{Binding IsTextType}" Orientation="Horizontal" Spacing="6">
                <ToggleButton Classes="type-toggle tone-terracotta"
                              IsChecked="{Binding IsUrl, Mode=TwoWay}"
                              Checked="OnTextTypeToggleChanged" Unchecked="OnTextTypeToggleChanged"
                              Content="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1059}" />
                <ToggleButton Classes="type-toggle tone-terracotta"
                              IsChecked="{Binding IsPath, Mode=TwoWay}"
                              Checked="OnTextTypeToggleChanged" Unchecked="OnTextTypeToggleChanged"
                              Content="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1060}" />
                <ToggleButton Classes="type-toggle tone-terracotta"
                              IsChecked="{Binding IsMagnet, Mode=TwoWay}"
                              Checked="OnTextTypeToggleChanged" Unchecked="OnTextTypeToggleChanged"
                              Content="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1061}" />
                <ToggleButton Classes="type-toggle tone-terracotta"
                              IsChecked="{Binding IsPlain, Mode=TwoWay}"
                              Checked="OnTextTypeToggleChanged" Unchecked="OnTextTypeToggleChanged"
                              Content="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1062}" />
              </StackPanel>
              <!-- fileExt: 条件值 + 分组快捷填入 (再点已亮项 = 解除关联并清空) -->
              <StackPanel IsVisible="{Binding !IsTextType}" Spacing="6">
                <TextBox Text="{Binding MatchValueDisplay}"
                         Watermark="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1034}" />
                <StackPanel IsVisible="{Binding ShowFileGroupFill}" Orientation="Horizontal" Spacing="6">
                  <TextBlock FontSize="12" Foreground="{StaticResource ClaudeStoneGrayBrush}" VerticalAlignment="Center"
                             Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1006}" />
                  <ItemsControl ItemsSource="{Binding GroupToggles}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:FileGroupToggleVm">
                        <ToggleButton Classes="type-toggle tone-coral"
                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      Content="{Binding Label}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
              <TextBlock Text="{Binding MatchHint}" FontSize="11" Foreground="{StaticResource ClaudeStoneGrayBrush}"
                         TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top">
              <Button Classes="icon-btn" Command="{Binding TestRowCommand}" Content="▶"
                      ToolTip.ShowDelay="200"
                      ToolTip.Tip="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=990}" />
              <Button Classes="icon-btn danger" Command="{Binding AskRemoveCommand}" Content="✕"
                      ToolTip.ShowDelay="200"
                      ToolTip.Tip="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1108}" />
            </StackPanel>
          </Grid>

          <!-- chips 键位表 (序号即菜单数字键) -->
          <ItemsControl ItemsSource="{Binding Chips}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:EntryChipVm">
                <Border Classes="chip" BorderBrush="{Binding ColorHex}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding Index}" Foreground="{Binding ColorHex}"
                               FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Label}" Foreground="{Binding ColorHex}" FontSize="12" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- 行内手风琴编辑器 (同屏只开一个, 由页面 ExpandedRow 仲裁) -->
          <StackPanel IsVisible="{Binding IsExpanded}" Spacing="8" Margin="0,4,0,0">
            <ItemsControl ItemsSource="{Binding Editors}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EntryRowVm">
                  <Border Background="{StaticResource ClaudeIvoryBrush}" BorderBrush="{StaticResource ClaudeBorderCreamBrush}" BorderThickness="1"
                          CornerRadius="{StaticResource ClaudeRadiusMd}" Padding="10" Margin="0,0,0,6">
                    <StackPanel Spacing="8">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Background="{StaticResource ClaudeSandBrush}" CornerRadius="{StaticResource ClaudeRadiusSm}" Padding="7,2"
                                VerticalAlignment="Center">
                          <TextBlock Text="{Binding Index}" Foreground="{StaticResource ClaudeTerracottaBrush}"
                                     FontWeight="SemiBold" FontSize="13" />
                        </Border>
                        <ComboBox Grid.Column="1" Margin="10,0" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding BehaviorOptions}"
                                  SelectedItem="{Binding BehaviorSelected}" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                          <Button Classes="icon-btn" Command="{Binding MoveUpCommand}"
                                  IsEnabled="{Binding CanMoveUp}" Content="↑" />
                          <Button Classes="icon-btn" Command="{Binding MoveDownCommand}"
                                  IsEnabled="{Binding CanMoveDown}" Content="↓" />
                          <Button Classes="icon-btn danger" Command="{Binding RemoveCommand}"
                                  IsEnabled="{Binding CanRemove}" Content="✕"
                                  ToolTip.Tip="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1108}" />
                        </StackPanel>
                      </Grid>
                      <TextBlock Text="{Binding BehaviorHint}" FontSize="11" Foreground="{StaticResource ClaudeStoneGrayBrush}"
                                 TextWrapping="Wrap" />
                      <!-- 命令模板 -->
                      <StackPanel IsVisible="{Binding ShowTemplate}" Spacing="4">
                        <TextBlock FontSize="11" Foreground="{StaticResource ClaudeStoneGrayBrush}"
                                   Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1012}" />
                        <TextBox Text="{Binding ActionValue}" TextWrapping="Wrap" AcceptsReturn="False" />
                      </StackPanel>
                      <TextBlock IsVisible="{Binding IsNoValue}" FontSize="11" Foreground="{StaticResource ClaudeMutedGreenBrush}"
                                 TextWrapping="Wrap" Text="{Binding TemplateHint}" />
                      <!-- 工作目录 -->
                      <TextBox Text="{Binding WorkingDir}"
                               Watermark="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1015}" />
                      <!-- 评审 D1: Options 三开关 (1016/1017/1018) 本版不渲染, 模型字段保留前向兼容 (见文件头注记) -->
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 添加行为 (达 9 禁用 + 提示) -->
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Command="{Binding AddEntryCommand}" IsEnabled="{Binding CanAddEntry}"
                      Background="Transparent" BorderThickness="1" BorderBrush="{StaticResource ClaudeTerracottaBrush}"
                      Foreground="{StaticResource ClaudeTerracottaBrush}" CornerRadius="{StaticResource ClaudeRadiusMd}" Padding="12,5" FontSize="12"
                      Content="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1106}" />
              <TextBlock IsVisible="{Binding !CanAddEntry}" FontSize="12" Foreground="{StaticResource ClaudeTerracottaBrush}"
                         VerticalAlignment="Center"
                         Text="{Binding AddEntryHint}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- 分隔项容器压制: 无 hover/选中高亮、透明背景 (与弹层一致)、不可点击、紧凑 -->
    <Style Selector="ComboBoxItem.sep-item">
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ComboBoxItem.sep-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- 分段胶囊样式: 未选白底灰字共用; 点亮态与分区标题同色实底 (文本蓝 / 后缀橙) -->
    <Style Selector="ToggleButton.type-toggle">
      <Setter Property="Padding" Value="14,5"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{StaticResource ClaudeRingWarmBrush}"/>
      <Setter Property="Background" Value="{StaticResource ClaudeIvoryBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource ClaudeOliveGrayBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MinHeight" Value="30"/>
    </Style>
    <!-- 点亮态必须打在模板 PART_ContentPresenter 上, 只改控件属性会被 Fluent 主题覆盖 -->
    <Style Selector="ToggleButton.tone-terracotta:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ClaudeTerracottaBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource ClaudeIvoryBrush}"/>
    </Style>
    <Style Selector="ToggleButton.tone-terracotta:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ClaudeTerracottaBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource ClaudeIvoryBrush}"/>
    </Style>
    <Style Selector="ToggleButton.tone-terracotta:checked">
      <Setter Property="BorderBrush" Value="{StaticResource ClaudeTerracottaBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="ToggleButton.tone-coral:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ClaudeCoralBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource ClaudeIvoryBrush}"/>
    </Style>
    <Style Selector="ToggleButton.tone-coral:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ClaudeCoralBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource ClaudeIvoryBrush}"/>
    </Style>
    <Style Selector="ToggleButton.tone-coral:checked">
      <Setter Property="BorderBrush" Value="{StaticResource ClaudeCoralBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <!-- 映射行卡: 悬停提亮边框 / 测试命中高亮 (暖陶土底 + 陶土边) -->
    <Style Selector="Border.row-card:pointerover">
      <Setter Property="BorderBrush" Value="{StaticResource ClaudeRingWarmBrush}" />
    </Style>
    <Style Selector="Border.row-card.matched">
      <Setter Property="Background" Value="{StaticResource ClaudeSandBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource ClaudeTerracottaBrush}" />
    </Style>
    <!-- 行为胶囊 (chip): 彩色描边 + 同色文字, 徽章色由 VM 按 BaseActionOf 推导 -->
    <Style Selector="Border.chip">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource ClaudeRadiusLg}" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- 小型图标按钮 (↑ ↓ ✕ ▶): 悬停/按下/禁用都不出灰色底框 ——
         Fluent 在模板部件上设背景, 必须同样打在部件上才能压掉。 -->
    <Style Selector="Button.icon-btn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="MinWidth" Value="34" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="{StaticResource ClaudeDarkWarmBrush}" />
      <Setter Property="ToolTip.ShowDelay" Value="200" />
    </Style>
    <!-- 基态也要压掉模板部件底色: Fluent 在 PART_ContentPresenter 上设背景
         (默认是系统强调色蓝), 只改控件属性会在基态被模板值压住 ——
         这正是"▶ 按钮是蓝色方框"的根因, 与皮肤契约里记录的坑同源。 -->
    <Style Selector="Button.icon-btn /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.icon-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource ClaudeDarkWarmBrush}" />
    </Style>
    <Style Selector="Button.icon-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource ClaudeDarkWarmBrush}" />
    </Style>
    <!-- 禁用 (首行↑/末行↓): 仅箭头变灰, 无底框 -->
    <Style Selector="Button.icon-btn:disabled">
      <Setter Property="Foreground" Value="{StaticResource ClaudeWarmSilverBrush}" />
    </Style>
    <Style Selector="Button.icon-btn:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource ClaudeWarmSilverBrush}" />
    </Style>
    <!-- 删除按钮: 红色, 悬停/按下仍保持红 -->
    <Style Selector="Button.icon-btn.danger">
      <Setter Property="Foreground" Value="{StaticResource ClaudeErrorBrush}" />
    </Style>
    <Style Selector="Button.icon-btn.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource ClaudeErrorBrush}" />
    </Style>
    <Style Selector="Button.icon-btn.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource ClaudeErrorBrush}" />
    </Style>
    <!-- 黄色提示条 (StatusText / 热键卡提示): 统一底色与内距 -->
    <Style Selector="Border.hint">
      <Setter Property="Background" Value="{StaticResource ClaudeSandBrush}" />
      <Setter Property="CornerRadius" Value="{StaticResource ClaudeRadiusMd}" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
  </UserControl.Styles>

  <!-- ComboOption 隐式模板: 行为/文件分组下拉的 Item 与 SelectionBox 共用;
       弹窗类型下拉的分隔线样式在 ItemTemplate 上显式覆盖, 不受影响 -->
  <UserControl.DataTemplates>
    <DataTemplate DataType="services:ComboOption">
      <TextBlock Text="{Binding Label}" />
    </DataTemplate>
  </UserControl.DataTemplates>

  <Grid Margin="20" RowDefinitions="Auto,*">

    <!-- ===================== 顶部: 标题 + 管理行为… + 添加映射 ===================== -->
    <DockPanel Grid.Row="0" Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Click="OnManageBehaviors" Background="Transparent" BorderThickness="1"
                BorderBrush="{StaticResource ClaudeBorderCreamBrush}" CornerRadius="{StaticResource ClaudeRadiusMd}" Padding="12,7" FontSize="13"
                Content="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1083}" />
        <Button Command="{Binding OpenAddPanelCommand}"
                Background="{StaticResource ClaudeTerracottaBrush}" Foreground="{StaticResource ClaudeIvoryBrush}" CornerRadius="{StaticResource ClaudeRadiusMd}" Padding="14,7">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="＋" />
            <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1105}" />
          </StackPanel>
        </Button>
      </StackPanel>
      <TextBlock FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"
                 Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=914}" />
    </DockPanel>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="PageRoot" MaxWidth="860" HorizontalAlignment="Left" Spacing="14">

        <!-- 说明条 (单键分发语义, 复用 960) -->
        <Border Background="{StaticResource ClaudeSandBrush}" CornerRadius="{StaticResource ClaudeRadiusMd}" Padding="12,9">
          <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource ClaudeDarkWarmBrush}"
                     Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=960}" />
        </Border>

        <!-- 页内提示条 (重复映射等非阻断反馈) -->
        <Border Classes="hint" IsVisible="{Binding StatusText, Converter={StaticResource NotEmpty}}">
          <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource ClaudeTerracottaBrush}" TextWrapping="Wrap" />
        </Border>

        <!-- 主快捷键 + 启用开关 -->
        <Border Background="{StaticResource ClaudeIvoryBrush}" BorderBrush="{StaticResource ClaudeBorderCreamBrush}" BorderThickness="1"
                CornerRadius="{StaticResource ClaudeRadiusLg}" Padding="16">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock FontWeight="SemiBold" VerticalAlignment="Center"
                         Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1063}" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding Enable}"
                            OnContent="{Binding EnableLabel}" OffContent="{Binding EnableLabel}"
                            MinWidth="10" />
            </Grid>
            <controls:HotkeyCapture Hotkey="{Binding #PageRoot.((vm:SelectedActionPageViewModel)DataContext).Hotkey, Mode=TwoWay}"
                                    UsedHotkeys="{Binding #PageRoot.((vm:SelectedActionPageViewModel)DataContext).UsedHotkeys}" />
            <!-- 热键提示条 (互斥合并: 未保存 1077 优先于空热键警示 976, 文案见 VM.HotkeyHintText) -->
            <Border Classes="hint" IsVisible="{Binding HotkeyHintText, Converter={StaticResource NotEmpty}}">
              <TextBlock Text="{Binding HotkeyHintText}" FontSize="12" Foreground="{StaticResource ClaudeTerracottaBrush}" TextWrapping="Wrap" />
            </Border>
          </StackPanel>
        </Border>

        <!-- 匹配优先级说明 (组内行序 = 优先级) -->
        <TextBlock FontSize="12" Foreground="{StaticResource ClaudeStoneGrayBrush}" TextWrapping="Wrap"
                   Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=978}" />

        <!-- 空状态 -->
        <StackPanel IsVisible="{Binding !HasAnyMappings}" Spacing="8" Margin="0,20">
          <TextBlock Text="👆" FontSize="40" HorizontalAlignment="Center" />
          <TextBlock FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"
                     Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1112}" />
          <TextBlock FontSize="12" Foreground="{StaticResource ClaudeStoneGrayBrush}" HorizontalAlignment="Center"
                     Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1113}" />
        </StackPanel>

        <!-- ===================== 分区一: 文本特征 ===================== -->
        <StackPanel IsVisible="{Binding TextMappings.Count}">
          <ItemsControl ItemsSource="{Binding TextMappings}"
                        ItemTemplate="{StaticResource MappingRowCard}" />
        </StackPanel>

        <!-- ===================== 分区二: 文件后缀 ===================== -->
        <StackPanel IsVisible="{Binding FileMappings.Count}">
          <ItemsControl ItemsSource="{Binding FileMappings}"
                        ItemTemplate="{StaticResource MappingRowCard}" />
        </StackPanel>

        <!-- ===================== 底部紧凑模拟测试条 ===================== -->
        <Border Background="{StaticResource ClaudeIvoryBrush}" BorderBrush="{StaticResource ClaudeBorderCreamBrush}" BorderThickness="1"
                CornerRadius="{StaticResource ClaudeRadiusLg}" Padding="16">
          <StackPanel Spacing="8">
            <TextBlock FontWeight="SemiBold"
                       Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=987}" />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
              <TextBox Text="{Binding TestContent}" MinWidth="120"
                       Watermark="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=988}" />
              <CheckBox Grid.Column="1" IsChecked="{Binding TestIsFile}" VerticalAlignment="Center"
                        Content="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=989}" />
              <Button Grid.Column="2" Command="{Binding RunTestCommand}" Background="{StaticResource ClaudeTerracottaBrush}"
                      Foreground="{StaticResource ClaudeIvoryBrush}" CornerRadius="{StaticResource ClaudeRadiusMd}" Padding="20,9" FontSize="14"
                      VerticalAlignment="Center" ToolTip.ShowDelay="200"
                      IsEnabled="{Binding !Testing}"
                      Content="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=990}" />
            </Grid>
            <TextBlock IsVisible="{Binding TestError}" Foreground="{StaticResource ClaudeErrorBrush}" FontSize="12"
                       TextWrapping="Wrap" Text="{Binding TestError}" />
            <StackPanel IsVisible="{Binding HasResult}" Spacing="6">
              <!-- 未命中 -->
              <TextBlock IsVisible="{Binding !ResultMatched}" FontSize="12" Foreground="{StaticResource ClaudeStoneGrayBrush}"
                         Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=993}" />
              <!-- 命中: 类型 + 值 + 菜单键位 + 预览 -->
              <StackPanel IsVisible="{Binding ResultMatched}" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Background="{StaticResource ClaudeSandBrush}" CornerRadius="{StaticResource ClaudeRadiusSm}" Padding="8,3">
                    <TextBlock Text="{Binding MatchedTypeText}" Foreground="{StaticResource ClaudeTerracottaBrush}" FontSize="12" />
                  </Border>
                  <TextBlock Text="{Binding MatchedValueText}" FontSize="13" FontWeight="SemiBold"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock FontSize="12" Foreground="{StaticResource ClaudeStoneGrayBrush}" VerticalAlignment="Center"
                             Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1110}" />
                  <ItemsControl ItemsSource="{Binding MenuKeys}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:MenuKeyVm">
                        <Border Classes="chip" BorderBrush="{Binding ColorHex}">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding Key}" Foreground="{Binding ColorHex}"
                                       FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Name}" Foreground="{Binding ColorHex}" FontSize="12" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock FontSize="12" Foreground="{StaticResource ClaudeStoneGrayBrush}" VerticalAlignment="Center"
                             Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=996}" />
                  <TextBlock Text="{Binding PreviewText}" FontSize="12" TextWrapping="Wrap"
                             VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- ===================== 添加映射弹窗 (页内 overlay, 非独立窗口) ===================== -->
    <Border Grid.RowSpan="2" IsVisible="{Binding IsAddPanelOpen}" Background="{StaticResource ClaudeErrorBrush}00">
      <ContentControl Content="{Binding AddPanel}" HorizontalAlignment="Center" VerticalAlignment="Center">
        <ContentControl.DataTemplates>
          <DataTemplate x:DataType="vm:AddMappingVm">
            <Border MaxWidth="560" MinWidth="440" HorizontalAlignment="Left"
                    Background="{StaticResource ClaudeIvoryBrush}" CornerRadius="{StaticResource ClaudeRadiusLg}" Padding="20" Margin="20"
                    BoxShadow="0 8 24 rgba(0,0,0,0.25)">
              <StackPanel Spacing="12">
                <!-- 标题 + 说明 -->
                <TextBlock FontSize="17" FontWeight="SemiBold"
                           Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1105}" />
                <TextBlock FontSize="12" Foreground="{StaticResource ClaudeOliveGrayBrush}" TextWrapping="Wrap" Text="{Binding Hint}" />

                <!-- 步骤 1: 类型 (文件后缀 + 文本特征四选一) -->
                <StackPanel Spacing="4">
                  <TextBlock FontSize="12" Foreground="{StaticResource ClaudeStoneGrayBrush}"
                             Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1004}" />
                  <ComboBox MinWidth="220" ItemsSource="{Binding TypeOptions}"
                            SelectedItem="{Binding TypeSelected}"
                            DropDownOpened="OnTypeDropdownOpened">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="services:ComboOption">
                        <Grid MinHeight="{Binding IsSeparator, Converter={StaticResource BoolToSeparatorHeight}}"
                              Background="{Binding IsSeparator, Converter={StaticResource PopupBg}}">
                          <TextBlock Text="{Binding Label}" IsVisible="{Binding !IsSeparator}"
                                     Margin="10,0" VerticalAlignment="Center" />
                          <Rectangle IsVisible="{Binding IsSeparator}" Height="1" Fill="{StaticResource ClaudeErrorBrush}00"
                                     Margin="10,0" VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>

                <!-- 步骤 2: 条件值 (仅文件后缀) -->
                <StackPanel Spacing="4" IsVisible="{Binding IsFileExt}">
                  <TextBlock FontSize="12" Foreground="{StaticResource ClaudeStoneGrayBrush}"
                             Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1005}" />
                  <TextBox Text="{Binding MatchValue}" IsReadOnly="True" Focusable="False"
                           Background="{StaticResource ClaudeIvoryBrush}" />
                  <TextBlock FontSize="11" Foreground="{StaticResource ClaudeStoneGrayBrush}" TextWrapping="Wrap" Text="{Binding MatchHint}" />
                </StackPanel>

                <!-- 步骤 3: 行为勾选 (勾选顺序 = 菜单键位; 最多 9) -->
                <StackPanel Spacing="4">
                  <TextBlock FontSize="12" Foreground="{StaticResource ClaudeStoneGrayBrush}"
                             Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1011}" />
                  <ScrollViewer MaxHeight="260" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding BehaviorPicks}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BehaviorPickVm">
                          <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsEnabled}"
                                    Padding="4,3" Margin="0,0,0,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <Border Background="{StaticResource ClaudeSandBrush}" CornerRadius="{StaticResource ClaudeRadiusSm}" Padding="5,1"
                                      IsVisible="{Binding IsChecked}">
                                <TextBlock Text="{Binding Order}" Foreground="{StaticResource ClaudeTerracottaBrush}" FontSize="11"
                                           FontWeight="SemiBold" />
                              </Border>
                              <TextBlock Text="{Binding Label}" FontSize="13" />
                            </StackPanel>
                          </CheckBox>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                  <!-- 评审 D2: 链接式「管理行为…」入口, 复用视图 OnManageBehaviors
                       (打开 BehaviorLibraryWindow, 关闭后 vm.ReloadBehaviorCatalogAsync 刷新勾选列表) -->
                  <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="0,2,0,0"
                          FontSize="12" Foreground="{StaticResource ClaudeTerracottaBrush}" HorizontalAlignment="Left"
                          Click="OnManageBehaviors"
                          Content="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1083}" />
                </StackPanel>

                <!-- 底部按钮 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,4,0,0">
                  <Button Command="{Binding $parent[views:SelectedActionPageView].((vm:SelectedActionPageViewModel)DataContext).CloseAddPanelCommand}"
                          Background="{StaticResource ClaudeIvoryBrush}" BorderThickness="1" BorderBrush="{StaticResource ClaudeBorderCreamBrush}"
                          CornerRadius="{StaticResource ClaudeRadiusMd}" Padding="18,7"
                          Content="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=970}" />
                  <Button Command="{Binding ConfirmCommand}" IsEnabled="{Binding CanConfirm}"
                          Background="{StaticResource ClaudeTerracottaBrush}" Foreground="{StaticResource ClaudeIvoryBrush}" CornerRadius="{StaticResource ClaudeRadiusMd}" Padding="18,7"
                          Content="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1114}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </Border>

  </Grid>
</UserControl>
