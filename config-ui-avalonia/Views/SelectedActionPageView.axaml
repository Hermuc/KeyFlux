<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeyFlux.Settings.ViewModels"
             xmlns:views="using:KeyFlux.Settings.Views"
        xmlns:services="using:KeyFlux.Settings.Services"
             xmlns:controls="using:KeyFlux.Settings.Controls"
             x:Class="KeyFlux.Settings.Views.SelectedActionPageView"
             x:DataType="vm:SelectedActionPageViewModel">

  <!--
    聚合卡设计 (2026-09): 两张卡 = 文本特征 (textType) / 文件后缀 (fileExt)。
    卡内列出该分区全部类型 toggle (始终可见); 点亮 = 正在查看 (卡内唯一点亮);
    点 toggle 切详情; 卡右侧红 ✕ = 删除当前点亮类型的配置 (确认+立即保存)。
    未配置类型点击进入「待配置」详情态 (不落盘), 用户添加行为后才创建 mapping。
  -->

  <UserControl.Resources>
    <services:BoolToSeparatorHeightConverter x:Key="BoolToSeparatorHeight" />
    <services:PopupBackgroundConverter x:Key="PopupBg" />

    <!-- 本页组件框专用投影 (2026-09-22, 用户报"只有下方有阴影"):
         原共用 ClaudeShadowCardHalo 的两层 offsetY=2/6 + blur 4/18 ⇒ 上方外扩仅 ~3px
         (且第 1 层 offsetY 2 blur 4 上方外扩为 0), 左右虽有 ~9px 却被 ContentControl
         宿主的裁剪吃掉（见卡片宿主的 ClipToBounds="False" 注释）—— 用户看到的就是"只有下方有影"。
         本页改用**四面近似等距**配方: offsetY 0/2 + blur 4/14 ⇒ 四边外扩 5~9px, 观感均匀完整。
         ⚠ 层数必须保持 3 层 (BoxShadowsAnimator 按 oldValue.Count 输出层数, 见皮肤注释)。 -->
    <BoxShadows x:Key="SelectedActionCardShadow">0 0 6 0 #1c000000, 0 2 16 0 #24000000, 0 0 16 2 #00c96442</BoxShadows>
    <BoxShadows x:Key="SelectedActionCardShadowHover">0 0 6 0 #1c000000, 0 2 16 0 #24000000, 0 0 16 2 #4dc96442</BoxShadows>
    <BoxShadows x:Key="SelectedActionCardShadowFocus">0 0 0 0 #00000000, 0 0 0 0 #00000000, 0 0 0 2 #d97757</BoxShadows>

    <!-- 类型编辑器 (卡内当前查看类型的详情; MappingRowVm) -->
    <DataTemplate x:Key="TypeEditorTemplate" x:DataType="vm:MappingRowVm">
      <!-- 外层卡片: DataContext = MappingRowVm -->
      <Border Classes="actionCard row-card"
              Background="{DynamicResource ClaudeIvoryBrush}"
              CornerRadius="{StaticResource ClaudeRadiusCard}" Padding="12" Margin="0,4,0,6">
        <StackPanel Spacing="8">
          <!-- 文件后缀: 条件值 (后缀集) 可编辑框 (恢复被 c7b80dd 删除的能力; 仅文件后缀类型显示) -->
          <TextBox IsVisible="{Binding ShowExtEditor}" Text="{Binding ExtsDisplay, Mode=TwoWay}"
                   Watermark="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1034}" />

          <!-- chips 键位表 (序号即菜单数字键) -->
          <ItemsControl ItemsSource="{Binding Chips}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:EntryChipVm">
                <Border Classes="chip" BorderBrush="{Binding ColorHex}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding Index}" Foreground="{Binding ColorHex}"
                               FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Label}" Foreground="{Binding ColorHex}" FontSize="12" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- 行为编辑行 (entry 级 ↑↓ 排序 / 删除; 多 entry 数字菜单) -->
          <ItemsControl ItemsSource="{Binding Editors}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:EntryRowVm">
                <Border Classes="actionCard rowEditor"
                        Background="{DynamicResource ClaudeIvoryBrush}"
                        CornerRadius="{StaticResource ClaudeRadiusPanel}" Padding="10" Margin="0,0,0,6">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Background="{StaticResource ClaudeSandBrush}" CornerRadius="{StaticResource ClaudeRadiusSm}" Padding="7,2"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding Index}" Foreground="{DynamicResource ClaudeTerracottaBrush}"
                                   FontWeight="SemiBold" FontSize="13" />
                      </Border>
                      <ComboBox Grid.Column="1" Margin="10,0" HorizontalAlignment="Stretch"
                                ItemsSource="{Binding BehaviorOptions}"
                                SelectedItem="{Binding BehaviorSelected}" />
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                        <Button Classes="icon-btn" Command="{Binding MoveUpCommand}"
                                IsEnabled="{Binding CanMoveUp}" Content="↑" />
                        <Button Classes="icon-btn" Command="{Binding MoveDownCommand}"
                                IsEnabled="{Binding CanMoveDown}" Content="↓" />
                        <Button Theme="{StaticResource DeleteKey}" Command="{Binding RemoveCommand}"
                                IsEnabled="{Binding CanRemove}"
                                ToolTip.Tip="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1108}" />
                      </StackPanel>
                    </Grid>
                    <StackPanel IsVisible="{Binding ShowTemplate}" Spacing="4">
                      <TextBlock FontSize="11" Foreground="{StaticResource ClaudeStoneGrayBrush}"
                                 Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1012}" />
                      <TextBox Text="{Binding ActionValue}" TextWrapping="Wrap" AcceptsReturn="False" />
                    </StackPanel>
                    <TextBlock IsVisible="{Binding IsNoValue}" FontSize="11" Foreground="{StaticResource ClaudeMutedGreenBrush}"
                               TextWrapping="Wrap" Text="{Binding TemplateHint}" />
                    <TextBox Text="{Binding WorkingDir}"
                             Watermark="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1015}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- 添加行为 (达 9 禁用 + 提示) -->
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Command="{Binding AddEntryCommand}" IsEnabled="{Binding CanAddEntry}"
                    Background="Transparent" BorderThickness="1" BorderBrush="{StaticResource ClaudeTerracottaBrush}"
                    Foreground="{StaticResource ClaudeTerracottaBrush}" CornerRadius="{StaticResource ClaudeRadiusMd}" Padding="12,5" FontSize="12"
                    Content="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1106}" />
            <TextBlock IsVisible="{Binding !CanAddEntry}" FontSize="12" Foreground="{StaticResource ClaudeTerracottaBrush}"
                       VerticalAlignment="Center"
                       Text="{Binding AddEntryHint}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- 聚合卡 (TypeCardVm) -->
    <DataTemplate x:Key="TypeCardTemplate" x:DataType="vm:TypeCardVm">
      <Border Classes="actionCard type-card" Background="{DynamicResource ClaudeIvoryBrush}"
              CornerRadius="{StaticResource ClaudeRadiusCard}" Padding="12" Margin="0,0,0,8">
        <StackPanel Spacing="8">
          <!-- 卡头: 标题 + 右侧测试▶ / 红 ✕ (删除当前点亮类型配置) -->
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"
                       Foreground="{StaticResource ClaudeTerracottaBrush}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top">
              <Button Classes="icon-btn" Command="{Binding Detail.PlaySampleCommand}" Content="󰐊" FontFamily="{StaticResource MdiFont}" Margin="0,3,0,0" FontSize="18"
                      Background="Transparent"
                      ToolTip.ShowDelay="200"
                      ToolTip.Tip="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=990}" />
              <Button Theme="{StaticResource DeleteKey}" Command="{Binding DeleteSelectedCommand}"
                      IsEnabled="{Binding CanDeleteSelected}"
                      ToolTip.ShowDelay="200"
                      ToolTip.Tip="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1120}" />
            </StackPanel>
          </Grid>

          <!-- 全部类型 toggle (始终可见): 点亮=正在查看 (已配置微标已于 2026-09-22 移除) -->
          <ItemsControl ItemsSource="{Binding Toggles}" ClipToBounds="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TypeToggleVm">
                <!-- 2026-09-22 用户要求: 移除 toggle 右上角的「已配置」小圆点微标
                     (原 Ellipse.config-dot + 其样式一并删除; 已配置状态仍由卡片内部的
                     详情/行为列表体现, VM 侧 IsConfigured 保留为派生状态不再渲染) -->
                <ToggleButton Classes="type-toggle tone-terracotta" Margin="0,0,6,6"
                              IsChecked="{Binding IsLit, Mode=OneWay}"
                              Click="OnTypeToggleClicked"
                              Content="{Binding Label}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- 新建匹配类型入口 (复用 MatchTypesDialogAsync) -->
          <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="0,2,0,0"
                  FontSize="12" Foreground="{StaticResource ClaudeTerracottaBrush}" HorizontalAlignment="Left"
                  Command="{Binding NewTypeCommand}"
                  Content="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2553}" />

          <!-- 未配置 + 空行为: 待配置态 (不落盘) -->
          <Border IsVisible="{Binding IsPending}" Background="{StaticResource ClaudeSandBrush}"
                  CornerRadius="{StaticResource ClaudeRadiusPanel}" Padding="10,8">
            <TextBlock FontSize="12" Foreground="{StaticResource ClaudeDarkWarmBrush}" TextWrapping="Wrap"
                       Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2537}" />
          </Border>

          <!-- 当前查看类型的编辑器详情 -->
          <ContentControl Content="{Binding Detail}" ContentTemplate="{StaticResource TypeEditorTemplate}" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- 输入框和谐灰边框 (2026-09-23, 用户三轮定色): claudeInput 的奶油边 (#f0eee6) 过淡
         "跟没有边框一样", Fluent 默认边框过黑 —— 取介于 Sand(#e8e6dc) 与 StoneGray(#87867f)
         之间的暖中灰 #c8c3b4, 与 Claude 暖色 UI 和谐且清晰可辨。
         页级类型选择器: 本页全部 TextBox/ComboBox (含将来新增) 自动生效, 零逐控件配置;
         只读回显框同色 (视觉一致)。 -->
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{StaticResource ClaudeWhiteBrush}" />
      <Setter Property="BorderBrush" Value="#c8c3b4" />
      <Setter Property="CornerRadius" Value="{StaticResource ClaudeRadiusMd}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{StaticResource ClaudeWhiteBrush}" />
      <Setter Property="BorderBrush" Value="#c8c3b4" />
      <Setter Property="CornerRadius" Value="{StaticResource ClaudeRadiusMd}" />
    </Style>
    <!-- 悬停/聚焦不回黑: Fluent 主题的 pointerover/focus/dropdownopen 会直接把模板部件
         的 BorderBrush 改成深色 (优先级压过控件属性), 须用**同选择器**在页级再压回灰边。
         部件名 (headless 探针实测, 勿凭记忆): TextBox=Border#PART_BorderElement;
         ComboBox 的可见边框是**两层** Border#Background + Border#HighlightBackground
         (悬停时分别 #cc000000/#66000000), ContentPresenter#PART_ContentPresenter 并不画边。 -->
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="#c8c3b4" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="#c8c3b4" />
    </Style>
    <Style Selector="ComboBox /template/ Border#Background">
      <Setter Property="Background" Value="{StaticResource ClaudeWhiteBrush}" />
      <Setter Property="BorderBrush" Value="#c8c3b4" />
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
      <Setter Property="Background" Value="{StaticResource ClaudeWhiteBrush}" />
      <Setter Property="BorderBrush" Value="#c8c3b4" />
    </Style>
    <Style Selector="ComboBox:focus /template/ Border#Background">
      <Setter Property="Background" Value="{StaticResource ClaudeWhiteBrush}" />
      <Setter Property="BorderBrush" Value="#c8c3b4" />
    </Style>
    <Style Selector="ComboBox:dropdownopen /template/ Border#Background">
      <Setter Property="Background" Value="{StaticResource ClaudeWhiteBrush}" />
      <Setter Property="BorderBrush" Value="#c8c3b4" />
    </Style>
    <Style Selector="ComboBox:dropdownopen /template/ Border#HighlightBackground">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#c8c3b4" />
    </Style>

    <!-- 分隔项容器压制 (弹窗下拉用) -->
    <Style Selector="ComboBoxItem.sep-item">
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ComboBoxItem.sep-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- 类型 toggle: 未选白底灰字; 点亮态实底 (陶土色, 与卡标题同色) -->
    <Style Selector="ToggleButton.type-toggle">
      <Setter Property="Padding" Value="14,5"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{StaticResource ClaudeRingWarmBrush}"/>
      <Setter Property="Background" Value="{DynamicResource ClaudeIvoryBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource ClaudeOliveGrayBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MinHeight" Value="30"/>
    </Style>
    <Style Selector="ToggleButton.type-toggle:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ClaudeTerracottaBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource ClaudeIvoryBrush}"/>
    </Style>
    <Style Selector="ToggleButton.type-toggle:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ClaudeTerracottaBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource ClaudeIvoryBrush}"/>
    </Style>
    <Style Selector="ToggleButton.type-toggle:checked">
      <Setter Property="BorderBrush" Value="{StaticResource ClaudeTerracottaBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <!-- 组件框外观 (卡密集堆叠, 描边 1px 比其它处更细) -->
    <Style Selector="Border.actionCard">
      <Setter Property="BoxShadow" Value="{StaticResource SelectedActionCardShadow}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{StaticResource ClaudeBorderCreamBrush}" />
      <Setter Property="Focusable" Value="True" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Transitions">
        <Transitions>
          <BoxShadowsTransition Property="BoxShadow" Duration="{x:Static vm:ClaudeMotion.Micro}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.actionCard:pointerover">
      <Setter Property="BoxShadow" Value="{StaticResource SelectedActionCardShadowHover}" />
    </Style>
    <Style Selector="Border.actionCard.ring:not(.row-card):not(.rowEditor)">
      <Setter Property="BoxShadow" Value="{StaticResource SelectedActionCardShadowFocus}" />
    </Style>
    <!-- 行内编辑器卡去影 (嵌套面板, 双层投影显脏) -->
    <Style Selector="Border.actionCard.rowEditor">
      <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
    </Style>
    <Style Selector="Border.actionCard.rowEditor:pointerover">
      <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
    </Style>
    <!-- 卡内详情面板 (row-card) 去影 (2026-09-22 用户要求: 文本特征/文件后缀两张聚合卡
         **内部的子卡片**不要阴影) —— 与 rowEditor 同因: 嵌套在聚合卡内, 双层投影显脏;
         只保留 1px 奶油描边做分层. 悬停档同样归零, 避免悬停时突然冒影. -->
    <Style Selector="Border.actionCard.row-card">
      <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
    </Style>
    <Style Selector="Border.actionCard.row-card:pointerover">
      <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
    </Style>
    <!-- 行为胶囊 -->
    <Style Selector="Border.chip">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource ClaudeRadiusLg}" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- 小型图标按钮 (↑ ↓ ✕ ▶) -->
    <Style Selector="Button.icon-btn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="MinWidth" Value="34" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="{StaticResource ClaudeDarkWarmBrush}" />
      <Setter Property="ToolTip.ShowDelay" Value="200" />
    </Style>
    <Style Selector="Button.icon-btn /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.icon-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource ClaudeDarkWarmBrush}" />
    </Style>
    <Style Selector="Button.icon-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource ClaudeDarkWarmBrush}" />
    </Style>
    <Style Selector="Button.icon-btn:disabled">
      <Setter Property="Foreground" Value="{StaticResource ClaudeWarmSilverBrush}" />
    </Style>
    <Style Selector="Button.icon-btn:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource ClaudeWarmSilverBrush}" />
    </Style>
    <!-- 黄色提示条 -->
    <Style Selector="Border.hint">
      <Setter Property="Background" Value="{StaticResource ClaudeSandBrush}" />
      <Setter Property="CornerRadius" Value="{StaticResource ClaudeRadiusPanel}" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
  </UserControl.Styles>

  <!-- ComboOption 隐式模板 -->
  <UserControl.DataTemplates>
    <DataTemplate DataType="services:ComboOption">
      <TextBlock Text="{Binding Label}" />
    </DataTemplate>
  </UserControl.DataTemplates>

  <Grid Margin="8,20,20,20" RowDefinitions="Auto,*">
    <!-- 顶部: 标题 + 管理行为… + 管理匹配类型 + 添加映射 -->
    <DockPanel Grid.Row="0" Margin="12,0,0,12" controls:ModalBlur.IsActive="{Binding IsAddPanelOpen}">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Command="{Binding ManageMatchTypesCommand}" Background="Transparent" BorderThickness="1"
                BorderBrush="{StaticResource ClaudeBorderCreamBrush}" CornerRadius="{StaticResource ClaudeRadiusMd}" Padding="12,7" FontSize="13"
                Content="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2519}" />
        <Button Click="OnManageBehaviors" Background="Transparent" BorderThickness="1"
                BorderBrush="{StaticResource ClaudeBorderCreamBrush}" CornerRadius="{StaticResource ClaudeRadiusMd}" Padding="12,7" FontSize="13"
                Content="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1083}" />
        <Button Command="{Binding OpenAddPanelCommand}"
                Background="{StaticResource ClaudeTerracottaBrush}" Foreground="{StaticResource ClaudeIvoryBrush}" CornerRadius="{StaticResource ClaudeRadiusMd}" Padding="14,7">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="＋" />
            <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1105}" />
          </StackPanel>
        </Button>
      </StackPanel>
      <TextBlock FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"
                 Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=914}" />
    </DockPanel>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" controls:ModalBlur.IsActive="{Binding IsAddPanelOpen}">
      <StackPanel x:Name="PageRoot" MaxWidth="860" HorizontalAlignment="Left" Spacing="14"
                  Margin="12,0,0,0">

        <!-- 说明条 -->
        <Border Background="{StaticResource ClaudeSandBrush}" CornerRadius="{StaticResource ClaudeRadiusPanel}" Padding="12,9">
          <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource ClaudeDarkWarmBrush}"
                     Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=960}" />
        </Border>

        <!-- 页内提示条 -->
        <Border Classes="hint" IsVisible="{Binding StatusText, Converter={StaticResource NotEmpty}}">
          <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource ClaudeTerracottaBrush}" TextWrapping="Wrap" />
        </Border>

        <!-- 主快捷键 + 启用开关 -->
          <Border Classes="actionCard" Background="{DynamicResource ClaudeIvoryBrush}"
                  CornerRadius="{StaticResource ClaudeRadiusCard}" Padding="16">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBlock FontWeight="SemiBold" VerticalAlignment="Center"
                         Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1063}" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding Enable}" MinWidth="10"
                            OnContent="" OffContent="" />
              <TextBlock Grid.Column="2" Text="ON" FontSize="10" FontWeight="SemiBold"
                         Foreground="{StaticResource ClaudeOliveGrayBrush}" VerticalAlignment="Center"
                         Margin="4,0,0,0" IsVisible="{Binding Enable}" />
              <TextBlock Grid.Column="2" Text="OFF" FontSize="10" FontWeight="SemiBold"
                         Foreground="{StaticResource ClaudeStoneGrayBrush}" VerticalAlignment="Center"
                         Margin="4,0,0,0" IsVisible="{Binding !Enable}" />
            </Grid>
            <controls:HotkeyCapture Hotkey="{Binding #PageRoot.((vm:SelectedActionPageViewModel)DataContext).Hotkey, Mode=TwoWay}"
                                    UsedHotkeys="{Binding #PageRoot.((vm:SelectedActionPageViewModel)DataContext).UsedHotkeys}" />
            <Border Classes="hint" IsVisible="{Binding HotkeyHintText, Converter={StaticResource NotEmpty}}">
              <TextBlock Text="{Binding HotkeyHintText}" FontSize="12" Foreground="{StaticResource ClaudeTerracottaBrush}" TextWrapping="Wrap" />
            </Border>
          </StackPanel>
        </Border>

        <!-- 文本特征聚合卡 -->
        <!-- ClipToBounds=False: 卡片投影 (外扩 5~9px) 画在自身边界外, 默认裁剪会吃掉左右两侧阴影
             (2026-09-22 用户报"只有下方有阴影"); 与 PluginsPageView 同因同法。 -->
        <ContentControl Content="{Binding TextCard}" ContentTemplate="{StaticResource TypeCardTemplate}"
                       ClipToBounds="False" />

        <!-- 文件后缀聚合卡 -->
        <ContentControl Content="{Binding FileCard}" ContentTemplate="{StaticResource TypeCardTemplate}"
                       ClipToBounds="False" />

      </StackPanel>
    </ScrollViewer>

    <!-- 添加映射弹窗 (页内 overlay, 非独立窗口) -->
    <Border Grid.RowSpan="2" IsVisible="{Binding IsAddPanelOpen}" Background="Transparent">
      <ContentControl Content="{Binding AddPanel}" HorizontalAlignment="Center" VerticalAlignment="Center">
        <ContentControl.DataTemplates>
          <DataTemplate x:DataType="vm:AddMappingVm">
            <Border MaxWidth="560" MinWidth="440" HorizontalAlignment="Left"
                    Background="{DynamicResource ClaudeIvoryBrush}" CornerRadius="{StaticResource ClaudeRadiusCard}" Padding="20" Margin="20"
                    BoxShadow="0 8 24 rgba(0,0,0,0.25)">
              <StackPanel Spacing="12">
                <TextBlock FontSize="17" FontWeight="SemiBold"
                           Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1105}" />
                <TextBlock FontSize="12" Foreground="{StaticResource ClaudeOliveGrayBrush}" TextWrapping="Wrap" Text="{Binding Hint}" />

                <StackPanel Spacing="4">
                  <TextBlock FontSize="12" Foreground="{StaticResource ClaudeStoneGrayBrush}"
                             Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1004}" />
                  <ComboBox MinWidth="220" ItemsSource="{Binding TypeOptions}"
                            SelectedItem="{Binding TypeSelected}"
                            DropDownOpened="OnTypeDropdownOpened">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="services:ComboOption">
                        <Grid MinHeight="{Binding IsSeparator, Converter={StaticResource BoolToSeparatorHeight}}"
                              Background="{Binding IsSeparator, Converter={StaticResource PopupBg}}">
                          <TextBlock Text="{Binding Label}" IsVisible="{Binding !IsSeparator}"
                                     Margin="10,0" VerticalAlignment="Center" />
                          <Rectangle IsVisible="{Binding IsSeparator}" Height="1"
                                     Margin="10,0" VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Command="{Binding CreateTypeCommand}"
                          Background="Transparent" BorderThickness="0" Padding="0" Margin="0,2,0,0"
                          FontSize="12" Foreground="{StaticResource ClaudeTerracottaBrush}" HorizontalAlignment="Left"
                          Content="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2553}" />
                </StackPanel>

                <Border IsVisible="{Binding ShowStubHint}"
                        Background="{StaticResource ClaudeSandBrush}" CornerRadius="{StaticResource ClaudeRadiusPanel}" Padding="10,8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2517}"
                               FontSize="12" Foreground="{StaticResource ClaudeDarkWarmBrush}" TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <Button Click="OnCreateDedicatedBehavior"
                            Background="Transparent" BorderThickness="0" Padding="0" Margin="0"
                            FontSize="12" Foreground="{StaticResource ClaudeTerracottaBrush}" VerticalAlignment="Center"
                            Content="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2518}" />
                  </StackPanel>
                </Border>

                <StackPanel Spacing="4" IsVisible="{Binding IsFileExt}">
                  <TextBlock FontSize="12" Foreground="{StaticResource ClaudeStoneGrayBrush}"
                             Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1005}" />
                  <TextBox Text="{Binding MatchValue}" IsReadOnly="True" Focusable="False"
                           Background="{DynamicResource ClaudeIvoryBrush}" />
                </StackPanel>

                <StackPanel Spacing="4">
                  <TextBlock FontSize="12" Foreground="{StaticResource ClaudeStoneGrayBrush}"
                             Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1011}" />
                  <ScrollViewer MaxHeight="260" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding BehaviorPicks}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BehaviorPickVm">
                          <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsEnabled}"
                                    Padding="4,3" Margin="0,0,0,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <Border Background="{StaticResource ClaudeSandBrush}" CornerRadius="{StaticResource ClaudeRadiusSm}" Padding="5,1"
                                      IsVisible="{Binding IsChecked}">
                                <TextBlock Text="{Binding Order}" Foreground="{StaticResource ClaudeTerracottaBrush}" FontSize="11"
                                           FontWeight="SemiBold" />
                              </Border>
                              <TextBlock Text="{Binding Label}" FontSize="13" />
                            </StackPanel>
                          </CheckBox>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                  <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="0,2,0,0"
                          FontSize="12" Foreground="{StaticResource ClaudeTerracottaBrush}" HorizontalAlignment="Left"
                          Click="OnManageBehaviors"
                          Content="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1083}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,4,0,0">
                  <Button Command="{Binding $parent[views:SelectedActionPageView].((vm:SelectedActionPageViewModel)DataContext).CloseAddPanelCommand}"
                          Background="{DynamicResource ClaudeIvoryBrush}" BorderThickness="1" BorderBrush="{StaticResource ClaudeBorderCreamBrush}"
                          CornerRadius="{StaticResource ClaudeRadiusMd}" Padding="18,7"
                          Content="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=970}" />
                  <Button Command="{Binding ConfirmCommand}" IsEnabled="{Binding CanConfirm}"
                          Background="{StaticResource ClaudeTerracottaBrush}" Foreground="{StaticResource ClaudeIvoryBrush}" CornerRadius="{StaticResource ClaudeRadiusMd}" Padding="18,7"
                          Content="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1114}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </Border>

  </Grid>
</UserControl>
