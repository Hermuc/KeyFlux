<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KeyFlux.Settings.ViewModels"
        x:Class="KeyFlux.Settings.Views.BehaviorLibraryWindow"
        TransparencyLevelHint="Blur,AcrylicBlur,Transparent,None"
        Background="{DynamicResource ClaudeWindowSurfaceBrush}"
        x:DataType="vm:BehaviorLibraryViewModel"
        Title="Setting"
        Width="880" Height="580"
        WindowStartupLocation="CenterOwner">

  <!--
    行为库 (CONTRACTS §3.9): 内置包只读 + 用户包增删; 变更经「立即生效」显式重启。
    视觉与「匹配类型」弹窗**同构** (2026-09-15 统一):
      · 圆角层级: 容器 claudeCard = Lg(12) / 行·按钮 = Md(8) / 徽标 = Sm(6)
      · 配色: Ivory 面 · Sand 悬停 · Parchment 选中 + 陶土指示条 · Terracotta 主 CTA
      · 布局: 顶部一句话说明 → 左列表(卡) + 右详情(卡) → 底部状态栏 + 按钮栏
      · 快捷: 列表行双击 = 编辑行为 (仅自定义包), 与底部按钮同义
  -->

  <Border Padding="20">
    <Grid RowDefinitions="Auto,*,Auto">

      <!-- 顶部: 提示行 -->
      <TextBlock Grid.Row="0" Classes="claudeMuted" Margin="0,0,0,10" TextWrapping="Wrap"
                 Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1095}" />

      <!-- 中部: 主从布局 (左 340 + 右详情), 两侧均为 claudeCard 容器 -->
      <Grid Grid.Row="1" ColumnDefinitions="340,*">
        <Border Grid.Column="0" Classes="claudeCard" Margin="0,0,12,0">
          <ListBox Grid.Column="0" Classes="claudeList" ItemsSource="{Binding Rows}"
                   SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                   DoubleTapped="OnRowDoubleTapped">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:BehaviorRowVm">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                  <TextBlock Classes="claudeBody" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                             Text="{Binding Name}" />
                  <TextBlock Grid.Column="1" Classes="claudeDim" Margin="8,0,0,0" Text="{Binding SourceLabel}" />
                  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="claudeDim" Margin="0,3,0,0"
                             TextWrapping="Wrap" Text="{Binding PremiseSummary}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <Border Grid.Column="1" Classes="claudeCard" Padding="16">
          <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">
              <TextBlock Classes="claudeSubtitle" FontSize="18" TextWrapping="Wrap"
                         Text="{Binding SelectedRow.Name}" />
              <TextBlock Classes="claudeDim" Text="{Binding SelectedRow.Id}" />
              <TextBlock Classes="claudeBody" TextWrapping="Wrap" Text="{Binding SelectedRow.PremiseSummary}" />
              <TextBlock Classes="claudeMuted" TextWrapping="Wrap" Text="{Binding SelectedRow.Description}" />
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <!-- 底部: 状态栏 + 操作按钮 (主 CTA 唯一: 新建行为) -->
      <StackPanel Grid.Row="2" Margin="0,14,0,0">
        <TextBlock Classes="claudeMuted" TextWrapping="Wrap" Text="{Binding StatusText}" />
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
          <Button Classes="claudeCta" Click="OnNewClick" MinWidth="112">
            <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1085}" />
          </Button>
          <Button Classes="claudeGhost" Click="OnEditClick" IsEnabled="{Binding SelectedRow.IsUser, Mode=OneWay}">
            <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1086}" />
          </Button>
          <Button Classes="claudeDanger" Click="OnDeleteClick" IsEnabled="{Binding SelectedRow.IsUser, Mode=OneWay}">
            <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1096}" />
          </Button>
          <Button Classes="claudeSand" Click="OnApplyClick" IsEnabled="{Binding IsDirty}">
            <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1094}" />
          </Button>
          <Button Classes="claudeGhost" Click="OnCloseClick">
            <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=611}" />
          </Button>
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>
</Window>
