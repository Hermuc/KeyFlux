<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KeyFlux.Settings.ViewModels"
        x:Class="KeyFlux.Settings.Views.BehaviorLibraryWindow"
        TransparencyLevelHint="Blur,AcrylicBlur,Transparent,None"
        Background="{StaticResource ClaudeWindowSurfaceBrush}"
        x:DataType="vm:BehaviorLibraryViewModel"
        Title="Setting"
        Width="860" Height="560"
        WindowStartupLocation="CenterOwner">

  <!-- 行为库 (CONTRACTS §3.9): 内置包只读 + 用户包增删; 变更经「立即生效」显式重启 -->
  <Border Padding="20">
    <Grid RowDefinitions="Auto,*,Auto">

      <!-- 顶部: 提示行 -->
      <TextBlock Grid.Row="0" FontSize="12" Foreground="{StaticResource ClaudeStoneGrayBrush}" Margin="0,0,0,10" TextWrapping="Wrap"
                 Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1095}" />

      <!-- 中部: 主从布局 -->
      <Grid Grid.Row="1" ColumnDefinitions="340,*">
        <ListBox Grid.Column="0" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                 Margin="0,0,12,0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:BehaviorRowVm">
              <StackPanel Margin="4,6">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding SourceLabel}" FontSize="11"
                             Foreground="{StaticResource ClaudeStoneGrayBrush}" Margin="8,0,0,0" />
                </Grid>
                <TextBlock Text="{Binding PremiseSummary}" FontSize="11" Foreground="{StaticResource ClaudeStoneGrayBrush}"
                           TextWrapping="Wrap" Margin="0,2,0,0" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="8" Margin="4,0,0,0">
            <TextBlock Text="{Binding SelectedRow.Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SelectedRow.Id}" FontSize="12" Foreground="{StaticResource ClaudeStoneGrayBrush}" />
            <TextBlock Text="{Binding SelectedRow.PremiseSummary}" FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SelectedRow.Description}" FontSize="12" Foreground="{StaticResource ClaudeOliveGrayBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- 底部: 状态栏 + 操作按钮 -->
      <StackPanel Grid.Row="2" Margin="0,14,0,0">
        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource ClaudeDarkWarmBrush}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
          <Button Click="OnNewClick" Background="Transparent" BorderBrush="{StaticResource ClaudeTerracottaBrush}" BorderThickness="1"
                  Foreground="{StaticResource ClaudeTerracottaBrush}" Padding="12,6" CornerRadius="{StaticResource ClaudeRadiusMd}">
            <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1085}" />
          </Button>
          <Button Click="OnEditClick" IsEnabled="{Binding SelectedRow.IsUser, Mode=OneWay}"
                  Background="Transparent" BorderBrush="{StaticResource ClaudeTerracottaBrush}" BorderThickness="1"
                  Foreground="{StaticResource ClaudeTerracottaBrush}" Padding="12,6" CornerRadius="{StaticResource ClaudeRadiusMd}">
            <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1086}" />
          </Button>
          <Button Click="OnDeleteClick" IsEnabled="{Binding SelectedRow.IsUser, Mode=OneWay}"
                  Background="Transparent" BorderBrush="{StaticResource ClaudeErrorBrush}" BorderThickness="1"
                  Foreground="{StaticResource ClaudeErrorBrush}" Padding="12,6" CornerRadius="{StaticResource ClaudeRadiusMd}">
            <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1096}" />
          </Button>
          <Button Click="OnApplyClick" IsEnabled="{Binding IsDirty}"
                  Background="{StaticResource ClaudeTerracottaBrush}" Foreground="{StaticResource ClaudeIvoryBrush}" Padding="12,6" CornerRadius="{StaticResource ClaudeRadiusMd}">
            <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=1094}" />
          </Button>
          <Button Click="OnCloseClick" Padding="12,6" CornerRadius="{StaticResource ClaudeRadiusMd}">
            <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=611}" />
          </Button>
        </StackPanel>
      </StackPanel>

    </Grid>
  </Border>
</Window>
