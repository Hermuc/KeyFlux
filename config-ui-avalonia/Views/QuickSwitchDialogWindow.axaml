<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KeyFlux.Settings.ViewModels"
        x:Class="KeyFlux.Settings.Views.QuickSwitchDialogWindow"
        TransparencyLevelHint="Blur,AcrylicBlur,Transparent,None"
        Background="{StaticResource ClaudeWindowSurfaceBrush}"
        x:Name="DlgRoot"
        x:DataType="vm:QuickSwitchDialogViewModel"
        Title="Setting"
        Width="480" SizeToContent="Height" MaxHeight="600"
        WindowStartupLocation="CenterOwner">

  <!-- 插件页 QuickSwitch 配置对话框 (逻辑自 Settings 页「快速切换」分区迁入; 副本编辑, 保存才落盘) -->
  <Border Padding="20">
    <DockPanel>

      <!-- 底部按钮: 取消 (611) / 保存 (610) -->
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10"
                  HorizontalAlignment="Right" Margin="0,14,0,0">
        <Button Click="OnCancelClick" Padding="12,6" CornerRadius="{StaticResource ClaudeRadiusMd}">
          <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=611}" />
        </Button>
        <Button Click="OnSaveClick"
                Background="{StaticResource ClaudeTerracottaBrush}" Foreground="{StaticResource ClaudeIvoryBrush}" Padding="16,6" CornerRadius="{StaticResource ClaudeRadiusMd}">
          <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=610}" />
        </Button>
      </StackPanel>

      <!-- 主体: 三开关 / 自动跳转 / 条数上限 / 排除目录 / 清空历史 -->
      <ScrollViewer>
        <StackPanel Spacing="8">
          <!-- 完全禁用采集 (collectEnabled=false: 零 Shell 枚举、零 history 写入) -->
          <CheckBox IsChecked="{Binding Draft.CollectEnabled}"
                    Content="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2409}" />
          <!-- 自动显示候选浮层 -->
          <CheckBox IsChecked="{Binding Draft.AutoShow}"
                    Content="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2410}" />
          <!-- 自动跳转: 打开对话框 -->
          <CheckBox IsChecked="{Binding Draft.AutoJumpOpen}"
                    Content="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2411}" />
          <!-- 自动跳转: 保存对话框 -->
          <CheckBox IsChecked="{Binding Draft.AutoJumpSave}"
                    Content="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2412}" />
          <!-- 历史保留条数上限 -->
          <Grid ColumnDefinitions="Auto,*">
            <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2413}"
                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
            <TextBox Grid.Column="1" Text="{Binding Draft.MaxHistory, Converter={StaticResource IntStr}}" />
          </Grid>
          <!-- 排除目录 (路径前缀, 命中的既不记录也不推荐) -->
          <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2414}"
                     Foreground="{StaticResource ClaudeStoneGrayBrush}" FontSize="12" Margin="0,4,0,0" />
          <ItemsControl ItemsSource="{Binding ExcludedPrefixRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ExcludedPrefixRowVm">
                <Grid ColumnDefinitions="*,26" Margin="0,2">
                  <TextBox Text="{Binding Value}" Padding="6,4" FontSize="13" />
                  <Button Grid.Column="1" Content="✕"
                          Command="{Binding #DlgRoot.((vm:QuickSwitchDialogViewModel)DataContext).RemoveExcludedPrefixCommand}"
                          CommandParameter="{Binding}"
                          Background="Transparent" Foreground="{StaticResource ClaudeErrorBrush}" Padding="6,3" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Command="{Binding AddExcludedPrefixCommand}"
                  Background="Transparent" BorderBrush="{StaticResource ClaudeTerracottaBrush}" BorderThickness="1"
                  Foreground="{StaticResource ClaudeTerracottaBrush}" Padding="8,5" CornerRadius="{StaticResource ClaudeRadiusMd}" HorizontalAlignment="Left">
            <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2415}" />
          </Button>
          <!-- 清空历史 (一次性动作, 截断 history.tsv 为空文件) -->
          <Button Command="{Binding ClearHistoryCommand}"
                  Background="Transparent" BorderBrush="{StaticResource ClaudeErrorBrush}" BorderThickness="1"
                  Foreground="{StaticResource ClaudeErrorBrush}" Padding="8,5" CornerRadius="{StaticResource ClaudeRadiusMd}" HorizontalAlignment="Left" Margin="0,4,0,0">
            <TextBlock Text="{Binding LanguageTick, Converter={StaticResource Tr}, ConverterParameter=2416}" />
          </Button>
        </StackPanel>
      </ScrollViewer>

    </DockPanel>
  </Border>
</Window>
