  "selectedAction": {
    "hotkey": "\u003e^p",
    "enable": true,
    "mappings": [
      {
        "matchType": "textType",
        "matchValue": "url",
        "entries": [
          {
            "behavior": "open_url",
            "options": {
              "copyToClipboard": false,
              "clearSelection": false,
              "confirm": false
            }
          },
          {
            "behavior": "search",
