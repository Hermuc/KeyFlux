              "copyToClipboard": true,
              "clearSelection": false,
              "confirm": false
            }
          }
        ]
      },
      {
        "matchType": "fileExt",
        "matchValue": "jpg,png",
        "entries": [
          {
            "behavior": "open",
            "actionValue": "%selected%",
            "options": {
              "copyToClipboard": false,
              "clearSelection": false,
              "confirm": true
            }
          }
        ]
      }
